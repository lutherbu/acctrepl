422                dlc_ratio=dlc_usd;
423                previous_dlc_ratio=previous_dlc_usd;
424                oiadp_ratio=oiadp_usd;
425                oancf_ratio=oancf_usd;
426                sale_ratio=sale_usd;
427                previous_sale_ratio=previous_sale_usd;
428                ppent_ratio=ppent_usd;
429            end;
430            size=.;
431            if at_usd > 0 then size=log(at_usd);
432            if nmiss(at_ratio,previous_at_ratio,act_ratio,previous_act_ratio,
433                     che_ratio,previous_che_ratio,lct_ratio,previous_lct_ratio,
434                     dlc_ratio,previous_dlc_ratio,oiadp_ratio,oancf_ratio,
435                     sale_ratio,previous_sale_ratio,ppent_ratio)=0;
436            average_assets=(at_ratio+previous_at_ratio)/2;
437            if average_assets <= 0 then delete;
438            current_accrual=((act_ratio-previous_act_ratio)
439                            -(che_ratio-previous_che_ratio)
