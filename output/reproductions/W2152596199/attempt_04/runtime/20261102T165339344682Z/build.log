171            create table work.annual_fx as
172            select annual.*,
173                   daily_report.spot_gbp_to_currency as stock_gbp_to_report,
174                   daily_usd.spot_gbp_to_currency as stock_gbp_to_usd,
175                   daily_report.rate_type as stock_rate_type,
176                   monthly_report.average_gbp_to_currency as flow_gbp_to_report,
177                   monthly_usd.average_gbp_to_currency as flow_gbp_to_usd,
178                   case when daily_report.spot_gbp_to_currency > 0
179                          and daily_usd.spot_gbp_to_currency > 0
180                        then daily_usd.spot_gbp_to_currency /
181                             daily_report.spot_gbp_to_currency
182                        else . end as stock_to_usd,
183                   case when monthly_report.average_gbp_to_currency > 0
184                          and monthly_usd.average_gbp_to_currency > 0
185                        then monthly_usd.average_gbp_to_currency /
186                             monthly_report.average_gbp_to_currency
187                        else . end as flow_to_usd,
188                   case when daily_report.spot_gbp_to_currency > 0
189                          and daily_usd.spot_gbp_to_currency > 0
190                        then at * daily_usd.spot_gbp_to_currency /
191                             daily_report.spot_gbp_to_currency
192                        else . end as at_usd,
193                   case when daily_report.spot_gbp_to_currency > 0
194                          and daily_usd.spot_gbp_to_currency > 0
195                        then act * daily_usd.spot_gbp_to_currency /
196                             daily_report.spot_gbp_to_currency
197                        else . end as act_usd,
198                   case when daily_report.spot_gbp_to_currency > 0
199                          and daily_usd.spot_gbp_to_currency > 0
200                        then che * daily_usd.spot_gbp_to_currency /
201                             daily_report.spot_gbp_to_currency
202                        else . end as che_usd,
203                   case when daily_report.spot_gbp_to_currency > 0
204                          and daily_usd.spot_gbp_to_currency > 0
205                        then lct * daily_usd.spot_gbp_to_currency /
206                             daily_report.spot_gbp_to_currency
207                        else . end as lct_usd,
208                   case when daily_report.spot_gbp_to_currency > 0
209                          and daily_usd.spot_gbp_to_currency > 0
210                        then dlc * daily_usd.spot_gbp_to_currency /
211                             daily_report.spot_gbp_to_currency
212                        else . end as dlc_usd,
213                   case when daily_report.spot_gbp_to_currency > 0
214                          and daily_usd.spot_gbp_to_currency > 0
215                        then ppent * daily_usd.spot_gbp_to_currency /
216                             daily_report.spot_gbp_to_currency
217                        else . end as ppent_usd,
218                   case when monthly_report.average_gbp_to_currency > 0
