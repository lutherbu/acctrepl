390        data work.support_population;
391            set work.candidate0;
392            if ratio_unit='native_same_code' then do;
393                /* Currency-homogeneous ratios are unit invariant; keep the original
394                   native amounts to avoid introducing FX movements. */
395                at_ratio=at;
396                previous_at_ratio=previous_at;
397                act_ratio=act;
398                previous_act_ratio=previous_act;
399                che_ratio=che;
400                previous_che_ratio=previous_che;
401                lct_ratio=lct;
402                previous_lct_ratio=previous_lct;
403                dlc_ratio=dlc;
404                previous_dlc_ratio=previous_dlc;
405                oiadp_ratio=oiadp;
406                oancf_ratio=oancf;
407                sale_ratio=sale;
408                previous_sale_ratio=previous_sale;
409                ppent_ratio=ppent;
410            end;
411            else if ratio_unit='usd_cross_rate' then do;
412                /* A reporting-currency switch requires date-specific translation
413                   before taking cross-period differences or average assets. */
414                at_ratio=at_usd;
415                previous_at_ratio=previous_at_usd;
416                act_ratio=act_usd;
417                previous_act_ratio=previous_act_usd;
418                che_ratio=che_usd;
