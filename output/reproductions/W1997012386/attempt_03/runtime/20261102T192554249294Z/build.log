95                 on a.datadate=dcur.datadate and upcase(strip(a.curcd))=dcur.curr
96             left join work.fx_dly_summary as dusd
97                 on a.datadate=dusd.datadate and dusd.curr='USD'
98             left join work.fx_mth_summary as mcur
99                 on a.datadate=mcur.datadate and upcase(strip(a.curcd))=mcur.curr
100            left join work.fx_mth_summary as musd
101                on a.datadate=musd.datadate and musd.curr='USD';
