104        data work.annual_usd;
105            set work.funda_rates;
106            length reporting_currency $3;
107            reporting_currency=upcase(strip(curcd));
108            bs_usd_factor=.;
109            flow_usd_factor=.;
110        
111            if reporting_currency='USD' then do;
112                bs_usd_factor=1;
113                flow_usd_factor=1;
114            end;
115            else do;
116                if reporting_currency='GBP' then do;
117                    d_report=1;
118                    m_report=1;
119                    nd_report=1;
120                    nm_report=1;
121                end;
122                if nd_report=1 and nd_usd=1 and d_report ne 0 and not missing(d_report) and not missing(d_usd) then
123                    bs_usd_factor=d_usd/d_report;
124                if nm_report=1 and nm_usd=1 and m_report ne 0 and not missing(m_report) and not missing(m_usd) then
125                    flow_usd_factor=m_usd/m_report;
126            end;
127        
128            if not missing(at) and not missing(bs_usd_factor) then at_usd=at*bs_usd_factor;
129            if not missing(ceq) and not missing(bs_usd_factor) then ceq_usd=ceq*bs_usd_factor;
130            if not missing(dltt) and not missing(bs_usd_factor) then dltt_usd=dltt*bs_usd_factor;
131        
132            if not missing(ib) and not missing(flow_usd_factor) then ib_usd=ib*flow_usd_factor;
