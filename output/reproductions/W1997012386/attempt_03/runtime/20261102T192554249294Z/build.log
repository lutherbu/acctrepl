83             create table work.funda_rates as
84             select a.*,
85                    dcur.n_rates as nd_report,
86                    dcur.rate as d_report,
87                    dusd.n_rates as nd_usd,
88                    dusd.rate as d_usd,
89                    mcur.n_rates as nm_report,
90                    mcur.rate as m_report,
91                    musd.n_rates as nm_usd,
92                    musd.rate as m_usd
93             from work.funda_unique as a
