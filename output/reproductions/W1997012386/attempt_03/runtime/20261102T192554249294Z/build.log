901            create table work.controls_annual as
902            select a.gvkey, a.fyear, a.datadate,
903                   case when not missing(a.ib_usd) and not missing(a.at_usd) and a.at_usd ne 0
904                        then a.ib_usd/a.at_usd else . end as roa,
905                   case when not missing(a.dvc_usd) and not missing(a.at_usd) and a.at_usd ne 0
906                        then a.dvc_usd/a.at_usd else . end as div,
907                   /* The same-date balance-sheet conversion factor cancels in DLTT/AT. */
908                   case when not missing(a.dltt) and not missing(a.at) and a.at ne 0
909                        then a.dltt/a.at else . end as lev,
910                   case when not missing(a.dltt_usd) and not missing(a.at_usd) and a.at_usd ne 0
26                                                         The SAS System                     Tuesday, November  3, 2026 03:25:00 AM

911                        then a.dltt_usd/a.at_usd else . end as lev_fx,
912                   case when not missing(a.at_usd) and a.at_usd>0 then log(a.at_usd) else . end as size,
913                   case when not missing(a.sale_usd) and not missing(p.sale_usd) and p.sale_usd ne 0
914                        then a.sale_usd/p.sale_usd-1 else . end as salesgro,
915                   /* All three same-date flow items share one FX factor, which cancels. */
916                   case when not missing(a.xrd) and not missing(a.xad) and
917                                 not missing(a.sale) and a.sale ne 0
918                        then (a.xrd+a.xad)/a.sale else . end as rndadv,
919                   case when not missing(a.xrd_usd) and not missing(a.xad_usd) and
920                                 not missing(a.sale_usd) and a.sale_usd ne 0
921                        then (a.xrd_usd+a.xad_usd)/a.sale_usd else . end as rndadv_fx
922            from work.annual_usd as a
923            left join work.annual_usd as p
924                on a.gvkey=p.gvkey and a.fyear=p.fyear+1
925            where a.fyear>=1993 and a.fyear<=1998;
