191        data work.annual2;
192          set work.annual1;
193          by gvkey fyear;
194          prior_ceq=lag(ceq);
195          prior_curcd=lag(curcd);
196          prior_fyear=lag(fyear);
197          if first.gvkey then call missing(prior_ceq,prior_curcd,prior_fyear);
198          roe_raw=.;
199          roe=.;
200          if fyear=prior_fyear+1 and not missing(curcd) and
201             not missing(prior_curcd) and curcd=prior_curcd and
202             not missing(ibcom) and not missing(prior_ceq) and prior_ceq ne 0 then do;
203            roe_raw=ibcom/prior_ceq;
204            if roe_raw < -1 then roe=-1;
205            else if roe_raw > 1 then roe=1;
206            else roe=roe_raw;
207          end;
208          label roe_raw='IBCOM divided by prior-year CEQ before fixed cap'
209                roe='Return on common equity, fixed cap [-1,1]';
210        run;

