68           create table work.annual_panel as
69           select a.gvkey, a.datadate, a.fyear, a.sich, a.aqc, a.at, a.ibc,
70                  a.oancf, a.sale, a.ppegt, a.curcd,
71                  p.datadate as prev_date, p.at as at_prev, p.curcd as curcd_prev,
72                  p.oancf as oancf_prev, p.sale as sale_prev,
73                  n.oancf as oancf_next, n.curcd as curcd_next
74           from work.funda_annual as a
75           left join work.funda_annual as p
76             on a.gvkey=p.gvkey and p.fyear=a.fyear-1
77           left join work.funda_annual as n
78             on a.gvkey=n.gvkey and n.fyear=a.fyear+1;
