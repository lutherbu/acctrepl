82         data work.annual_measures;
83           set work.annual_panel;
84           length sic3 8;
85           curcd=upcase(strip(curcd));
86           curcd_prev=upcase(strip(curcd_prev));
87           curcd_next=upcase(strip(curcd_next));
88           currency_t_known=(not missing(curcd) and lengthn(strip(curcd))=3
89                             and verify(strip(curcd),'ABCDEFGHIJKLMNOPQRSTUVWXYZ')=0);
90           currency_prev_known=(not missing(curcd_prev) and lengthn(strip(curcd_prev))=3
91                                and verify(strip(curcd_prev),'ABCDEFGHIJKLMNOPQRSTUVWXYZ')=0);
92           currency_next_known=(not missing(curcd_next) and lengthn(strip(curcd_next))=3
93                                and verify(strip(curcd_next),'ABCDEFGHIJKLMNOPQRSTUVWXYZ')=0);
94           currency_tp_known=(currency_t_known=1 and currency_prev_known=1);
95           currency_tn_known=(currency_t_known=1 and currency_next_known=1);
96           currency_tp_match=(currency_tp_known=1 and curcd=curcd_prev);
97           currency_tn_match=(currency_tn_known=1 and curcd=curcd_next);
The SAS System                                                                                Tuesday, November  3, 2026 02:45:00 AM

98           if not missing(sich) then sic3=floor(sich/10);
99           /* A ratio using AT_t and AT_(t-1) is defined only when their reported
100             currencies are both known and match. Never add unlike or unknown units. */
101          if currency_tp_match=1 and not missing(at) and not missing(at_prev) then avgat=(at+at_prev)/2;
102          if avgat>0 then do;
103            if not missing(ibc) and not missing(oancf) then acc=(ibc-oancf)/avgat;
104            if not missing(oancf) then cf=oancf/avgat;
105            if currency_tp_match=1 and not missing(oancf) and not missing(oancf_prev) then delta_cf=(oancf-oancf_prev)/avgat;
106            if currency_tp_match=1 and not missing(sale) and not missing(sale_prev) then drev=(sale-sale_prev)/avgat;
107            if not missing(ppegt) then gppe=ppegt/avgat;
108            /* Table 2 and Table 9 scale all cash-flow variables for observation t
109               by average assets in t, including the DD lead and lag predictors. */
110            if currency_tp_match=1 and not missing(oancf_prev) then cf_lag=oancf_prev/avgat;
111            if currency_tn_match=1 and not missing(oancf_next) then cf_lead=oancf_next/avgat;
112          end;
113        run;

