228        proc sql;
229            create table yearly as
230            select a.gvkey, a.fyear, a.datadate, a.fyr, a.indfmt, a.datafmt, a.consol,
231                   a.popsrc, a.at, a.ib, a.ibc, a.oancf, a.curcd, a.curncd, a.currtr,
232                   a.at_usd, a.at_usd_a2, a.fx_route, a.gbp_to_src, a.gbp_to_usd,
233                   a.src_fx_type, a.usd_fx_type, a.src_quote_n, a.src_positive_n,
234                   a.usd_quote_n, a.usd_positive_n,
235                   b.at as at_lag1, b.curcd as curcd_lag1, b.curncd as curncd_lag1,
236                   case when a.at>0 and b.at>0
237                             and not missing(strip(a.curcd)) and not missing(strip(b.curcd))
238                             and upcase(strip(a.curcd))=upcase(strip(b.curcd))
239                        then (a.at+b.at)/2 else . end as avg_at,
240                   case when a.at>0 and b.at>0
241                             and not missing(strip(a.curcd)) and not missing(strip(b.curcd))
242                             and upcase(strip(a.curcd))=upcase(strip(b.curcd))
243                        then a.ibc/((a.at+b.at)/2) else . end as earn,
244                   case when a.at>0 and b.at>0
245                             and not missing(strip(a.curcd)) and not missing(strip(b.curcd))
246                             and upcase(strip(a.curcd))=upcase(strip(b.curcd))
247                        then a.oancf/((a.at+b.at)/2) else . end as cfo,
248                   case when missing(b.gvkey) then 'No prior row'
249                        when missing(strip(a.curcd)) or missing(strip(b.curcd)) then 'Unknown currency'
250                        when upcase(strip(a.curcd))=upcase(strip(b.curcd)) then 'Compatible'
251                        else 'Currency change' end as ratio_currency_status length=16,
252                   (not missing(strip(a.curcd)) and not missing(strip(b.curcd))
253                        and upcase(strip(a.curcd)) ne upcase(strip(b.curcd))) as currency_mismatch
