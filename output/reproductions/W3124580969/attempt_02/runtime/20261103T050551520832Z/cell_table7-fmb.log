. foreach yy of local annual_years {
  2.     regress $y $x $ctrl if year == `yy'
  3.     if e(rank) != 7 | e(df_r) <= 0 {
  4.         display as error "Annual OLS is not full rank or has no residual df in `yy'."
  5.         exit 459
  6.     }
  7.     local fit_count = `fit_count' + 1
  8.     local annual_n = e(N)
  9.     if `annual_n' < `n_min' local n_min = `annual_n'
 10.     if `annual_n' > `n_max' local n_max = `annual_n'
 11.     scalar audit_n = audit_n + e(N)
 12.     scalar audit_ar2 = audit_ar2 + e(r2_a)
 13. }

