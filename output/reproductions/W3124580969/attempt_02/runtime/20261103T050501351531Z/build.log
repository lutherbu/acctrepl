729        /* Obtain dated quarter ROA and Q-vs-Q-4 sales growth through keyed joins. */
730        proc sql;
731          create table q_metrics as
732          select q.gvkey, q.datadate, q.qidx, q.curcdq, q.atq, q.ib_q, q.sale_q,
733                 p.atq as prev_at, p.qidx as prev_idx, p.curcdq as prev_cur,
734                 y.sale_q as sale_q4, y.qidx as yoy_idx, y.curcdq as yoy_cur
735          from qhist as q
736          left join qhist as p on q.gvkey=p.gvkey and p.qidx=q.qidx-1
737          left join qhist as y on q.gvkey=y.gvkey and y.qidx=q.qidx-4;
NOTE: SAS threaded sort was used.
NOTE: Table WORK.Q_METRICS created, with 882458 rows and 13 columns.

738          create table q_metric2 as
739          select a.gvkey, a.datadate, a.qidx, a.curcdq, a.prev_cur, a.yoy_cur,
740                 case when not missing(a.ib_q) and not missing(a.atq) and not missing(a.prev_at)
741                            and a.atq>0 and a.prev_at>0
742                            and not missing(a.curcdq) and not missing(a.prev_cur)
743                            and a.curcdq=a.prev_cur
744                      then a.ib_q/((a.atq+a.prev_at)/2) else . end as qroa,
745                 case when not missing(a.sale_q) and not missing(a.sale_q4) and a.sale_q4 ne 0
746                            and not missing(a.curcdq) and not missing(a.yoy_cur)
747                            and a.curcdq=a.yoy_cur
748                      then a.sale_q/a.sale_q4-1 else . end as qsg
749          from q_metrics as a;
