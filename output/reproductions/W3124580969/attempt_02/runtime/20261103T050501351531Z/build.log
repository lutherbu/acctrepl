272        data qhist;
273          set quniq_dateclean;
274          by gvkey qidx;
275          length p_curcdq $4;
276          retain p_idx p_fy p_fq p_scfq p_curcdq p_oancfy p_fopty p_wcapcy p_capxy p_xrdy p_iby p_saley;
277          if first.gvkey then call missing(p_idx,p_fy,p_fq,p_scfq,p_oancfy,p_fopty,p_wcapcy,
278                                           p_curcdq,p_capxy,p_xrdy,p_iby,p_saley);
279          contig=(not missing(p_idx) and qidx=p_idx+1 and fyearq=p_fy and fqtr=p_fq+1);
280          same_currency=(not missing(curcdq) and not missing(p_curcdq) and curcdq=p_curcdq);
281          ytd_contig=(contig and same_currency);
282          cash_contig=(ytd_contig and not missing(scfq) and not missing(p_scfq) and scfq=p_scfq);
283          ib_ccy_block=(missing(ibq) and contig and not same_currency and not missing(iby) and not missing(p_iby));
284          sale_ccy_block=(missing(saleq) and contig and not same_currency and not missing(saley) and not missing(p_saley));
285          capx_ccy_block=(contig and not same_currency and not missing(capxy) and not missing(p_capxy));
286          xrd_ccy_block=(contig and not same_currency and not missing(xrdy) and not missing(p_xrdy));
287          oan_ccy_block=(contig and scfq=p_scfq and not same_currency
288                         and not missing(oancfy) and not missing(p_oancfy));
289          fopt_ccy_block=(contig and scfq=p_scfq and not same_currency
290                          and not missing(fopty) and not missing(p_fopty));
291          wcap_ccy_block=(contig and scfq=p_scfq and not same_currency
292                          and not missing(wcapcy) and not missing(p_wcapcy));
293          ib_q=ibq;
294          if missing(ib_q) then do;
295            if fqtr=1 then ib_q=iby;
296            else if ytd_contig and not missing(iby) and not missing(p_iby) then ib_q=iby-p_iby;
297          end;
298          sale_q=saleq;
299          if missing(sale_q) then do;
300            if fqtr=1 then sale_q=saley;
301            else if ytd_contig and not missing(saley) and not missing(p_saley) then sale_q=saley-p_saley;
302          end;
303          if fqtr=1 then do;
304            capx_q=capxy;
305            xrd_yq=xrdy;
306            oancf_q=oancfy;
307            fopt_q=fopty;
308            wcapc_q=wcapcy;
309          end;
310          else if ytd_contig then do;
311            if not missing(capxy) and not missing(p_capxy) then capx_q=capxy-p_capxy;
312            if not missing(xrdy) and not missing(p_xrdy) then xrd_yq=xrdy-p_xrdy;
313            if cash_contig then do;
314              if not missing(oancfy) and not missing(p_oancfy) then oancf_q=oancfy-p_oancfy;
315              if not missing(fopty) and not missing(p_fopty) then fopt_q=fopty-p_fopty;
316              if not missing(wcapcy) and not missing(p_wcapcy) then wcapc_q=wcapcy-p_wcapcy;
317            end;
318          end;
319          rd_q=xrdq;
320          if missing(rd_q) then rd_q=xrd_yq;
321          if datadate < '01JAN1988'd then do;
322            if scfq=7 then cfo_q=oancf_q;
323            else if scfq=1 and not missing(fopt_q) and not missing(wcapc_q) then cfo_q=fopt_q-wcapc_q;
324            else if scfq in (2,3,5) and not missing(fopt_q) and not missing(wcapc_q)
325              then cfo_q=fopt_q+wcapc_q;
326            else cfo_q=.;
327          end;
328          else if scfq=7 then cfo_q=oancf_q;
329          else cfo_q=.;
330          output;
331          p_idx=qidx; p_fy=fyearq; p_fq=fqtr; p_scfq=scfq; p_oancfy=oancfy; p_fopty=fopty;
332          p_curcdq=curcdq; p_wcapcy=wcapcy; p_capxy=capxy; p_xrdy=xrdy; p_iby=iby; p_saley=saley;
333          keep gvkey datadate fyearq fqtr curcdq scfq qidx atq ceqq ib_q sale_q cfo_q capx_q rd_q
334               ib_ccy_block sale_ccy_block capx_ccy_block xrd_ccy_block oan_ccy_block
335               fopt_ccy_block wcap_ccy_block;
336        run;

