1066              or prev_valcf<=0 or price_cf<=0 or fx_event<=0 or prev_fx_event<=0 then delete;
1067           ret=(1+r_m1)*(1+r_0)*(1+r_p1)-1
1068               - ((1+m_m1)*(1+m_0)*(1+m_p1)-1);
1069           fr=(value*evcf/valcf*fx_event-prev_value*evcf/prev_valcf*prev_fx_event)
1070              /(abs(prc)*evcf/price_cf);
