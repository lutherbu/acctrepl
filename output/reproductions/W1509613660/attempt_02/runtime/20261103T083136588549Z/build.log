787        data hist_scored0;
788            length currency_route $16;
789            set hist_factors0;
790            score_ok=0;
791            if not missing(rdq) and not missing(valcf) and valcf>0
792               and not missing(conscf) and conscf>0
793               and not missing(fiscf) and fiscf>0 then do;
794                if report_curr=curcode and report_curr=curcd then do;
795                    currency_route='same_currency';
796                    forecast_value=value;
797                    actual_at_forecast=epspx*valcf/fiscf;
798                    consensus_at_forecast=medest*valcf/conscf;
799                    score_ok=1;
800                end;
                                                           The SAS System

801                else if not missing(detail_usd_rate) and detail_usd_rate>0
802                     and not missing(summary_usd_rate) and summary_usd_rate>0
803                     and not missing(actual_usd_rate) and actual_usd_rate>0 then do;
804                    currency_route='mixed_currency';
805                    forecast_value=value*detail_usd_rate;
806                    actual_at_forecast=epspx*actual_usd_rate*valcf/fiscf;
807                    consensus_at_forecast=medest*summary_usd_rate*valcf/conscf;
808                    score_ok=1;
809                end;
810                else currency_route='fx_missing';
811            end;
812            if score_ok then
813                useful=(abs(forecast_value-actual_at_forecast)
814                      < abs(consensus_at_forecast-actual_at_forecast));
815            score_year=year(actdats);
816        run;

