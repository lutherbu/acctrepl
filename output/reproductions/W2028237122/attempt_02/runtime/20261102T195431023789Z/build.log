409        data work.base;
410            set work.base0;
411            if nlagbest ne 1 then lagraw=.;
412            if nperm ne 1 or nsic ne 1 then do; permno=.; siccd=.; end;
413            if not missing(cfac_p) and cfac_p>0 and not missing(cfac_a) and cfac_a>0 then
414                eps_t= value * cfac_p / cfac_a;
415            if not missing(cfac_p) and cfac_p>0 and not missing(cfac_l) and cfac_l>0 then
416                eps_lag= lagraw * cfac_p / cfac_l;
417            if not missing(cfac_p) and cfac_p>0 and not missing(cfac_f) and cfac_f>0 then
418                eps_forecast= forecast * cfac_p / cfac_f;
419            if not missing(price) and price>0 then do;
420                loss=eps_t/price;
421                earnchange=(eps_t-eps_lag)/price;
422                surprise=(eps_t-eps_forecast)/price;
423            end;
424            if not missing(pdate) and not missing(qbegin) then price_age_days=pdate-qbegin;
425            loss_ok=not missing(loss);
426            change_ok=not missing(earnchange);
427            surprise_ok=not missing(surprise);
