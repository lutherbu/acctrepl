199        /* Boundary audit: tolerance handles only double representation, not EPS rounding. */
200        data work.boundary;
201            input actual value exp_small exp_extreme exp_zero;
202            surprise_cents=(actual-value)*100;
203            small_boundary=(surprise_cents>0 and surprise_cents<=3+1e-10);
204            extreme_boundary=(surprise_cents<0 and surprise_cents<=-25+1e-10);
205            exact_zero=(surprise_cents=0);
206            if small_boundary ne exp_small or extreme_boundary ne exp_extreme or exact_zero ne exp_zero then boundary_fail=1;
207            else boundary_fail=0;
208            datalines;

