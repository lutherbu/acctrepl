240        /* Frequencies use the source-defined sign populations and conditional denominators. */
241        proc sql;
242            create table work.annual_freq as
243            select fiscal_year,
244                   count(*) as n_all,
245                   sum(ACTUAL>0) as n_profit,
246                   sum(ACTUAL<0) as n_loss,
247                   sum(ACTUAL=0) as n_zero_actual,
248                   case when sum(ACTUAL>0)>0 then 100*sum(ACTUAL>0 and surprise_cents=0)/sum(ACTUAL>0) else . end as
248      ! pct_zero_profit,
249                   case when sum(ACTUAL<0)>0 then 100*sum(ACTUAL<0 and surprise_cents=0)/sum(ACTUAL<0) else . end as
249      ! pct_zero_loss,
250                   case when sum(ACTUAL>0)>0 then 100*sum(ACTUAL>0 and surprise_cents>0)/sum(ACTUAL>0) else . end as
250      ! pct_positive_profit,
251                   case when sum(ACTUAL<0)>0 then 100*sum(ACTUAL<0 and surprise_cents>0)/sum(ACTUAL<0) else . end as
251      ! pct_positive_loss,
252                   case when sum(ACTUAL>0 and surprise_cents>0)>0 then 100*sum(ACTUAL>0 and surprise_cents>0 and
252      ! surprise_cents<=3+1e-10)/sum(ACTUAL>0 and surprise_cents>0) else . end as pct_small_positive_profit,
253                   case when sum(ACTUAL<0 and surprise_cents<0)>0 then 100*sum(ACTUAL<0 and surprise_cents<0 and
253      ! surprise_cents<=-25+1e-10)/sum(ACTUAL<0 and surprise_cents<0) else . end as pct_extreme_negative_loss
254              from work.usd_selected
255             group by fiscal_year;
