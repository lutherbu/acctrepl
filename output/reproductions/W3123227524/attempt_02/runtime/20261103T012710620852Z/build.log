174        /* Build annual lags from explicit fiscal-year joins, never row-position LAG queues. */
7                                                          The SAS System                     Tuesday, November  3, 2026 09:27:00 AM

175        proc sql;
176            create table comp_lags as
177            select t.*,
178                   p.at as at_lag, p.sale as sale_lag, p.invt as invt_lag,
179                   p.capx as capx_lag, p.ib as ib_lag, p.curcd as curcd_lag,
180                   p.datadate as datadate_lag,
181                   q.sale as sale_lag2, q.curcd as curcd_lag2,
182                   q.datadate as datadate_lag2
183            from comp_annual as t
184            left join comp_statements as p
185              on p.gvkey=t.gvkey and p.fyear=t.fyear-1
186            left join comp_statements as q
187              on q.gvkey=t.gvkey and q.fyear=t.fyear-2;
NOTE: Table WORK.COMP_LAGS created, with 135561 rows and 40 columns.

188        quit;
