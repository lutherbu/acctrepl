189        
190        data aux_inputs;
191            set comp_lags;
192            length inv_at dsale dsale_lag cfo ta prod disx 8;
193            if curcd = curcd_lag and not missing(curcd)
194               and not missing(at_lag) and at_lag > 0;
195            inv_at = 1 / at_lag;
196            if not missing(sale) and not missing(sale_lag) then dsale = sale - sale_lag;
197            if curcd_lag = curcd_lag2 and not missing(curcd_lag2)
198               and not missing(sale_lag) and not missing(sale_lag2)
199               then dsale_lag = sale_lag - sale_lag2;
200            if not missing(oancf) and not missing(xidoc) then cfo = oancf - xidoc;
201            if not missing(ibc) and not missing(cfo) then ta = ibc - cfo;
202            if not missing(cogs) and not missing(invt) and not missing(invt_lag)
203               then prod = cogs + (invt - invt_lag);
204            if not missing(xsga) then do;
205                if missing(xad) then xad_use = 0; else xad_use = xad;
206                if missing(xrd) then xrd_use = 0; else xrd_use = xrd;
207                disx = xad_use + xrd_use + xsga;
208            end;
209            if not missing(ta) and not missing(dsale) and not missing(ppegt) then do;
210                da_y = ta / at_lag;
211                da_x1 = inv_at;
212                da_x2 = dsale / at_lag;
213                da_x3 = ppegt / at_lag;
214            end;
215            if not missing(cfo) and not missing(sale) and not missing(dsale) then do;
216                cfo_y = cfo / at_lag;
217                cfo_x1 = inv_at;
218                cfo_x2 = sale / at_lag;
219                cfo_x3 = dsale / at_lag;
220            end;
221            if not missing(prod) and not missing(sale) and not missing(dsale)
222               and not missing(dsale_lag) then do;
223                prod_y = prod / at_lag;
224                prod_x1 = inv_at;
225                prod_x2 = sale / at_lag;
