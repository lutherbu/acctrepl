511        /* Construct year-zero and year-one ROA, plus the source-unspecified growth rates. */
512        proc sql;
513            create table comp_panel as
514            select t.gvkey, t.fyear, t.curcd, t.datadate, t.sich,
515                   t.at_lag, t.at, t.ib, n.ib as ib_next,
516                   t.sale, t.sale_lag, t.capx, t.capx_lag,
517                   t.da_res, t.r_cfo, t.r_prod, t.r_disx, t.rm1, t.rm2,
518                   case when t.at_lag > 0 and not missing(t.ib) then t.ib/t.at_lag else . end as roa0,
519                   case when t.at > 0 and not missing(n.ib) then n.ib/t.at else . end as roa1,
520                   case when t.sale_lag > 0 and not missing(t.sale) and not missing(t.sale_lag)
521                        then (t.sale-t.sale_lag)/t.sale_lag else . end as sale_growth,
522                   case when t.capx_lag > 0 and not missing(t.capx) and not missing(t.capx_lag)
523                        then (t.capx-t.capx_lag)/t.capx_lag else . end as capex_growth
524            from comp_proxy as t inner join comp_statements as n
525              on n.gvkey=t.gvkey and n.fyear=t.fyear+1
526            where t.fyear >= 1987 and t.fyear <= 2006
527              and t.curcd='USD' and t.curcd_lag='USD' and n.curcd='USD'
528              and not missing(t.sich) and t.sich >= 100 and t.sich <= 9999
19                                                         The SAS System                     Tuesday, November  3, 2026 09:27:00 AM

529              and not (t.sich >= 6000 and t.sich <= 6999);
