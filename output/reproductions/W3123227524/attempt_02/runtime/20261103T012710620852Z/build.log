567                   h.latest_pre_fyear, h.n_latest_4_prior_fyears,
568                   p.at_lag as issuer_at_lag, p.roa0 as issuer_roa0,
569                   p.roa1 as issuer_roa1, p.da_res as da, p.r_cfo, p.r_prod,
570                   p.r_disx, p.rm1, p.rm2, p.sale_growth, p.capex_growth,
571                   p.datadate as issuer_datadate
572            from target_link as t inner join comp_panel as p
573              on p.gvkey=t.issuer_gvkey and p.fyear=t.issue_year
574            inner join target_precount as h
575              on h.master_deal_no=t.master_deal_no
576            where t.n_link_gvkeys=1 and h.n_latest_4_prior_fyears = 4
577              and not missing(p.at_lag) and p.at_lag > 0
578              and not missing(p.roa0) and not missing(p.roa1)
579              and nmiss(p.da_res,p.r_cfo,p.r_prod,p.r_disx,p.rm1,p.rm2)=0;
