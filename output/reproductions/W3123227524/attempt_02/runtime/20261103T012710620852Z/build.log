596        /* Match the nearest year-zero ROA among nonissuers with prior assets +/- 10%. */
597        proc sql;
598            create table match_pairs as
599            select i.master_deal_no, i.issuer_gvkey, i.offer_year,
600                   i.issuer_at_lag,
601                   c.gvkey as control_gvkey, c.roa0 as control_roa0,
602                   c.roa1 as control_roa1, c.at_lag as control_at_lag,
603                   abs(c.roa0-i.issuer_roa0) as roa_gap
604            from issuer_year as i, comp_panel as c
605            where c.fyear=i.offer_year
606              and c.gvkey ne i.issuer_gvkey
607              and c.gvkey not in (select gvkey from issuer_ids)
608              and c.at_lag >= 0.90*i.issuer_at_lag
609              and c.at_lag <= 1.10*i.issuer_at_lag
610              and not missing(c.roa0) and not missing(c.roa1);
NOTE: Table WORK.MATCH_PAIRS created, with 129603 rows and 9 columns.

611            create table match_counts as
612            select master_deal_no, count(*) as candidate_controls,
613                   min(roa_gap) as closest_roa_gap
614            from match_pairs group by master_deal_no;
