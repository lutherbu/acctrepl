203        data work.linkseg;
204            set work.linkintervals;
205            by gvkey fyear hiid permno;
206            retain segstart segend dummy_x_history direct_id_history;
207            if first.permno then do;
208                segstart=sdate;
209                segend=edate;
210                dummy_x_history=is_x;
211                direct_id_history=direct_id;
212            end;
213            else if sdate<=segend+1 then do;
214                if edate>segend then segend=edate;
215                dummy_x_history=max(dummy_x_history,is_x);
216                direct_id_history=max(direct_id_history,direct_id);
217            end;
218            else do;
219                output;
220                segstart=sdate;
221                segend=edate;
222                dummy_x_history=is_x;
223                direct_id_history=direct_id;
224            end;
225            if last.permno then output;
226            keep gvkey fyear hiid permno segstart segend
227                 dummy_x_history direct_id_history;
228        run;

