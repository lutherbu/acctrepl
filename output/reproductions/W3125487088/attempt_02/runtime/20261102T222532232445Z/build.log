688            if missing(retdup) then retdup=0;
689            if missing(pricedup) then pricedup=0;
690            if retdup=1 then ret=.;
691            if missing(ret_bad) then ret_bad=0;
692            retok=(retok=1 and not missing(ret) and ret_bad=0 and retdup=0
693                   and nday=expdays and first_obs=exp_first
694                   and last_obs=exp_last);
695            price_cur='';
696            price=.;
697            price_date=.;
698            price_gap=.;
699            price_source='';
700            cur_conflict=0;
701            curmatch=0;
702            if not missing(curcd) then do;
703                epscur=strip(upcase(curcd));
704                daycur=strip(upcase(daycur));
705                mthcur=strip(upcase(mthcur));
706                if not missing(daycur) and not missing(mthcur)
707                   and daycur ne mthcur then cur_conflict=1;
708                if not missing(daycur) and not missing(mthcur)
709                   and daycur=mthcur then price_cur=daycur;
710                else if not missing(daycur) and missing(mthcur) then price_cur=daycur;
711                else if missing(daycur) and not missing(mthcur) then price_cur=mthcur;
712                if epscur='USD' then do;
713                    price_source='CRSP';
714                    price_cur='USD';
715                    if pricedup=0 and not missing(crsp_price) and crsp_price>0 then do;
716                        price=crsp_price;
717                        price_date=crsp_date;
718                        price_gap=crsp_gap;
719                        curmatch=1;
720                    end;
721                end;
722                else if cur_conflict=0 and not missing(price_cur)
723                     and price_cur=epscur and not missing(prevprcc)
724                     and prevprcc>0 then do;
725                    price_source='COMP';
726                    price=prevprcc;
727                    price_date=prevdate;
728                    price_gap=0;
729                    curmatch=1;
730                end;
731            end;
732            priceok=(curmatch=1 and not missing(price) and price>0
733                     and not missing(eps_prior_basis));
734            eps_price=.;
735            if priceok then eps_price=eps_prior_basis/price;
736            dum=.;
737            dum_return=.;
738            if not missing(ret) then do;
739                dum=(ret<0);
740                dum_return=dum*ret;
