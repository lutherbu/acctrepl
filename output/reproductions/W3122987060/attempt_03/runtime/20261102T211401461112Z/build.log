297        
298        data price_route;
299            set price_route;
300            length price_fx_status 3 price_fx_factor 8 price_usd 8;
301            if n_primary_iid ne 1 or n_primary_rows ne 1 then price_fx_status=1;
302            else if missing(price_date) or n_price_rows ne 1 then price_fx_status=2;
303            else if missing(price_curcd) then price_fx_status=3;
304            else if missing(prcc_f) then price_fx_status=4;
305            else if price_curcd='USD' then do;
306                price_fx_factor=1;
307                price_usd=prcc_f;
308                price_fx_status=0;
309            end;
310            else if price_curcd='GBP' then do;
311                if usd_n=1 and usd_rate>0 then do;
312                    price_fx_factor=usd_rate;
313                    price_usd=prcc_f*price_fx_factor;
314                    price_fx_status=0;
315                end;
316                else price_fx_status=5;
317            end;
318            else if source_n=1 and usd_n=1 and source_rate>0 and usd_rate>0 then do;
319                price_fx_factor=usd_rate/source_rate;
320                price_usd=prcc_f*price_fx_factor;
321                price_fx_status=0;
322            end;
323            else price_fx_status=5;
324        run;

