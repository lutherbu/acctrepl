276            create table price_route as
277            select r.gvkey, r.fyear, r.datadate, r.prcc_f,
278                   pc.n_primary_iid, pc.n_primary_rows, pi.iid,
279                   pr.price_date, pr.price_curcd, pr.daily_close, pr.n_price_rows,
280                   s.fxrate as source_rate, s.n_quote as source_n,
281                   s.rate_type as source_type,
282                   u.fxrate as usd_rate, u.n_quote as usd_n,
283                   u.rate_type as usd_type
284            from raw_unique as r
285            left join primary_counts as pc
286              on r.gvkey=pc.gvkey and r.fyear=pc.fyear and r.datadate=pc.datadate
287            left join primary_iid as pi
288              on r.gvkey=pi.gvkey and r.fyear=pi.fyear and r.datadate=pi.datadate
289            left join price_rows as pr
290              on pi.gvkey=pr.gvkey and pi.fyear=pr.fyear and pi.datadate=pr.datadate
                                                           The SAS System

291             and pi.iid=pr.iid
292            left join fx_dly_rate as s
293              on pr.price_date=s.datadate and pr.price_curcd=s.tocurd
294            left join fx_dly_rate as u
295              on pr.price_date=u.datadate and u.tocurd='USD';
