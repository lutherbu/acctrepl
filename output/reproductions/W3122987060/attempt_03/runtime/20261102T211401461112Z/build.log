452        /* One row per firm/fiscal year. Balance-sheet fallbacks use the exact t-1 fiscal year. */
453        proc sql;
454            create table annual_base as
455            select c.gvkey, c.datadate, c.fyear, c.curcd, c.sich, c.sale, c.prcc_f,
456                   c.sale_usd, c.sale_fx_status, c.price_usd, c.price_fx_status,
457                   c.price_iid, c.price_date, c.price_curcd,
458                   c.at, p.at as at_prev,
459                   case when not missing(p.gvkey) and not missing(c.curcd)
                                                           The SAS System

460                             and not missing(p.curcd) and c.curcd=p.curcd
461                        then (c.at + p.at) / 2 else . end as avg_at,
462                   case when missing(p.gvkey) then 3
463                        when missing(c.curcd) or missing(p.curcd) then 2
464                        when c.curcd ne p.curcd then 1
465                        else 0 end as currency_status,
466                   c.ib as earn_raw,
467                    case when not missing(c.oancf) and not missing(c.xidoc)
468                         then c.oancf - c.xidoc
469                        else . end as cf_raw,
470                    case when not missing(c.oancf) and missing(c.xidoc)
471                         then 1 else 0 end as xidoc_missing_cf,
472                   case when not missing(c.recch) then -c.recch
473                        when not missing(c.rect) and not missing(p.rect)
474                             and not missing(c.curcd) and not missing(p.curcd)
475                             and c.curcd=p.curcd
476                        then c.rect - p.rect
477                        else . end as dar_raw,
478                   case when not missing(c.invch) then -c.invch
479                        when not missing(c.invt) and not missing(p.invt)
480                             and not missing(c.curcd) and not missing(p.curcd)
481                             and c.curcd=p.curcd
482                        then c.invt - p.invt
483                        else . end as dinv_raw,
484                   case when not missing(c.apalch) then c.apalch
485                        when not missing(c.ap) and not missing(c.xacc)
486                             and not missing(p.ap) and not missing(p.xacc)
487                             and not missing(c.curcd) and not missing(p.curcd)
488                             and c.curcd=p.curcd
489                        then (c.ap + c.xacc) - (p.ap + p.xacc)
490                        else . end as dap_raw,
491                   c.xdp as depr_raw,
492                   case when not missing(c.am) then c.am
493                        when not missing(c.dp) and not missing(c.xdp) and not missing(c.xdepl)
494                        then c.dp - c.xdp - c.xdepl
495                        when not missing(c.dp) and not missing(c.xdp) and missing(c.xdepl)
496                             and not missing(c.sich)
497                             and (c.sich < 1000 or c.sich > 1499)
498                             and (c.sich < 2900 or c.sich > 2999)
499                             and (c.sich < 4600 or c.sich > 4699)
500                        then c.dp - c.xdp
501                        else . end as amort_raw
502            from raw_screen as c
503            left join raw_screen as p
504              on c.gvkey=p.gvkey and c.fyear=p.fyear+1
505            order by c.gvkey, c.fyear;
NOTE: Table WORK.ANNUAL_BASE created, with 174564 rows and 26 columns.

