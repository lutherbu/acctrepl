355                   sum(p.price_fx_status=1) as n_primary_ambiguous,
356                   sum(p.price_fx_status=2) as n_no_daily_price,
357                   sum(p.price_fx_status=3) as n_missing_price_curcd,
358                   sum(p.price_fx_status=4) as n_missing_prccf,
359                   sum(p.price_fx_status=5) as n_no_price_fx
360            from raw_unique as r
