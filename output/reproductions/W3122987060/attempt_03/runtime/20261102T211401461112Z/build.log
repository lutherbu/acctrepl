620        /* Count the pre-tail observations otherwise complete except for missing XIDOC-derived CF. */
621        data xidoc_impact;
622            set panel;
623            if missing(sich) then delete;
624            if sich >= 6000 and sich <= 6999 then delete;
625            if missing(sale_usd) or sale_usd < 10 then delete;
626            if missing(price_usd) or price_usd < 1 then delete;
627            if currency_bad_k0 > 0 then delete;
628            if nmiss(earn0, earn1, earn2, d_ar, d_inv, d_ap, depr, amort) > 0 then delete;
629            if xidoc_missing_cf0=0 and xidoc_missing_cf_lead=0 then delete;
630        run;

