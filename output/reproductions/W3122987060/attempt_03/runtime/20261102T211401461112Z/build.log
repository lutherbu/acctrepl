518                   c.curcd, c.sale_usd, c.sale_fx_status,
519                   c.price_usd, c.price_fx_status, c.price_iid, c.price_date, c.price_curcd,
520                   c.xidoc_missing_cf as xidoc_missing_cf0,
521                   case when missing(l.gvkey) then 0 else l.xidoc_missing_cf end as xidoc_missing_cf_lead,
522                   c.currency_status as currency_status0,
523                   case when missing(l.gvkey) then 3 else l.currency_status end as currency_status_lead,
524                   case when missing(e1.gvkey) then 3 else e1.currency_status end as currency_status1,
525                   case when missing(e2.gvkey) then 3 else e2.currency_status end as currency_status2,
526                   case when missing(e3.gvkey) then 3 else e3.currency_status end as currency_status3,
527                   case when missing(e4.gvkey) then 3 else e4.currency_status end as currency_status4,
528                   case when missing(e5.gvkey) then 3 else e5.currency_status end as currency_status5,
529                   case when missing(e6.gvkey) then 3 else e6.currency_status end as currency_status6,
530                   case when c.avg_at > 0 then c.earn_raw/c.avg_at else . end as earn0,
531                   case when c.avg_at > 0 then c.cf_raw/c.avg_at else . end as cf0,
532                   case when l.avg_at > 0 then l.cf_raw/l.avg_at else . end as cf_lead,
533                   case when c.avg_at > 0 then c.dar_raw/c.avg_at else . end as d_ar,
534                   case when c.avg_at > 0 then c.dinv_raw/c.avg_at else . end as d_inv,
535                   case when c.avg_at > 0 then c.dap_raw/c.avg_at else . end as d_ap,
536                   case when c.avg_at > 0 then c.depr_raw/c.avg_at else . end as depr,
537                   case when c.avg_at > 0 then c.amort_raw/c.avg_at else . end as amort,
538                   case when c.avg_at > 0 then c.other_raw/c.avg_at else . end as other,
539                   case when e1.avg_at > 0 then e1.earn_raw/e1.avg_at else . end as earn1,
540                   case when e2.avg_at > 0 then e2.earn_raw/e2.avg_at else . end as earn2,
541                   case when e3.avg_at > 0 then e3.earn_raw/e3.avg_at else . end as earn3,
542                   case when e4.avg_at > 0 then e4.earn_raw/e4.avg_at else . end as earn4,
543                   case when e5.avg_at > 0 then e5.earn_raw/e5.avg_at else . end as earn5,
544                   case when e6.avg_at > 0 then e6.earn_raw/e6.avg_at else . end as earn6
545            from annual as c
546            left join annual as l
547              on c.gvkey=l.gvkey and l.fyear=c.fyear+1
548            left join annual as e1
549              on c.gvkey=e1.gvkey and e1.fyear=c.fyear-1
550            left join annual as e2
551              on c.gvkey=e2.gvkey and e2.fyear=c.fyear-2
552            left join annual as e3
553              on c.gvkey=e3.gvkey and e3.fyear=c.fyear-3
554            left join annual as e4
555              on c.gvkey=e4.gvkey and e4.fyear=c.fyear-4
556            left join annual as e5
557              on c.gvkey=e5.gvkey and e5.fyear=c.fyear-5
                                                           The SAS System

558            left join annual as e6
559              on c.gvkey=e6.gvkey and e6.fyear=c.fyear-6
560            where c.fyear between 1987 and 1996
561            order by c.gvkey, c.fyear;
