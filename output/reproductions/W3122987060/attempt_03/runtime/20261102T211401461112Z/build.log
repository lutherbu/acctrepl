420        /* Currency audit for every adjacent fiscal-year pair used by the lag/lead ratios. */
421        proc sql;
422            create table currency_pair_fields as
423            select c.fyear, count(*) as n_firmyears,
424                   sum(case when missing(p.gvkey) then 1 else 0 end) as n_no_prior_record,
425                   sum(case when not missing(p.gvkey) and (missing(c.curcd) or missing(p.curcd))
426                            then 1 else 0 end) as n_currency_code_missing,
427                   sum(case when not missing(p.gvkey) and not missing(c.curcd)
428                                 and not missing(p.curcd) and c.curcd ne p.curcd
429                            then 1 else 0 end) as n_currency_changed,
430                   sum(case when not missing(p.gvkey) and not missing(c.curcd)
431                                 and not missing(p.curcd) and c.curcd=p.curcd
432                            then 1 else 0 end) as n_currency_same
433            from raw_unique as c
434            left join raw_unique as p
435              on c.gvkey=p.gvkey and p.fyear=c.fyear-1
436            where c.fyear between 1981 and 1997
437            group by c.fyear
438            order by c.fyear;
