1480       proc sql;
1481           create table work.delta_peer_candidates as
1482           select e.dealid,e.acqgvkey,e.acq_sic2a as sic2,e.baseyear,
1483                  e.acq_roa as match_roa,p.gvkey as peergvkey length=6,p.roa as peer_base_roa
1484           from work.events3 as e inner join work.fa_cal as p
1485             on p.calyear=e.baseyear and p.sic2=e.acq_sic2a
1486           where not missing(e.acqgvkey) and not missing(e.acq_roa) and
1487                 not missing(e.acq_sic2a) and p.gvkey ne e.acqgvkey and not missing(p.roa)
1488             and p.roa>=min(0.8*e.acq_roa,1.2*e.acq_roa)
1489             and p.roa<=max(0.8*e.acq_roa,1.2*e.acq_roa);
