1554       proc sql;
1555           create table work.analysis0 as
1556           select e.*,c.acq_car,c.trg_car,c.n_acq_eventdays,c.n_trg_eventdays,
1557                  r.trg_comprnk,r.trg_comp,r.n_comp_peers,
