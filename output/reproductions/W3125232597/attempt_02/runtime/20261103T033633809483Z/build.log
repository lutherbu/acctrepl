1518       data work.delta_out;
1519           set work.acq_roa_year;
1520           by dealid;
1521           retain pre_sum post_sum pre_n post_n;
1522           if first.dealid then do; pre_sum=0; post_sum=0; pre_n=0; post_n=0; end;
1523           if not missing(adj_roa) then do;
1524               if calyear>=compyear-3 and calyear<=compyear-1 then do;
1525                   pre_sum+adj_roa; pre_n+1;
1526               end;
1527               else if calyear>=compyear+1 and calyear<=compyear+3 then do;
1528                   post_sum+adj_roa; post_n+1;
1529               end;
1530           end;
1531           if last.dealid then do;
1532               delta_roa=.;
1533               if pre_n=3 and post_n=3 then delta_roa=post_sum/3-pre_sum/3;
1534               output;
1535           end;
1536           keep dealid compyear pre_n post_n delta_roa;
1537           label delta_roa='Post-completion mean benchmark-adjusted ROA less pre-completion mean';
1538       run;

