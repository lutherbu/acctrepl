1560                  b.block,b.n_observed_managers,b.latest_holdings_rdate,b.max_fdate,
1561                  d.delta_roa,d.compyear,d.pre_n,d.post_n,
1562                  case when e.acq_mve_usd>0 and e.trg_mve_usd>0 and
1563                            not missing(c.acq_car) and not missing(c.trg_car)
1564                       then (e.acq_mve_usd/(e.acq_mve_usd+e.trg_mve_usd))*c.acq_car+
1565                            (e.trg_mve_usd/(e.acq_mve_usd+e.trg_mve_usd))*c.trg_car
1566                       else . end as synergy
1567           from work.events3 as e
