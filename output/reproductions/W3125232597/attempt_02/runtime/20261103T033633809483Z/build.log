1425                    else . end as frac_basis_diff
1426           from work.s34_target_first as h inner join work.crsp_names0 as n
1427             on n.permno=h.trgpermno and n.ncusip=h.s34cusip8
1428            and h.rdate>=n.namedt and h.rdate<=n.nameenddt
