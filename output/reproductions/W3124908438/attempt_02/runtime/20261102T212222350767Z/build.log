212        options msglevel=n;
213        proc sql;
214            create table pricedate0 as
215            select a.gvkey,a.iid,a.fyear,a.datadate,a.prcc_f,
216                   max(b.datadate) as price_date format=date9.
217            from price_unres as a left join price_day as b
218              on a.gvkey=b.gvkey and a.iid=b.iid
219             and b.datadate between a.datadate-7 and a.datadate
220            group by a.gvkey,a.iid,a.fyear,a.datadate,a.prcc_f;
NOTE: Table WORK.PRICEDATE0 created, with 7385 rows and 6 columns.

221            create table priceday as
222            select a.gvkey,a.iid,a.fyear,a.datadate,a.prcc_f,p.price_date,
223                   count(b.datadate) as day_rows,
224                   count(distinct upcase(strip(b.curcdd))) as day_ccy_n,
225                   min(upcase(strip(b.curcdd))) as day_cur length=3,
226                   min(abs(b.prccd-a.prcc_f)) as day_gap,
227                   a.datadate-p.price_date as price_age
228            from price_unres as a left join pricedate0 as p
229              on a.gvkey=p.gvkey and a.iid=p.iid and a.fyear=p.fyear
230               and a.datadate=p.datadate
231            left join price_day as b
232              on a.gvkey=b.gvkey and a.iid=b.iid and p.price_date=b.datadate
233            group by a.gvkey,a.iid,a.fyear,a.datadate,a.prcc_f,p.price_date;
NOTE: Invalid (or missing) arguments to the ABS function have caused the function to return a missing value.
NOTE: Table WORK.PRICEDAY created, with 7385 rows and 11 columns.

234            create table price_final as
235            select a.gvkey,a.iid,a.fyear,a.datadate,a.prcc_f,
236               case when a.mth_ok=1 then a.mth_cur
237                    when b.day_rows=1 and b.day_ccy_n=1 and b.price_age between 0 and 7
238                     and b.day_gap<=max(1e-8,abs(a.prcc_f)*1e-6) then b.day_cur
239                    else '' end as price_cur length=3,
240               case when a.mth_ok=1 then 1
13                                                         The SAS System                     Tuesday, November  3, 2026 05:22:00 AM

241                    when b.day_rows=1 and b.day_ccy_n=1 and b.price_age between 0 and 7
242                     and b.day_gap<=max(1e-8,abs(a.prcc_f)*1e-6) then 1
243                    else 0 end as price_ok,
244               case when a.mth_ok=1 then a.mth_date else b.price_date end as price_date format=date9.,
245               case when a.mth_ok=1 then 'MONTH'
246                    when b.day_rows=1 and b.day_ccy_n=1 and b.price_age between 0 and 7
247                     and b.day_gap<=max(1e-8,abs(a.prcc_f)*1e-6) then 'DAY_7'
248                    when missing(b.day_rows) or b.day_rows=0 then 'NO_DAILY_7'
249                    when b.day_ccy_n ne 1 then 'AMBIG_DAILY'
250                    when b.day_gap>max(1e-8,abs(a.prcc_f)*1e-6) then 'PRICE_MISMATCH'
251                    else 'UNRESOLVED' end as price_status length=16,
252               case when a.mth_ok=1 then . else b.price_age end as price_age,
253               a.mth_rows,a.mth_ccy_n,a.mth_gap,b.day_rows,b.day_ccy_n,b.day_gap
254            from pricem as a left join priceday as b
255              on a.gvkey=b.gvkey and a.iid=b.iid and a.fyear=b.fyear
256               and a.datadate=b.datadate;
NOTE: Table WORK.PRICE_FINAL created, with 148126 rows and 16 columns.

257            create table fundprice as
258            select a.*,p.price_cur,p.price_ok,p.price_date,p.price_status,p.price_age
259            from fundbase as a left join price_final as p
260              on a.gvkey=p.gvkey and a.iid=p.iid and a.fyear=p.fyear
261               and a.datadate=p.datadate;
NOTE: Table WORK.FUNDPRICE created, with 217521 rows and 31 columns.

262            select count(*) into :n_price_verified trimmed from price_final where price_ok=1;
263            select count(*) into :n_price_unverified trimmed from price_final where price_ok ne 1;
264        quit;
