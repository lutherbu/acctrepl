912                  not missing(noa) and noa>=0 and not missing(oiadp) and oiadp>=0 and
913                  currency_ok=1) as n_after_currency,
914              sum(not missing(sic_screen) and not (sic_screen>=6000 and sic_screen<=6999) and
915                  not missing(noa) and noa>=0 and not missing(oiadp) and oiadp>=0 and
