513        data retbase;
514            set ret0;
515            badret=(ret in (-66,-77,-88,-99));
516            baddel=(dlret in (-66,-77,-88,-99));
517            if badret then ret=.;
518            if baddel then dlret=.;
519            if missing(dlret) and (dlstcd=500 or (dlstcd>=520 and dlstcd<=584)) then do;
520                if hexcd in (1,2) then dlret=-0.35;
521                else if hexcd=3 then dlret=-0.55;
522            end;
523            if not missing(ret) and not missing(dlret) then
524                retadj=(1+ret)*(1+dlret)-1;
525            else if missing(ret) and not missing(dlret) then retadj=dlret;
526            else if not missing(ret) then retadj=ret;
527            else retadj=.;
528            format date dlstdt date9.;
529        run;

