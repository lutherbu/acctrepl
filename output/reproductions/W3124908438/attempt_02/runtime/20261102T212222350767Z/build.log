270        /* Exact FYEAR joins preserve gaps and retain the two-year lag and one-year
271           lead needed for changes and future DuPont levels. */
272        proc sql;
273            create table panel0 as
274            select a.gvkey,a.fyear,a.datadate,a.sich,a.curcd,a.curncd,a.noa,a.sale,a.oiadp,
275                   a.iid as iid0,a.epspx,a.ajex,a.prcc_f,
276                   p.iid as iidm1,p.prcc_f as prccm1,p.price_cur as prccm1_cur,
277                   p.price_ok as prccm1_verified,p.price_date as prccm1_date,
14                                                         The SAS System                     Tuesday, November  3, 2026 05:22:00 AM

278                   p.price_status as prccm1_price_status,p.price_age as prccm1_price_age,
279                   p.datadate as datam1,p.noa as noam1,p.sale as salem1,
280                   p.oiadp as opm1,p.epspx as epsm1,p.ajex as ajexm1,
281                   p.curcd as curm1,p.curncd as curnm1,
282                   q.datadate as datam2,q.noa as noam2,q.curcd as curm2,q.curncd as curnm2,
283                   n.datadate as datap1,n.noa as noap1,n.sale as salep1,
284                   n.oiadp as opp1,n.curcd as curp1,n.curncd as curnp1,
285                   l.permno,lp.permno as permm1
286            from fundprice as a
287            left join fundprice as p on a.gvkey=p.gvkey and p.fyear=a.fyear-1
288            left join fundprice as q on a.gvkey=q.gvkey and q.fyear=a.fyear-2
289            left join fundprice as n on a.gvkey=n.gvkey and n.fyear=a.fyear+1
290            left join linkone as l on a.gvkey=l.gvkey and a.fyear=l.fyear
291            left join linkone as lp on a.gvkey=lp.gvkey and lp.fyear=a.fyear-1
292            where a.fyear between 1984 and 2002;
NOTE: Table WORK.PANEL0 created, with 192113 rows and 40 columns.

