117        /* CCM links are matched at the fiscal-year report date. Exact duplicate
118           rows for the same PERMNO are collapsed before applying a priority rule;
119           multiple highest-priority PERMNOs remain ambiguous and are not selected. */
120        proc sql;
121            create table lraw as
122            select f.gvkey,f.fyear,l.lpermno as permno,
123                   case when l.linkprim='P' then 4 else 0 end+
124                   case when l.linktype='LC' then 2 else 1 end as score
125            from fundbase as f inner join ccm.ccmxpf_lnkhist as l
126              on f.gvkey=l.gvkey
127            where l.linktype in ('LC','LU') and l.linkprim in ('P','C')
128              and not missing(l.lpermno) and l.linkdt<=f.datadate
129              and (missing(l.linkenddt) or l.linkenddt>=f.datadate);
NOTE: Table WORK.LRAW created, with 140511 rows and 4 columns.

