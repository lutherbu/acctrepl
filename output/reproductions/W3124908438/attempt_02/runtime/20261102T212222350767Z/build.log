547            length wid 8;
548            wid=1; wstart=intnx('month',datadate,-11,'b'); wend=datadate; output;
549            /* Four complete calendar months elapse after FY end before the
550               one-year future return window begins. For 31DEC, start is 01MAY. */
551            wid=2; wstart=intnx('month',datadate,5,'b');
552            wend=intnx('month',wstart,11,'e'); output;
553            format wstart wend date9.;
554            keep gvkey fyear permno wid wstart wend;
555        run;

