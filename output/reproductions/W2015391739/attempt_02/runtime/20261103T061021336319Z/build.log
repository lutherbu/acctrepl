10         /* One annual industrial-format observation per Compustat company-year.
11            If a fiscal-year label has multiple end dates in the current vintage, retain
12            its latest annual period end; ties at the same date use the latest FDATE. */
13         data funda_candidate;
14           set comp.funda(keep=gvkey datadate fyear fdate indfmt consol popsrc datafmt
15                               curcd pddur ib);
16           where fyear>=1963 and fyear<=1990
17             and indfmt='INDL' and consol='C' and popsrc='D' and datafmt='STD';
18           if not missing(gvkey) and not missing(datadate);
19           curcd=upcase(strip(curcd));
20           format datadate date9.;
21         run;

