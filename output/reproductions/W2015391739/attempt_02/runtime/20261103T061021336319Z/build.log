248        /* Exact FYE-9 month anchor: use the CRSP monthly observation in that period.
249           CCM supplies the return security and PERMCO. */
250        proc sql;
251          create table anchor_candidates as
252          select distinct f.obsid,f.gvkey,f.fyear,f.datadate,f.anchor_mth,
253                 l.lpermno as permno,l.lpermco as permco,
254                 l.linkprim,l.linktype,
255                 case when l.linkprim='P' then 1 else 2 end as prim_rank,
256                 case when l.linktype='LC' then 1 else 2 end as type_rank,
257                 m.date as anchor_date,abs(m.prc)*m.shrout as primary_mve
258          from funda_usd as f
259          inner join linkbase as l on f.gvkey=l.gvkey
260          inner join crsp.msf as m on m.permno=l.lpermno and m.permco=l.lpermco
261          where intnx('month',m.date,0,'b')=f.anchor_mth
262            and (l.linkdt=.B or l.linkdt<=m.date)
263            and (l.linkenddt=.E or l.linkenddt>=m.date)
264            and m.date between '01jan1962'd and '31dec1991'd;
NOTE: Invalid (or missing) arguments to the ABS function have caused the function to return a missing value.
