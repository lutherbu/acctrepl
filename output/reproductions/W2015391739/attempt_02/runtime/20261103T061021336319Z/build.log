336                                   and l.lpermco=c.permco
337          where intnx('month',m.date,0,'b') between
338                  intnx('month',c.datadate,-8,'b') and intnx('month',c.datadate,3,'b')
339            and (l.linkdt=.B or l.linkdt<=m.date)
340            and (l.linkenddt=.E or l.linkenddt>=m.date)
341            and m.date between '01jan1962'd and '31dec1991'd;
