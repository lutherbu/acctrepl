61         proc sql;
62           create table work.lagged as
63           select a.*,
64                  b.fyear as fyear_lag1,
65                  b.datadate as datadate_lag1,
66                  b.curcd as curcd_lag1,
67                  b.at as at_lag1,
68                  b.sale as sale_lag1,
69                  b.invt as invt_lag1,
70                  b.rect as rect_lag1,
71                  c.fyear as fyear_lag2,
72                  c.datadate as datadate_lag2,
73                  c.curcd as curcd_lag2,
74                  c.sale as sale_lag2
75           from work.annual as a
76           left join work.annual as b
77             on a.gvkey=b.gvkey and b.fyear=a.fyear-1
78           left join work.annual as c
79             on a.gvkey=c.gvkey and c.fyear=a.fyear-2;
