91         /* Sample years, historical industry, nonfinancial screen, and scaled inputs. */
92         data work.target;
93           set work.lagged;
94           if fyear lt 1987 or fyear gt 2005 then delete;
95           if missing(sich) or sich lt 1000 or sich gt 9999 then delete;
96           if sich ge 6000 and sich le 6999 then delete;
97           sich2=floor(sich/100);
98         
99           time=fyear-1987;
100          sca=(fyear ge 2000 and fyear le 2001);
101          sox=(fyear ge 2002 and fyear le 2005);
102        
103          currency_t_lag1_match=0;
104          if not missing(curcd) and not missing(curcd_lag1) and curcd=curcd_lag1 then
105            currency_t_lag1_match=1;
106          currency_lag1_lag2_match=0;
107          if not missing(curcd_lag1) and not missing(curcd_lag2) and curcd_lag1=curcd_lag2 then
108            currency_lag1_lag2_match=1;
109        
110          /* Raw completeness flags support exact counts before applying currency validity. */
111          raw_jones_support=(nmiss(ibc,oancf,xidoc,at_lag1,sale,sale_lag1,
112                                   rect,rect_lag1,ppegt)=0 and at_lag1 gt 0);
113          raw_cfo_support=(nmiss(oancf,xidoc,at_lag1,sale,sale_lag1)=0 and at_lag1 gt 0);
114          raw_prod_support=(nmiss(cogs,invt,invt_lag1,at_lag1,sale,sale_lag1,sale_lag2)=0
115                            and at_lag1 gt 0);
116          raw_disx_support=(nmiss(xsga,at_lag1,sale_lag1)=0 and at_lag1 gt 0);
117          raw_common_support=(raw_jones_support and raw_cfo_support and
118                              raw_prod_support and raw_disx_support);
119        
120          /* Only subtract monetary values when both periods use the same CURCD. */
121          if currency_t_lag1_match and not missing(sale) and not missing(sale_lag1) then
122            delta_sale=sale-sale_lag1;
123          if currency_lag1_lag2_match and not missing(sale_lag1) and not missing(sale_lag2) then
124            delta_sale_lag=sale_lag1-sale_lag2;
125          if currency_t_lag1_match and not missing(rect) and not missing(rect_lag1) then
126            delta_ar=rect-rect_lag1;
127        
128          if not missing(at_lag1) and at_lag1 gt 0 then do;
129            inv_atlag=1/at_lag1;
130            if currency_t_lag1_match and not missing(sale) then sale_scaled=sale/at_lag1;
131            if not missing(delta_sale) then delta_sale_scaled=delta_sale/at_lag1;
132            if not missing(delta_sale_lag) then delta_sale_lag_scaled=delta_sale_lag/at_lag1;
133            if not missing(delta_sale) and not missing(delta_ar) then
134              delta_sale_ar_scaled=(delta_sale-delta_ar)/at_lag1;
135            if currency_t_lag1_match and not missing(ppegt) then ppe_scaled=ppegt/at_lag1;
136            if not missing(sale_lag1) then lag_sale_scaled=sale_lag1/at_lag1;
137            if currency_t_lag1_match and not missing(ibc) and not missing(oancf) and not missing(xidoc) then do;
                                                           The SAS System

138              cfo=oancf-xidoc;
139              total_accrual=ibc-cfo;
140              cfo_scaled=cfo/at_lag1;
141              total_accrual_scaled=total_accrual/at_lag1;
142            end;
143            if currency_t_lag1_match and not missing(cogs) and not missing(invt) and not missing(invt_lag1) then do;
144              production_cost=cogs+invt-invt_lag1;
145              production_scaled=production_cost/at_lag1;
146            end;
147            if currency_t_lag1_match and not missing(xsga) then do;
148              discretionary_expense=xsga+coalesce(xad,0)+coalesce(xrd,0);
149              discretionary_scaled=discretionary_expense/at_lag1;
150            end;
151          end;
152        run;

