124            if missing(sga_t) or missing(sales_t) or missing(sga_lag) or missing(sales_lag) then delete;
125            if sga_t > sales_t then delete;
126            if sga_t <= 0 or sales_t <= 0 or sga_lag <= 0 or sales_lag <= 0 then delete;
127        
128            legacy_dy = log(sga_t / sga_lag);
129            legacy_dx = log(sales_t / sales_lag);
130            legacy_decrease = (sales_t < sales_lag);
131            legacy_interaction = legacy_decrease * legacy_dx;
132        
133            same_currency = .;
134            cross_currency = .;
135            currency_status = "NO-CURCD";
136            sga_t_fitunit = .;
137            sales_t_fitunit = .;
138            sga_lag_fitunit = .;
139            sales_lag_fitunit = .;
140        
141            if not missing(curcd_t) and not missing(curcd_lag) then do;
142                same_currency = (curcd_t = curcd_lag);
143                cross_currency = (curcd_t ne curcd_lag);
144                if same_currency then do;
145                    currency_status = "SAME-CURRENCY";
146                    sga_t_fitunit = sga_t;
147                    sales_t_fitunit = sales_t;
148                    sga_lag_fitunit = sga_lag;
149                    sales_lag_fitunit = sales_lag;
150                end;
151                else if currtr_t > 0 and currtr_lag > 0 then currency_status = "CROSS-UNAVAILABLE";
152                else currency_status = "CROSS-NO-RATE";
153            end;
154        
155            dy = .;
156            dx = .;
157            decrease = .;
158            interaction = .;
159            if not missing(sga_t_fitunit) and not missing(sales_t_fitunit) and
160               not missing(sga_lag_fitunit) and not missing(sales_lag_fitunit) then do;
161                dy = log(sga_t_fitunit / sga_lag_fitunit);
162                dx = log(sales_t_fitunit / sales_lag_fitunit);
163                decrease = (sales_t_fitunit < sales_lag_fitunit);
164                interaction = decrease * dx;
165            end;
166            changed_formula = .;
