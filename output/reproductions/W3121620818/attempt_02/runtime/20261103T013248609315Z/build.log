626        
627        /* Greedy nearest-asset matching in case order; a control firm-year is used once.
628           Ties use the lowest character GVKEY. A firm may appear in another event year. */
629        data matches;
630          if _n_=1 then do;
631            declare hash used();
632            used.defineKey('fyear','ctrlgvkey');
633            used.defineDone();
634          end;
635          set candidate_pairs;
636          by fyear caseid;
637          retain chosen;
638          if first.caseid then chosen=0;
639          if chosen=0 and used.check() ne 0 then do;
640            rc=used.add();
641            chosen=1;
642            pairid=caseid;
643            output;
644          end;
645          keep pairid caseid fyear casegvkey ctrlgvkey sic2 big6 case_at_usd ctrl_at_usd asset_dist;
646        run;

