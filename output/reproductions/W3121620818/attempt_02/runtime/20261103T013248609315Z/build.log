167        
168        data metrics;
169          set panel_lag;
170          length ta ta_s inv_at rev_s rec_s ppe_s rev_delta rec_delta perform de 8;
171          ta=.; ta_s=.; inv_at=.; rev_s=.; rec_s=.; ppe_s=.;
172          rev_delta=.; rec_delta=.; perform=.; de=.;
173          if not missing(at) and at>0 and not missing(dltt) then de=dltt/at;
174          if lagyear=fyear-1 and not missing(curcd) and curcd=lagcurcd then do;
175            if not missing(at_lag) and at_lag>0 then inv_at=1/at_lag;
176            if nmiss(act,act_lag,che,che_lag,lct,lct_lag,dlc,dlc_lag,dp)=0 and
177               not missing(at_lag) and at_lag>0 then do;
178              ta=(act-act_lag)-(che-che_lag)-(lct-lct_lag)+(dlc-dlc_lag)-dp;
179              ta_s=ta/at_lag;
180            end;
181            if nmiss(revt,revt_lag)=0 then do;
182              rev_delta=revt-revt_lag;
183              if not missing(at_lag) and at_lag>0 then rev_s=rev_delta/at_lag;
184            end;
185            if nmiss(rect,rect_lag)=0 then do;
186              rec_delta=rect-rect_lag;
187              if not missing(at_lag) and at_lag>0 then rec_s=rec_delta/at_lag;
188            end;
189            if not missing(ppegt) and not missing(at_lag) and at_lag>0 then ppe_s=ppegt/at_lag;
190            if nmiss(ib,ib_lag,at_lag)=0 and at_lag>0 then perform=abs(ib-ib_lag)/at_lag;
191          end;
192        run;

