149        proc sql;
150          create table panel_lag as
151          select a.*,
152                 b.fyear as lagyear,
153                 b.datadate as lagdate,
154                 b.curcd as lagcurcd,
155                 b.at as at_lag,
156                 b.act as act_lag,
157                 b.che as che_lag,
158                 b.lct as lct_lag,
159                 b.dlc as dlc_lag,
160                 b.revt as revt_lag,
161                 b.rect as rect_lag,
                                                           The SAS System

162                 b.ib as ib_lag
163          from raw as a
164          left join raw as b
165            on a.gvkey=b.gvkey and b.fyear=a.fyear-1;
NOTE: Table WORK.PANEL_LAG created, with 229156 rows and 45 columns.

166        quit;
NOTE: PROCEDURE SQL used (Total process time):
