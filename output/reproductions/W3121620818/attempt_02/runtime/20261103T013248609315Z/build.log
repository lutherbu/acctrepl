746        proc means data=score noprint;
747          var bp mktcap de perform abs_tsj abs_tsmj abs_csj abs_csmj;
748          output out=win_stats
749            n=n_bp n_mktcap n_de n_perform n_tsj n_tsmj n_csj n_csmj
750            mean=mu_bp mu_mktcap mu_de mu_perform mu_tsj mu_tsmj mu_csj mu_csmj
751            std=sd_bp sd_mktcap sd_de sd_perform sd_tsj sd_tsmj sd_csj sd_csmj;
752        run;

