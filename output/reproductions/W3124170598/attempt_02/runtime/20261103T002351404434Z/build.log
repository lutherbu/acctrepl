174        /* Date-effective CRSP USD market equity: aggregate common share classes per PERMCO. */
175        proc sql;
176            create table work.crsp_security_month as
177            select m.permno, m.date,
178                   case when count(distinct m.permco)=1 then max(m.permco) else . end as permco,
179                   count(distinct m.permco) as permco_n,
180                   count(n.permno) as name_rows,
181                   case when count(distinct n.shrcd)=1 then max(n.shrcd) else . end as shrcd,
182                   count(distinct n.shrcd) as shrcd_n,
183                   max(n.shrcd in (10,11)) as common_candidate,
184                   sum(case when not missing(n.permno) and
185                                 (missing(n.shrcd) or n.shrcd not in (10,11))
186                            then 1 else 0 end) as unknown_sharecode_rows,
187                   case when count(distinct m.prc)=1 then max(abs(m.prc)) else . end as prc_usd,
188                   count(distinct m.prc) as prc_n,
189                   count(m.prc) as prc_obs,
190                   case when count(distinct m.shrout)=1 then max(m.shrout) else . end as shrout_thousands,
191                   count(distinct m.shrout) as shrout_n,
192                   count(m.shrout) as shrout_obs
193            from CRSP.MSF as m
194            left join CRSP.STOCKNAMES as n
195              on m.permno=n.permno
196             and m.date >= n.namedt
197             and (missing(n.nameenddt) or m.date <= n.nameenddt)
198            where m.date >= '01JAN1962'd and m.date <= &mve_end_date
199            group by m.permno, m.date;
NOTE: SAS threaded sort was used.
NOTE: Invalid (or missing) arguments to the ABS function have caused the function to return a missing value.
NOTE: Table WORK.CRSP_SECURITY_MONTH created, with 2534935 rows and 15 columns.

