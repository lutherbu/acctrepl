201            create table work.crsp_monthly_mve_audit as
202            select permco, date,
203                   sum(common_candidate) as common_security_count,
204                   sum(case when common_candidate=1 and
205                             (permco_n ne 1 or unknown_sharecode_rows>0 or prc_n>1 or shrout_n>1)
206                            then 1 else 0 end) as conflict_security_count,
207                   sum(case when common_candidate=1 and
208                             (prc_obs=0 or shrout_obs=0 or missing(prc_usd) or prc_usd<=0 or
209                              missing(shrout_thousands) or shrout_thousands<=0)
210                            then 1 else 0 end) as incomplete_security_count,
211                   sum(case when common_candidate=1 and permco_n=1 and shrcd_n=1 and
212                             prc_n=1 and prc_obs>0 and shrout_n=1 and shrout_obs>0 and
213                             prc_usd>0 and shrout_thousands>0
214                            then prc_usd*shrout_thousands else 0 end)/1000 as clean_mve
215            from work.crsp_security_month
216            where common_candidate=1 and permco_n=1
217            group by permco, date;
NOTE: SAS threaded sort was used.
