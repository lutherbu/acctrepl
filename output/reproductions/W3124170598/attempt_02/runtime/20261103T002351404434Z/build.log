546        /* Keep incomplete components missing. Require same USD denomination in both periods. */
547        data work.support;
548            set work.lagged;
549            if curcd ne 'USD' or curcd_lag ne 'USD' then delete;
550            if missing(sic2) or sic2 <= 0 then delete;
551        
552            ta=.; inv_at=.; d_sales=.; d_mj=.; ppe_n=.; roa_cur=.; roa_lag=.;
553            btm=.; ep=.; sales_gr=.; ocf_at=.;
554            if at_lag > 0 and nmiss(act,act_lag,che,che_lag,lct,lct_lag,dlc,dlc_lag,dp)=0 then
555                ta=((act-act_lag)-(che-che_lag)-(lct-lct_lag)+(dlc-dlc_lag)-dp)/at_lag;
556            if at_lag > 0 then inv_at=1/at_lag;
557            if at_lag > 0 and nmiss(sale,sale_lag)=0 then d_sales=(sale-sale_lag)/at_lag;
558            if at_lag > 0 and nmiss(sale,sale_lag,rect,rect_lag)=0 then
559                d_mj=((sale-sale_lag)-(rect-rect_lag))/at_lag;
560            if at_lag > 0 and not missing(ppent) then ppe_n=ppent/at_lag;
561            if at > 0 and not missing(ni) then roa_cur=ni/at;
562            if at_lag > 0 and not missing(ni_lag) then roa_lag=ni_lag/at_lag;
563            if mve > 0 and not missing(ceq) then btm=ceq/mve;
564            if mve > 0 and not missing(ni) then ep=ni/mve;
565            if sale_lag ne 0 and nmiss(sale,sale_lag)=0 then sales_gr=(sale-sale_lag)/sale_lag;
566            length ocf_src $6;
567            ocf_src='MISSING';
568            if at > 0 and not missing(oancf) then do;
569                ocf_at=oancf/at;
570                ocf_src='OANCF';
571            end;
572            else if at > 0 and not missing(ni) and not missing(ta) and
573                    not missing(at_lag) and at_lag > 0 then do;
574                ocf_at=(ni-(ta*at_lag))/at;
575                ocf_src='NI_TA';
576            end;
