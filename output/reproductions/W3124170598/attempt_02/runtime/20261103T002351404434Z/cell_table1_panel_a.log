. local residual_checks_j=0

. foreach g of local groups_j {
  2.     regress ta inv_at d_sales ppe_n if fitgrp==`g' & n_j>=10, noheader not
> able
  3.     local native_rank = e(rank)
  4.     quietly replace rank_j=`native_rank' if fitgrp==`g'
  5.     if `native_rank'==4 & `residual_checks_j'<3 {
  6.         capture drop audit_resid_native audit_resid_abs
  7.         predict double audit_resid_native if e(sample), residual
  8.         gen double audit_resid_abs=abs(_residuals-audit_resid_native) if e
> (sample)
  9.         quietly summarize audit_resid_abs if fitgrp==`g', meanonly
 10.         local audit_n_j=r(N)
 11.         local audit_max_j=r(max)
 12.         display as text "Residual comparison (Jones equation (6)): group=`
> g'; N=`audit_n_j'; max |asreg-native|=`audit_max_j'"
 13.         drop audit_resid_native audit_resid_abs
 14.         local ++residual_checks_j
 15.     }
 16. }
