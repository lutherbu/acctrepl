223        data work.metrics;
224            set work.paired;
225            length sic_source 8;
226            sic_final=sic_comp;
227            sic_source=1;
228            if missing(sic_final) or sic_final=0 then do;
229                sic_final=sic_crsp;
230                sic_source=2;
231            end;
232            if missing(sic_final) or sic_final=0 then delete;
233            if sic_final>=6000 and sic_final<=6999 then delete;
234            if missing(curcd_t) or missing(curcd_prev) then delete;
235            if curcd_t ne curcd_prev then delete;
236            if missing(at_t) or missing(at_prev) then delete;
237            if at_t<=0 or at_prev<=0 then delete;
238            if missing(ibc_t) or missing(oancf_t) or missing(ivncf_t) then delete;
239        
240            avg_at_t=(at_t+at_prev)/2;
241            if missing(avg_at_t) or avg_at_t<=0 then delete;
242            earnings_t=ibc_t/avg_at_t;
243            cfo_t=oancf_t/avg_at_t;
244            cfi_t=ivncf_t/avg_at_t;
245            if missing(fincf_t) then cff_t=.;
246            else cff_t=fincf_t/avg_at_t;
247            fcf_t=(oancf_t+ivncf_t)/avg_at_t;
248            opacc_t=(ibc_t-oancf_t)/avg_at_t;
249            tacc_t=(ibc_t-(oancf_t+ivncf_t))/avg_at_t;
250        
9                                                          The SAS System                     Tuesday, November  3, 2026 01:41:00 PM

251            spi_missing=missing(spi_t);
252            if spi_missing then spi0=0;
253            else spi0=spi_t;
254            spi_ratio=spi0/avg_at_t;
255            si=(spi_ratio<=-0.02);
256            format datadate datadate_prev datadate_next yymmdd10.;
257        run;

