190        proc sql;
191            create table work.paired as
192            select c.gvkey, c.fyear, c.datadate, c.permno, c.curcd as curcd_t,
193                   c.at as at_t, c.ceq as ceq_t, c.ibc as ibc_t,
194                   c.oancf as oancf_t, c.ivncf as ivncf_t, c.fincf as fincf_t,
195                   c.spi as spi_t, c.sich as sic_comp, c.sic_crsp,
196                   p.datadate as datadate_prev, p.at as at_prev, p.curcd as curcd_prev,
197                   n.datadate as datadate_next, n.ibc as ibc_next, n.at as at_next,
198                   n.ceq as ceq_next, n.curcd as curcd_next
199            from work.current_linked as c
200            left join work.funda0 as p
201              on c.gvkey=p.gvkey and p.fyear=c.fyear-1
202            left join work.funda0 as n
203              on c.gvkey=n.gvkey and n.fyear=c.fyear+1;
