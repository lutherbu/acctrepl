. forvalues yr = 1964/1993 {
  2.     quietly count if year == `yr'
  3.     local annual_n = r(N)
  4.     if `annual_n' > 0 {
  5.         regress roa_f1 grltnoa acc roa if year == `yr'
  6.         local fit_rc = _rc
  7.         if `fit_rc' == 0 {
  8.             local r2sum = `r2sum' + e(r2_a)
  9.             local ++annual_fits
 10.             test grltnoa = acc
 11.             local p_equal = r(p)
 12.             local b_lt = _b[grltnoa]
 13.             local b_acc = _b[acc]
 14.             if missing(`p_equal') {
 15.                 local ++missing_tests
 16.                 display as error "Missing annual equality test in `yr' (N=
> `annual_n')"
 17.             }
 18.             else if `p_equal' < 0.01 {
 19.                 if `b_acc' < `b_lt' local ++acc_lt_lt
 20.                 else if `b_acc' > `b_lt' local ++acc_gt_lt
 21.                 else local ++equal_slopes
 22.             }
 23.             else local ++equal_slopes
 24.         }
 25.         else {
 26.             local ++annual_failures
 27.             display as error "Annual OLS failed in `yr' (N=`annual_n', ret
> urn=`fit_rc')"
