66             create table work.price_key as
67             select a.gvkey, a.fyear, a.datadate, max(1) as hasprice
68             from work.funda_unique as a
69             inner join work.link_support as l
70               on a.gvkey=l.gvkey
71              and (missing(l.linkdt) or l.linkdt<=a.datadate)
72              and (missing(l.linkenddt) or l.linkenddt>=a.datadate)
73             inner join work.msf_support as m
74               on l.lpermno=m.permno
75              and m.date<=a.datadate
76              and m.date>=intnx('month',a.datadate,-1,'end')
77              and (missing(l.linkdt) or m.date>=l.linkdt)
78              and (missing(l.linkenddt) or m.date<=l.linkenddt)
79              and not missing(m.prc) and not missing(m.shrout)
80             where a.fyear between 1963 and 1994
81             group by a.gvkey, a.fyear, a.datadate;
