115        
116        data work.constructed;
117            set work.pairs_price;
118            length year 8;
119            year=fyear;
120        
121            date_order=not missing(datadate_l) and not missing(datadate_f)
122                and datadate_l<datadate and datadate_f>datadate;
123            same_currency=not missing(curcd) and not missing(curcd_l) and not missing(curcd_f)
124                and curcd_l=curcd and curcd_f=curcd;
125            complete_inputs=(nmiss(oiadp,oiadp_f,at,at_l,at_f,
126                rect,rect_l,invt,invt_l,aco,aco_l,ap,ap_l,lco,lco_l,dp,
127                ppent,ppent_l,intan,intan_l,ao,ao_l,lo,lo_l)=0);
128        
129            goodwill_observed=(not missing(gdwl) and not missing(gdwl_l));
130            goodwill_increase=(goodwill_observed and gdwl>gdwl_l);
131        
132            avgta=(at_l+at)/2;
133            avgta_f=(at+at_f)/2;
134            if complete_inputs and avgta>0 and avgta_f>0 then do;
135                roa=oiadp/avgta;
136                roa_f1=oiadp_f/avgta_f;
137                grwc_raw=(rect-rect_l)+(invt-invt_l)+(aco-aco_l)
138                         -(ap-ap_l)-(lco-lco_l);
139                grwc=grwc_raw/avgta;
140                depamort=-dp/avgta;
141                acc=(grwc_raw-dp)/avgta;
142                cfo=roa-acc;
6                                                          The SAS System                     Tuesday, November  3, 2026 06:00:00 AM

143                noa=rect+invt+aco+ppent+intan+ao-ap-lco-lo;
144                noa_l=rect_l+invt_l+aco_l+ppent_l+intan_l+ao_l-ap_l-lco_l-lo_l;
145                grnoa=(noa-noa_l)/avgta;
146                grltnoa_full=grnoa-acc;
147                grltnoa=((ppent-ppent_l)+(intan-intan_l)+(ao-ao_l)
148                        -(lo-lo_l)+dp)/avgta;
149                grlt_check=grltnoa_full-grltnoa;
150            end;
151            else call missing(roa,roa_f1,grwc,depamort,acc,cfo,noa,noa_l,
152                              grnoa,grltnoa_full,grltnoa,grlt_check);
153        
154            model_complete=complete_inputs and avgta>0 and avgta_f>0
155                and not missing(roa) and not missing(roa_f1)
156                and not missing(acc) and not missing(grltnoa)
157                and not missing(grnoa);
158            unclassified_bspr=(bspr='GB');
159            prices_complete=(hasprice_l=1 and hasprice=1 and hasprice_f=1);
160            baseline=(date_order and same_currency and prices_complete
161                      and model_complete and not goodwill_increase
162                      and not unclassified_bspr);
163            label roa_f1='One-year-ahead ROA'
164                  roa='Current ROA'
165                  acc='Operating accruals'
166                  cfo='Cash flows from operations'
167                  grltnoa='Growth in long-term net operating assets'
168                  grnoa='Growth in net operating assets'
169                  grwc='Growth in working capital'
170                  depamort='Depreciation and amortization (negative)';
171        run;

