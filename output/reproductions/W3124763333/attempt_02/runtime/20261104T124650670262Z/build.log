478        
479            create table event_base as
480            select e.*, l.permno as permno_form,
481                   coalesce(n.n_permno,0) as form_link_count,
482                   f.date as rank_cap_date, f.cap_source,
483                   case when f.cap_source=1 then 1
484                        when f.cap_source=2 and
485                             (f.date<e.start_month or
486                              (year(f.date)=year(e.start_month) and
487                               month(f.date)=month(e.start_month))) then 1
488                        else 0 end as cap_date_usable,
489                   case when f.cap_source=1 then 'prior-dec'
490                        when f.cap_source=2 and f.date<e.start_month then 'before-start'
491                        when f.cap_source=2 and year(f.date)=year(e.start_month) and
492                             month(f.date)=month(e.start_month) then 'same-month'
493                        when f.cap_source=2 then 'after-start'
494                        else 'no-rank' end as cap_date_class length=16,
495                   case when f.cap_source=1 or
496                             (f.cap_source=2 and
497                              (f.date<e.start_month or
498                               (year(f.date)=year(e.start_month) and
499                                month(f.date)=month(e.start_month))))
500                        then f.decile else . end as decile,
501                   case when coalesce(n.n_permno,0)>1 or
502                                  (coalesce(n.n_permno,0)=1 and n.n_permco ne 1)
503                        then .
504                        when coalesce(n.n_permno,0)=1 then l.permno
505                        else e.permno_fye end as rank_permno,
506                   case when coalesce(n.n_permno,0)>1 or
507                                  (coalesce(n.n_permno,0)=1 and n.n_permco ne 1)
508                        then 3
509                        when coalesce(n.n_permno,0)=1 then 1
510                        else 2 end as rank_source
511            from event_base0 as e
512            left join link_form_n as n
513              on e.gvkey=n.gvkey and e.form_date=n.form_date
514            left join link_form as l
515              on e.gvkey=l.gvkey and e.form_date=l.form_date
516            left join size_rank as f
517              on f.permno=case when coalesce(n.n_permno,0)=1 and n.n_permco=1
518                               then l.permno
519                               when coalesce(n.n_permno,0)=0 then e.permno_fye
520                               else . end
521             and f.return_year=e.return_year;
