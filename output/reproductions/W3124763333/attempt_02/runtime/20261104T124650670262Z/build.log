695        /* Return the monthly CRSP security series, include delisting proceeds, and
696           hold valid delisting proceeds as zero-return cash for remaining months. */
697        data window_returns;
698            set window_returns0;
699            ret_total=.;
700            entry_ym=year(start_month)*100+month(start_month);
701            if not missing(terminal_delist_ym) and terminal_delist_ym<entry_ym then ret_total=.;
702            else if n_delist_rows>1 then ret_total=.;
703            else if n_delist_rows=1 then do;
704                if not missing(dlret) and dlret>=-1 then do;
705                    if not missing(ret_raw) and ret_raw>=-1 then
706                        ret_total=(1+ret_raw)*(1+dlret)-1;
707                    else ret_total=dlret;
708                end;
709            end;
710            else if ret_ym=terminal_delist_ym then do;
711                if not missing(terminal_dlret) and terminal_dlret>=-1 then do;
712                    if not missing(ret_raw) and ret_raw>=-1 then
713                        ret_total=(1+ret_raw)*(1+terminal_dlret)-1;
714                    else ret_total=terminal_dlret;
715                end;
716            end;
717            else if not missing(ret_raw) and ret_raw>=-1 then ret_total=ret_raw;
718            else if not missing(terminal_delist_ym) and
719                    terminal_delist_ym<ret_ym and not missing(terminal_dlret) and
720                    terminal_dlret>=-1
721                then ret_total=0;
722            stock_valid=not missing(ret_total) and ret_total>=-1;
723            stock_zero=(stock_valid and ret_total=-1);
724            if stock_valid and ret_total>-1 then stock_log=log(1+ret_total);
725            else stock_log=.;
726        run;

