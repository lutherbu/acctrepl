469        /* Assign each linked firm-year to the benchmark decile active for the first
470           holding month.  Use the date-valid formation link where unique; when there
471           is no formation-date link, fall back to the date-valid fiscal-year link. */
472        proc sql;
473            create table event_base0 as
474            select a.*, f.permno as permno_fye, f.permco as permco_fye
475            from acct_panel as a inner join link_fye as f
476              on a.gvkey=f.gvkey and a.datadate=f.datadate
477            where a.acct_complete=1;
