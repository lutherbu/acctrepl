182        
183        data acct_panel;
184            set acct_fx;
185            length basis_current basis_lead $6;
186            format datadate datadate_prev datadate_next date9.;
187            has_nonzero_ob=(not missing(ob) and ob ne 0);
188            adjacent_dates_ok=(not missing(datadate_prev) and not missing(datadate_next)
189                               and datadate_prev<datadate and datadate<datadate_next);
190            current_codes_known=(not missing(curcd_prev) and not missing(curcd));
191            lead_codes_known=(not missing(curcd) and not missing(curcd_next));
192            same_current_currency=(current_codes_known and curcd_prev=curcd);
193            same_lead_currency=(lead_codes_known and curcd=curcd_next);
194            mixed_current_currency=(current_codes_known and not same_current_currency);
195            mixed_lead_currency=(lead_codes_known and not same_lead_currency);
196            current_inputs_complete=(has_nonzero_ob and adjacent_dates_ok and
197                                     nmiss(at_prev,at,ib,ob)=0);
198            lead_inputs_complete=(adjacent_dates_ok and nmiss(at,at_next,ib_next)=0);
199            fx_current_complete=(nmiss(fx_at_prev,fx_at_t,fx_flow_t)=0);
200            fx_lead_complete=(nmiss(fx_at_t,fx_at_next,fx_flow_next)=0);
201            avg_at_t=.; avg_at_next=.; earn_t=.; earn_lead=.; bklg=.;
202            basis_current=''; basis_lead='';
203            if current_inputs_complete and same_current_currency then do;
204                avg_at_t=(at_prev+at)/2;
205                if avg_at_t ne 0 then do;
206                    earn_t=ib/avg_at_t;
207                    bklg=ob/avg_at_t;
208                end;
209                basis_current='native';
210            end;
211            else if current_inputs_complete and mixed_current_currency and fx_current_complete then do;
212                at_prev_usd=at_prev*fx_at_prev;
213                at_t_usd=at*fx_at_t;
214                ib_t_usd=ib*fx_flow_t;
215                ob_t_usd=ob*fx_at_t;
8                                                          The SAS System                   Wednesday, November  4, 2026 08:46:00 PM

216                avg_at_t=(at_prev_usd+at_t_usd)/2;
