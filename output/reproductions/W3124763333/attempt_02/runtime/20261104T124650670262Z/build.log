130        /* Fiscal-year t earnings and backlog use the t-1/t asset average;
131           EARN(t+1) uses its own t/t+1 average. */
132        proc sql;
133            create table acct_join as
134            select t.gvkey, t.datadate, t.fyear, t.ib, t.at, t.ob, t.curcd,
135                   p.datadate as datadate_prev, p.at as at_prev, p.curcd as curcd_prev,
136                   n.datadate as datadate_next, n.ib as ib_next, n.at as at_next,
137                   n.curcd as curcd_next
138            from funda as t
139            left join funda as p
140              on t.gvkey=p.gvkey and p.fyear=t.fyear-1
141            left join funda as n
142              on t.gvkey=n.gvkey and n.fyear=t.fyear+1
143            where t.fyear>=1981 and t.fyear<=1999;
NOTE: Table WORK.ACCT_JOIN created, with 192760 rows and 14 columns.

