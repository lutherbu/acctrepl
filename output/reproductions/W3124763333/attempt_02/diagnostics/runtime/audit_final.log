154        
155        /* Check whether an annual first-cap fallback is observed before the first
156           event-return month.  The source guide explicitly uses first-year cap for
157           midyear entrants; this audit measures its timing relative to these events. */
158        data mcap_obs;
159            set crspstk.msf(keep=permno date prc shrout
160                            where=(date>='01JAN1980'd and date<='31DEC2000'd));
161            if not missing(prc) and not missing(shrout) and shrout>0 then
162                mcap=abs(prc)*shrout;
163            else mcap=.;
164            if mcap<=0 then mcap=.;
165            if missing(mcap) then delete;
166            calyr=year(date);
167        run;

