193        /* Check whether an annual first-cap fallback is observed before the first
194           event-return month.  The source guide explicitly uses first-year cap for
195           midyear entrants; this audit measures its timing relative to these events. */
196        data mcap_obs;
197            set crspstk.msf(keep=permno date prc shrout
198                            where=(date>='01JAN1980'd and date<='31DEC2000'd));
199            if not missing(prc) and not missing(shrout) and shrout>0 then
200                mcap=abs(prc)*shrout;
201            else mcap=.;
202            if mcap<=0 then mcap=.;
203            if missing(mcap) then delete;
204            calyr=year(date);
205        run;

