103        data work.currency_periods;
104            merge work.raw(in=current_row)
105                  work.prior_period(in=prior_row);
106            by gvkey fyear;
107            if current_row and fyear >= 1986 and fyear <= 2000;
108            has_prior_row = prior_row;
109            curcd_same_as_prior = 0;
110            if has_prior_row and not missing(curcd) and not missing(curcd_prior)
111               and curcd = curcd_prior then curcd_same_as_prior = 1;
112            avg_at_period = .;
113            if curcd_same_as_prior and has_prior_row and nmiss(at, at_prior)=0 then do;
114                avg_at_period = (at + at_prior) / 2;
115                if avg_at_period <= 0 then avg_at_period = .;
116            end;
117            if not missing(avg_at_period) then do;
118                cfo_scaled_period = oancf / avg_at_period;
119                if nmiss(recch, invch, apalch, txach, aoloch)=0 then do;
120                    d_wc_period = -(recch + invch + apalch + txach + aoloch);
121                    earn_scaled_period = (oancf + d_wc_period) / avg_at_period;
122                end;
123                else do;
124                    d_wc_period = .;
125                    earn_scaled_period = .;
126                end;
127            end;
128            else do;
129                cfo_scaled_period = .;
130                d_wc_period = .;
131                earn_scaled_period = .;
132            end;
