311        data work.segnorm(keep=gvkey datadate stype sid geotp snms ias curcds isosrc srcdate
312                                datayr srcyr vintage_gap segment_row_id gcode geotp_up name_up
313                                loc_africa loc_asia loc_japan loc_middeast loc_europe loc_uk
