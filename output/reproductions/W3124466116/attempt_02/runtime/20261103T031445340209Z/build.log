318                                 token_broad token_aggregate token_unknown);
319            set work.seglatest;
320            length geotp_up $32 name_up $256 tok $128 token_canon $128 token_group $8;
321            segment_row_id=_n_;
322            geotp_up=upcase(compbl(strip(geotp)));
323            name_up=upcase(compbl(strip(snms)));
324            gcode=.;
325            if index(geotp_up,'TOTAL FOREIGN') gt 0 then gcode=1;
326            else if index(geotp_up,'NONDOMESTIC') gt 0 or
327                    index(geotp_up,'NON-DOMESTIC') gt 0 or
328                    index(geotp_up,'NON DOMESTIC') gt 0 then gcode=3;
329            else if geotp_up='DOMESTIC' then gcode=2;
330            else do;
331                geotp_num=input(strip(geotp),?? best32.);
332                if geotp_num in (1,2,3) then gcode=geotp_num;
333            end;
334            loc_africa=0; loc_asia=0; loc_japan=0; loc_middeast=0;
335            loc_europe=0; loc_uk=0; loc_france=0; loc_germany=0;
336            loc_oceania=0; loc_samerica=0; loc_canada=0; loc_mexico=0;
337            row_unknown=0; row_aggregate=0; row_scope_gap=0; loc_bad=0;
338            broad_europe=0; broad_asia=0; broad_namerica=0;
339            if gcode=3 then do;
