687        data annual_screen;
688            set annual_with_rates;
689            length flow_currency $3 classifier_currency_basis $24;
690            flow_currency = upcase(strip(curcd));
691            /* Price currency is supported only by the verified HIID's dated daily or
692               monthly security record; annual accounting CURCD is not a price proxy. */
693            if flow_currency='USD' then fx_flow_usd=1;
694            else if gbp_to_flow_currency_12m > 0 and gbp_to_usd_flow_12m > 0 and
695                    flow_rate_conflict ne 1
696                then fx_flow_usd=gbp_to_usd_flow_12m / gbp_to_flow_currency_12m;
697            else fx_flow_usd=.;
698            if price_currency='USD' then fx_price_usd=1;
699            else if price_currency_source='HIID_daily_CURCDD' and
700                    gbp_to_price_currency_daily > 0 and gbp_to_usd_price_daily > 0 and
701                    price_rate_conflict ne 1
702                then fx_price_usd=gbp_to_usd_price_daily / gbp_to_price_currency_daily;
703            else fx_price_usd=.;
704        
705            prespc = pi - spi;
706            source_industry_excluded = (industry_screen_excluded=1);
707            industry_screen_unres = missing(industry_screen_excluded);
708            source_earnings_complete = (nmiss(ni,pi,spi)=0);
709            beginning_mve_available = (not missing(beg_csho) and beg_csho > 0 and
710                                       not missing(beg_prcc_f) and beg_prcc_f > 0 and
711                                       historical_issue_verified=1 and
712                                       not missing(price_currency));
713            annual_flow_currency_available = (not missing(flow_currency) and
714                                              not missing(fx_flow_usd));
715            flow_price_currency_mismatch =
716                (not missing(flow_currency) and not missing(price_currency) and
717                 flow_currency ne price_currency);
718            classifier_currency_available = (not missing(price_currency) and
719                (flow_currency=price_currency or not missing(fx_price_usd)));
720            source_population = (source_industry_excluded=0);
721            source_fields_available = (source_earnings_complete=1 and
722                                       beginning_mve_available=1 and
723                                       annual_flow_currency_available=1 and
724                                       classifier_currency_available=1);
725            if source_fields_available then do;
726                ni_usd = ni * fx_flow_usd;
727                pretax_usd = pi * fx_flow_usd;
728                special_usd = spi * fx_flow_usd;
729                prespc_usd = pretax_usd - special_usd;
730                mve0_local = beg_csho * beg_prcc_f;
