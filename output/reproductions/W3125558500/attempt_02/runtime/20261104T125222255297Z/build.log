667        proc sql;
668            create table annual_with_rates as
669            select a.*, fr.gbp_to_currency_12m as gbp_to_flow_currency_12m,
670                   fu.gbp_to_currency_12m as gbp_to_usd_flow_12m,
671                   pr.gbp_to_currency_daily as gbp_to_price_currency_daily,
672                   pu.gbp_to_currency_daily as gbp_to_usd_price_daily,
673                   fr.conflict12 as flow_rate_conflict,
674                   pr.rate_conflict as price_rate_conflict
675            from annual_price_check as a
676            left join fx_month_rates as fr
677              on a.flow_month_key=fr.fx_month_key
678                 and upcase(strip(a.curcd))=fr.currency
679            left join fx_month_rates as fu
                                                                    The SAS System

680              on a.flow_month_key=fu.fx_month_key and fu.currency='USD'
681            left join fx_daily_rates as pr
682              on a.price_fx_date=pr.datadate
683                 and upcase(strip(a.price_currency))=pr.currency
684            left join fx_daily_rates as pu
685              on a.price_fx_date=pu.datadate and pu.currency='USD';
