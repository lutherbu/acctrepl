67         /* For each firm-year, take the nearest actual prior-period date with FYEAR-1.
68            If a firm has duplicate prior-year records, the latest one before the current
69            date is the beginning-of-period candidate; no later year fills a gap. */
70         proc sql;
71             create table prior_dates as
72             select a.gvkey, a.datadate as current_datadate, a.fyear as current_fyear,
73                    max(p.datadate) as beg_datadate format=yymmdd10.
74             from funda as a left join funda as p
75               on a.gvkey=p.gvkey and p.fyear=a.fyear-1 and p.datadate<a.datadate
76             where a.fyear >= 1976 and a.fyear <= 2001
77             group by a.gvkey, a.datadate, a.fyear;
NOTE: Table WORK.PRIOR_DATES created, with 250528 rows and 4 columns.

78             create table annual_panel as
79             select a.*, p.fyear as beg_fyear, p.datadate as beg_datadate,
80                    p.csho as beg_csho, p.prcc_f as beg_prcc_f,
81                    p.curcd as beg_statement_currency,
82                    p.iid as beg_header_iid, p.hiid as beg_historical_iid,
                                                                    The SAS System

83                    (a.datadate-p.datadate) as fiscal_gap_days,
84                    . as beg_month_key
85             from funda as a
86             left join prior_dates as d
87               on a.gvkey=d.gvkey and a.datadate=d.current_datadate and a.fyear=d.current_fyear
88             left join funda as p
89               on a.gvkey=p.gvkey and p.fyear=a.fyear-1 and p.datadate=d.beg_datadate
90             where a.fyear >= 1976 and a.fyear <= 2001;
NOTE: Table WORK.ANNUAL_PANEL created, with 250528 rows and 28 columns.

