215            else if missing(target_size) or target_size<=0 then reason="NO_CURRENT_MARKET_EQUITY";
216            else if missing(target_bm) then reason="NO_CURRENT_BOOK_MARKET";
217            else do;
218                if target_size<=sz_q20 then sizegrp=1;
219                else if target_size<=sz_q40 then sizegrp=2;
220                else if target_size<=sz_q60 then sizegrp=3;
221                else if target_size<=sz_q80 then sizegrp=4;
222                else sizegrp=5;
223                if target_bm<=bm_q20 then bmgrp=1;
224                else if target_bm<=bm_q40 then bmgrp=2;
225                else if target_bm<=bm_q60 then bmgrp=3;
226                else if target_bm<=bm_q80 then bmgrp=4;
