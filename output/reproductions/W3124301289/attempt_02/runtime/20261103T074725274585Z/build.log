290            create table work.comp_fx0 as
291            select a.*, intnx("month",a.datadate,0,"beginning") as fx_flow_month format=date9.,
292                   case when upcase(strip(a.curcd))="USD" then 1
293                        else m.usd_factor end as fx_flow_factor,
294                   m.gbp_to_report as fx_flow_gbp_to_report,
295                   m.gbp_to_usd as fx_flow_gbp_to_usd
296            from work.comp_fx_daily as a
297            left join work.fx_mth_pair as m
