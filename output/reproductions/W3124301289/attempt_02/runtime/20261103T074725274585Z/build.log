61         /* Translate annual flows with the provider's rolling 12-month rates and
62            balance-sheet items with same-date daily rates. Xpressfeed's primary
63            currency is GBP, so USD-per-reporting-unit is (GBP->USD)/(GBP->CURCD).
64            Monthly rates begin in 1982; unsupported nonzero observations stay missing.
65            Daily rates use the latest same-date pair no more than seven days before
66            DATADATE, never a future quote. Daily quote types are retained per leg. */
67         data work.fx_mth_src;
68             set compfx.g_exrt_mth(keep=datadate fromcurm tocurm exrat12m);
69             if datadate < "01JAN1974"d or datadate > "31DEC2000"d then delete;
70             if upcase(strip(fromcurm)) ne "GBP" then delete;
71             if missing(tocurm) then delete;
72             fx_month=intnx("month",datadate,0,"beginning");
73             currency=upcase(strip(tocurm));
74             fx_value=exrat12m;
75             keep fx_month currency fx_value;
76             format fx_month date9.;
77         run;

