. forvalues h=1/3 {
  2.     preserve
  3.     keep if horizon==`h'
  4.     bysort fityear: gen byte raw_tag=(_n==1)
  5.     quietly count if raw_tag & !complete
  6.     local rawmiss=r(N)
  7.     display "EP horizon " `h' " raw first-row tags on incomplete observati
> ons=" `rawmiss'
  8.     drop raw_tag
  9.     keep if complete
 10.     asreg y $x, by(fityear)
 11.     bysort fityear: gen byte tag=(_n==1)
 12.     quietly count if tag & !complete
 13.     local postmiss=r(N)
 14.     display "EP horizon " `h' " tagged incomplete results after complete-c
> ase restriction=" `postmiss'
 15.     assert `postmiss'==0
 16.     count if tag
 17.     local ntag=r(N)
 18.     assert `ntag'==44
 19.     count if tag & !missing(_Nobs, _R2, _adjR2, _b_cons, _b_nege, _b_epx, 
> _b_epnegx)
 20.     local nvec=r(N)
 21.     assert `nvec'==44
 22.     list fityear n_cc rankok _Nobs _R2 _adjR2 if tag, noobs
 23.     foreach endpoint in 1969 2012 {
 24.         quietly count if tag & rankok & fityear==`endpoint'
 25.         local endpoint_rank=r(N)
 26.         if `endpoint_rank'==1 {
 27.             quietly summarize _b_cons if tag & fityear==`endpoint', meanon
> ly
 28.             local pcons=r(mean)
 29.             local nvector=r(N)
 30.             assert `nvector'==1
 31.             quietly summarize _b_nege if tag & fityear==`endpoint', meanon
> ly
 32.             local p_nege=r(mean)
 33.             quietly summarize _b_epx if tag & fityear==`endpoint', meanonl
> y
 34.             local p_epx=r(mean)
 35.             quietly summarize _b_epnegx if tag & fityear==`endpoint', mean
> only
 36.             local p_epnegx=r(mean)
 37.             quietly summarize _Nobs if tag & fityear==`endpoint', meanonly
 38.             local asregN=r(mean)
 39.             local natN=scalar(ep_nat_N_`h'_`endpoint')
 40.             local bdiff=max(abs(scalar(ep_nat_cons_`h'_`endpoint')-`pcons'
> ), abs(scalar(ep_nat_nege_`h'_`endpoint')-`p_nege'), abs(scalar(ep_nat_epx_`h
> '_`endpoint')-`p_epx'), abs(scalar(ep_nat_epnegx_`h'_`endpoint')-`p_epnegx'))
 41.             local ndiff=abs(`natN'-`asregN')
 42.             display "EP horizon " `h' " year " `endpoint' " native/asreg m
> ax coefficient difference=" %12.8g `bdiff' " N difference=" %9.0f `ndiff'
 43.         }
 44.         else {
 45.             display "EP horizon " `h' " year " `endpoint' " native compari
> son skipped: full-rank check failed"
 46.         }
 47.     }
 48.     count if tag & rankok
 49.     local nfullvec=r(N)
 50.     display "EP horizon " `h' " native full-rank years=" `nfullvec' " of 4
> 4 vectors"
 51.     keep if tag & rankok
 52.     count
 53.     local nfits=r(N)
 54.     assert `nfits'==44
 55.     display "EP qualifying complete-case asreg fits at horizon " `h' "=" `
> nfits'
 56.     quietly summarize _R2, meanonly
 57.     local meanr2=100*r(mean)
 58.     local r2fits=r(N)
 59.     assert `r2fits'==44
 60.     quietly summarize _adjR2, meanonly
 61.     local meanar2=100*r(mean)
 62.     local ar2fits=r(N)
 63.     assert `ar2fits'==44
 64.     quietly summarize _Nobs, meanonly
 65.     local meanrows=r(mean)
 66.     quietly summarize _Nobs
 67.     local minrows=r(min)
 68.     local maxrows=r(max)
 69.     display "EP horizon " `h' " mean annual N=" %9.1f `meanrows' " min=" %
> 9.0f `minrows' " max=" %9.0f `maxrows' " mean R2/AdjR2 percentages from 44 gr
> oups"
 70.     mean _b_cons _b_nege _b_epx _b_epnegx
 71.     estadd scalar r2=`meanr2', replace
 72.     estadd scalar r2_a=`meanar2', replace
 73.     est store h`h'
 74.     restore
 75. }
