. use "data/rolling_fit_panel/reg.dta", clear

. capture mkdir "tables"

. est clear

. isid gvkey avyear

. 
. global x "hvzat hvzdvc dd hvze nege hvzac"

. keep gvkey avyear hvzy1 hvzy2 hvzy3 $x

. label var hvzat "A: total assets (USD millions)"

. label var hvzdvc "D: dividends (USD millions)"

. label var dd "DD: positive dividend indicator"

. label var hvze "E: current earnings (USD millions)"

. label var nege "NegE: negative earnings indicator"

. label var hvzac "AC: accounting changes (USD millions)"

. forvalues h=1/3 {
  2.     preserve
  3.     local firstfit=1969
  4.     local winlo=`firstfit'-9-`h'
  5.     local winhi=2012-`h'
  6.     gen double y=hvzy`h'
  7.     label var y "Future earnings, h=`h' (USD millions)"
  8.     egen byte missct=rowmiss(y $x)
  9.     gen byte inunion=0
 10.     forvalues fit=`firstfit'/2012 {
 11.         replace inunion=1 if inrange(avyear,`fit'-9-`h',`fit'-`h')
 12.     }
 13.     keep if inunion & missct==0
 14.     isid gvkey avyear
 15.     count
 16.     local nunion=r(N)
 17.     display "HVZ horizon " `h' " complete-case window union: base AVYEAR "
>  `winlo' "-" `winhi' "; unique rows=" `nunion'
 18.     estpost tabstat y $x, statistics(n mean sd p1 p99) columns(statistics)
 19.     estadd scalar union_rows=`nunion', replace
 20.     est store desc_h`h'
 21.     restore
 22. }
