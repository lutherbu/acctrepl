. est clear

. 
. use "data/rolling_fit_panel/reg.dta", clear

. isid gvkey avyear

. global x "nege rix rinegx rib ritacc"

. keep gvkey avyear riy1 riy2 riy3 $x

. label var nege "NegE: negative earnings indicator"

. label var rix "E: current earnings per share (USD)"

. label var rinegx "NegE x E: interaction"

. label var rib "B: book value per share (USD)"

. label var ritacc "TACC: accruals per share (USD)"

. forvalues h=1/3 {
  2.     preserve
  3.     local firstfit=1969
  4.     if `h'==3 local firstfit=1970
  5.     local winlo=`firstfit'-9-`h'
  6.     local winhi=2012-`h'
  7.     gen double y=riy`h'
  8.     label var y "Future earnings per share, h=`h' (USD)"
  9.     egen byte missct=rowmiss(y $x)
 10.     gen byte inunion=0
 11.     forvalues fit=`firstfit'/2012 {
 12.         replace inunion=1 if inrange(avyear,`fit'-9-`h',`fit'-`h')
 13.     }
 14.     keep if inunion & missct==0
 15.     isid gvkey avyear
 16.     count
 17.     local nunion=r(N)
 18.     display "RI horizon " `h' " complete-case full-rank window union: base
>  AVYEAR " `winlo' "-" `winhi' "; unique rows=" `nunion'
 19.     estpost tabstat y $x, statistics(n mean sd p1 p99) columns(statistics)
 20.     estadd scalar union_rows=`nunion', replace
 21.     est store desc_h`h'
 22.     restore
 23. }
