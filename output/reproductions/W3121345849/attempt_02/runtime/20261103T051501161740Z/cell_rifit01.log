. forvalues h=1/3 {
  2.     preserve
  3.     keep if horizon==`h'
  4.     bysort fityear: gen byte raw_tag=(_n==1)
  5.     quietly count if raw_tag & !complete
  6.     local rawmiss=r(N)
  7.     display "RI horizon " `h' " raw first-row tags on incomplete observati
> ons=" `rawmiss'
  8.     drop raw_tag
  9.     keep if complete
 10.     asreg y $x, by(fityear)
 11.     bysort fityear: gen byte tag=(_n==1)
 12.     quietly count if tag & !complete
 13.     local postmiss=r(N)
 14.     display "RI horizon " `h' " tagged incomplete results after complete-c
> ase restriction=" `postmiss'
 15.     assert `postmiss'==0
 16.     count if tag
 17.     local ntag=r(N)
 18.     assert `ntag'==44
 19.     count if tag & !missing(_Nobs, _R2, _adjR2, _b_cons, _b_nege, _b_rix, 
> _b_rinegx, _b_rib, _b_ritacc)
 20.     local nvec=r(N)
 21.     assert `nvec'==44
 22.     list fityear n_cc rankok _Nobs _R2 _adjR2 if tag, noobs
 23.     foreach endpoint in 1969 2012 {
 24.         quietly count if tag & rankok & fityear==`endpoint'
 25.         local endpoint_rank=r(N)
 26.         if `endpoint_rank'==1 {
 27.             quietly summarize _b_cons if tag & fityear==`endpoint', meanon
> ly
 28.             local pcons=r(mean)
 29.             local nvector=r(N)
 30.             assert `nvector'==1
 31.             quietly summarize _b_nege if tag & fityear==`endpoint', meanon
> ly
 32.             local p_nege=r(mean)
 33.             quietly summarize _b_rix if tag & fityear==`endpoint', meanonl
> y
 34.             local p_rix=r(mean)
 35.             quietly summarize _b_rinegx if tag & fityear==`endpoint', mean
> only
 36.             local p_rinegx=r(mean)
 37.             quietly summarize _b_rib if tag & fityear==`endpoint', meanonl
> y
 38.             local p_rib=r(mean)
 39.             quietly summarize _b_ritacc if tag & fityear==`endpoint', mean
> only
 40.             local p_ritacc=r(mean)
 41.             quietly summarize _Nobs if tag & fityear==`endpoint', meanonly
 42.             local asregN=r(mean)
 43.             local natN=scalar(ri_nat_N_`h'_`endpoint')
 44.             local bdiff=max(abs(scalar(ri_nat_cons_`h'_`endpoint')-`pcons'
> ), abs(scalar(ri_nat_nege_`h'_`endpoint')-`p_nege'), abs(scalar(ri_nat_rix_`h
> '_`endpoint')-`p_rix'), abs(scalar(ri_nat_rinegx_`h'_`endpoint')-`p_rinegx'),
>  abs(scalar(ri_nat_rib_`h'_`endpoint')-`p_rib'), abs(scalar(ri_nat_ritacc_`h'
> _`endpoint')-`p_ritacc'))
 45.             local ndiff=abs(`natN'-`asregN')
 46.             display "RI horizon " `h' " year " `endpoint' " native/asreg m
> ax coefficient difference=" %12.8g `bdiff' " N difference=" %9.0f `ndiff'
 47.         }
 48.         else {
 49.             display "RI horizon " `h' " year " `endpoint' " native compari
> son skipped: full-rank check failed"
 50.         }
 51.     }
 52.     count if tag & rankok
 53.     local nfullvec=r(N)
 54.     display "RI horizon " `h' " native full-rank years=" `nfullvec' " of 4
> 4 vectors"
 55.     keep if tag & rankok
 56.     count
 57.     local nfits=r(N)
 58.     if `h'==3 {
 59.         assert `nfits'==43
 60.     }
 61.     else {
 62.         assert `nfits'==44
 63.     }
 64.     display "RI qualifying complete-case asreg fits at horizon " `h' "=" `
> nfits'
 65.     quietly summarize _R2, meanonly
 66.     local meanr2=100*r(mean)
 67.     local r2fits=r(N)
 68.     if `h'==3 {
 69.         assert `r2fits'==43
 70.     }
 71.     else {
 72.         assert `r2fits'==44
 73.     }
 74.     quietly summarize _adjR2, meanonly
 75.     local meanar2=100*r(mean)
 76.     local ar2fits=r(N)
 77.     if `h'==3 {
 78.         assert `ar2fits'==43
 79.     }
 80.     else {
 81.         assert `ar2fits'==44
 82.     }
 83.     quietly summarize _Nobs, meanonly
 84.     local meanrows=r(mean)
 85.     quietly summarize _Nobs
 86.     local minrows=r(min)
 87.     local maxrows=r(max)
 88.     display "RI horizon " `h' " mean annual N=" %9.1f `meanrows' " min=" %
> 9.0f `minrows' " max=" %9.0f `maxrows' " mean R2/AdjR2 percentages from " `nf
> its' " groups"
 89.     mean _b_cons _b_nege _b_rix _b_rinegx _b_rib _b_ritacc
 90.     estadd scalar r2=`meanr2', replace
 91.     estadd scalar r2_a=`meanar2', replace
 92.     est store h`h'
 93.     restore
 94. }
