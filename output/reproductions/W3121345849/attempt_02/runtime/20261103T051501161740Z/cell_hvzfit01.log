. forvalues h=1/3 {
  2.     preserve
  3.     keep if horizon==`h'
  4.     bysort fityear: gen byte raw_tag=(_n==1)
  5.     quietly count if raw_tag & !complete
  6.     local rawmiss=r(N)
  7.     display "HVZ horizon " `h' " raw first-row tags on incomplete observat
> ions=" `rawmiss'
  8.     drop raw_tag
  9.     keep if complete
 10.     asreg y $x, by(fityear)
 11.     bysort fityear: gen byte tag=(_n==1)
 12.     quietly count if tag & !complete
 13.     local postmiss=r(N)
 14.     display "HVZ horizon " `h' " tagged incomplete results after complete-
> case restriction=" `postmiss'
 15.     assert `postmiss'==0
 16.     count if tag
 17.     local ntag=r(N)
 18.     assert `ntag'==44
 19.     count if tag & !missing(_Nobs, _R2, _adjR2, _b_cons, _b_hvzat, _b_hvzd
> vc, _b_dd, _b_hvze, _b_nege, _b_hvzac)
 20.     local nvec=r(N)
 21.     assert `nvec'==44
 22.     list fityear n_cc rankok _Nobs _R2 _adjR2 if tag, noobs
 23.     foreach endpoint in 1969 2012 {
 24.         quietly count if tag & rankok & fityear==`endpoint'
 25.         local endpoint_rank=r(N)
 26.         if `endpoint_rank'==1 {
 27.             quietly summarize _b_cons if tag & fityear==`endpoint', meanon
> ly
 28.             local pcons=r(mean)
 29.             local nvector=r(N)
 30.             assert `nvector'==1
 31.             quietly summarize _b_hvzat if tag & fityear==`endpoint', meano
> nly
 32.             local p_hvzat=r(mean)
 33.             quietly summarize _b_hvzdvc if tag & fityear==`endpoint', mean
> only
 34.             local p_hvzdvc=r(mean)
 35.             quietly summarize _b_dd if tag & fityear==`endpoint', meanonly
 36.             local p_dd=r(mean)
 37.             quietly summarize _b_hvze if tag & fityear==`endpoint', meanon
> ly
 38.             local p_hvze=r(mean)
 39.             quietly summarize _b_nege if tag & fityear==`endpoint', meanon
> ly
 40.             local p_nege=r(mean)
 41.             quietly summarize _b_hvzac if tag & fityear==`endpoint', meano
> nly
 42.             local p_hvzac=r(mean)
 43.             quietly summarize _Nobs if tag & fityear==`endpoint', meanonly
 44.             local asregN=r(mean)
 45.             local natN=scalar(hvz_nat_N_`h'_`endpoint')
 46.             local bdiff=max(abs(scalar(hvz_nat_cons_`h'_`endpoint')-`pcons
> '), abs(scalar(hvz_nat_hvzat_`h'_`endpoint')-`p_hvzat'), abs(scalar(hvz_nat_h
> vzdvc_`h'_`endpoint')-`p_hvzdvc'), abs(scalar(hvz_nat_dd_`h'_`endpoint')-`p_d
> d'), abs(scalar(hvz_nat_hvze_`h'_`endpoint')-`p_hvze'), abs(scalar(hvz_nat_ne
> ge_`h'_`endpoint')-`p_nege'), abs(scalar(hvz_nat_hvzac_`h'_`endpoint')-`p_hvz
> ac'))
 47.             local ndiff=abs(`natN'-`asregN')
 48.             display "HVZ horizon " `h' " year " `endpoint' " native/asreg 
> max coefficient difference=" %12.8g `bdiff' " N difference=" %9.0f `ndiff'
 49.         }
 50.         else {
 51.             display "HVZ horizon " `h' " year " `endpoint' " native compar
> ison skipped: full-rank check failed"
 52.         }
 53.     }
 54.     count if tag & rankok
 55.     local nfullvec=r(N)
 56.     display "HVZ horizon " `h' " native full-rank years=" `nfullvec' " of 
> 44 vectors"
 57.     keep if tag & rankok
 58.     count
 59.     local nfits=r(N)
 60.     assert `nfits'==44
 61.     display "HVZ qualifying complete-case asreg fits at horizon " `h' "=" 
> `nfits'
 62.     quietly summarize _R2, meanonly
 63.     local meanr2=100*r(mean)
 64.     local r2fits=r(N)
 65.     assert `r2fits'==44
 66.     quietly summarize _adjR2, meanonly
 67.     local meanar2=100*r(mean)
 68.     local ar2fits=r(N)
 69.     assert `ar2fits'==44
 70.     quietly summarize _Nobs, meanonly
 71.     local meanrows=r(mean)
 72.     quietly summarize _Nobs
 73.     local minrows=r(min)
 74.     local maxrows=r(max)
 75.     display "HVZ horizon " `h' " mean annual N=" %9.1f `meanrows' " min=" 
> %9.0f `minrows' " max=" %9.0f `maxrows' " mean R2/AdjR2 percentages from 44 g
> roups"
 76.     mean _b_cons _b_hvzat _b_hvzdvc _b_dd _b_hvze _b_nege _b_hvzac
 77.     estadd scalar r2=`meanr2', replace
 78.     estadd scalar r2_a=`meanar2', replace
 79.     est store h`h'
 80.     restore
 81. }
