108                   a.ib, a.spi, a.at, a.dvc, a.csho, a.act, a.che, a.lct,
109                   a.dlc, a.txp, a.dp, a.ceq, a.lt, a.ivst, a.pstk,
110                   p.curcd as curcd_l, p.fxbs as fxbs_l,
111                   p.act as act_l, p.che as che_l, p.lct as lct_l,
112                   p.dlc as dlc_l, p.txp as txp_l,
113                   p.at as at_l, p.lt as lt_l, p.ivst as ivst_l,
114                   p.pstk as pstk_l,
115                   b1.ib as ib1, b1.spi as spi1, b1.fxflow as fxflow1,
116                   b2.ib as ib2, b2.spi as spi2, b2.fxflow as fxflow2,
117                   b3.ib as ib3, b3.spi as spi3, b3.fxflow as fxflow3
118            from fx1 as a
119            left join fx1 as p
120              on a.gvkey=p.gvkey and p.avyear=a.avyear-1
121            left join fx1 as b1
122              on a.gvkey=b1.gvkey and b1.avyear=a.avyear+1
123            left join fx1 as b2
124              on a.gvkey=b2.gvkey and b2.avyear=a.avyear+2
125            left join fx1 as b3
126              on a.gvkey=b3.gvkey and b3.avyear=a.avyear+3
127            where a.avyear>=1957 and a.avyear<=2011;
