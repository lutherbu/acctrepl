201        title "W3121345849 bounded missing-construct attribution by Table 1 horizon";
202        proc sql;
203            select model, h as horizon, count(*) as otherwise_eligible_union_rows,
204                   sum(cause="RAW_MISSING_ZERO") as explicit_raw_missing_zeros,
205                   sum(cause="FX_ONLY_ZERO") as fx_only_zero_fills,
206                   sum(cause in ("AC_CONVERTED","TACC_CONVERTED")) as construct_converted
