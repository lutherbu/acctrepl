130        data audit_base;
131            set ffeat;
132            ac_raw_ok=(n(act,che,lct,dlc,txp,dp,
133                         act_l,che_l,lct_l,dlc_l,txp_l)=11);
134            ac_fx_ok=0;
135            if ac_raw_ok then
136                ac_fx_ok=(not missing(fxbs) and fxbs>0 and
137                          not missing(fxbs_l) and fxbs_l>0 and
138                          not missing(fxflow) and fxflow>0);
139        
140            tacc_raw_ok=(n(at,che,lt,ivst,pstk,
141                           at_l,che_l,lt_l,ivst_l,pstk_l,csho)=11 and csho>0);
142            tacc_fx_ok=0;
143            if tacc_raw_ok then
144                tacc_fx_ok=(not missing(fxbs) and fxbs>0 and
145                            not missing(fxbs_l) and fxbs_l>0);
146        
147            hvz_base_ok=(not missing(at) and not missing(fxbs) and fxbs>0 and
148                         not missing(dvc) and not missing(fxflow) and fxflow>0 and
149                         not missing(ib) and not missing(spi));
150            ep_base_ok=(not missing(ib) and not missing(spi) and
151                        not missing(csho) and csho>0 and
152                        not missing(fxflow) and fxflow>0);
153            ri_base_ok=(ep_base_ok and not missing(ceq) and
154                        not missing(fxbs) and fxbs>0);
155        
156            array iblead[3] ib1 ib2 ib3;
157            array spilead[3] spi1 spi2 spi3;
158            array fxlead[3] fxflow1 fxflow2 fxflow3;
159            do h=1 to 3;
160                if h=1 then do;
161                    min_av=1959; max_av=2011;
162                end;
163                else if h=2 then do;
164                    min_av=1958; max_av=2010;
165                end;
166                else do;
167                    min_av=1957; max_av=2009;
168                end;
169                lead_ok=(not missing(iblead[h]) and not missing(spilead[h]) and
170                         not missing(fxlead[h]) and fxlead[h]>0);
171                if avyear>=min_av and avyear<=max_av and lead_ok then do;
172                    length model $3 cause $16;
173        
174                    if hvz_base_ok then do;
175                        model="HVZ";
176                        if not ac_raw_ok then cause="RAW_MISSING_ZERO";
177                        else if not ac_fx_ok then cause="FX_ONLY_ZERO";
178                        else cause="AC_CONVERTED";
179                        output;
180                    end;
181        
182                    if ep_base_ok then do;
183                        model="EP";
184                        cause="EP_ELIGIBLE";
