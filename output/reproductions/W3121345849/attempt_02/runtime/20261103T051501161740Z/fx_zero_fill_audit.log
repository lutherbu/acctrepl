190                        if not tacc_raw_ok then cause="RAW_MISSING_ZERO";
191                        else if not tacc_fx_ok then cause="FX_ONLY_ZERO";
192                        else cause="TACC_CONVERTED";
193                        output;
194                    end;
195                end;
196            end;
