444        proc sql;
445            create table analysis_all0 as
446            select o.offer_id, o.issue_date, o.offer_year, o.cusip6, o.ipo,
447                   g.gvkey, r.permno,
448                   f.n_forecasts, f.forecast_growth, f.n_outside_table3_range,
449                   gr.n_positive as n_growth_points,
450                   gr.n_currencies, gr.first_ok, gr.last_ok,
451                   gr.trend as realized_growth_slope,
452                   gr.realized_growth,
453                   ret.n_return_months, ret.n_stock, ret.n_market,
454                   ret.stock_buyhold, ret.market_buyhold, ret.abnormal_return,
455                   ret.stock_date_start, ret.stock_date_end
456            from offer_pool as o
457            left join event_gvkey as g on o.offer_id=g.offer_id
458            left join crsp_link as r on o.offer_id=r.offer_id
459            left join offer_forecast as f on o.offer_id=f.offer_id
460            left join growth_offer as gr on o.offer_id=gr.offer_id
461            left join return_summary as ret on o.offer_id=ret.offer_id;
