471            forecast_ok=(n_forecasts>0 and not missing(forecast_growth));
472            growth_ok=not missing(realized_growth);
473            return_ok=(n_return_months=60 and not missing(abnormal_return));
474            complete_sample=(comp_linked and crsp_linked and forecast_ok and
475                             growth_ok and return_ok);
476            forecast_error=realized_growth-forecast_growth;
477        run;

