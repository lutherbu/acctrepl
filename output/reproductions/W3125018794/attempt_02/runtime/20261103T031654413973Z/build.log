464        data analysis_all;
465            set analysis_all0;
466            if missing(n_forecasts) then n_forecasts=0;
467            if missing(n_growth_points) then n_growth_points=0;
468            if missing(n_return_months) then n_return_months=0;
469            comp_linked=not missing(gvkey);
