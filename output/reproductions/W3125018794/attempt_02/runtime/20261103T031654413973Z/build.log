397        data return_summary;
398            set ret_panel;
399            by offer_id;
400            retain n_months n_stock n_market miss_stock miss_market
401                   stock_product market_product stock_date_start stock_date_end;
402            if first.offer_id then do;
403                n_months=0;
404                n_stock=0;
405                n_market=0;
406                miss_stock=0;
407                miss_market=0;
408                stock_product=1;
409                market_product=1;
410                stock_date_start=.;
411                stock_date_end=.;
412            end;
413            n_months+1;
414            if not missing(stock_date) then do;
415                if missing(stock_date_start) then stock_date_start=stock_date;
416                stock_date_end=stock_date;
417            end;
418            if missing(stock_ret) then miss_stock+1;
The SAS System

419            else do;
420                n_stock+1;
421                stock_product=stock_product*(1+stock_ret);
422            end;
423            if missing(market_ret) then miss_market+1;
424            else do;
425                n_market+1;
426                market_product=market_product*(1+market_ret);
427            end;
428            if last.offer_id then do;
429                n_return_months=n_months;
430                stock_buyhold=stock_product-1;
431                market_buyhold=market_product-1;
432                abnormal_return=.;
433                if n_months=60 and n_stock=60 and n_market=60 and
434                   miss_stock=0 and miss_market=0 then
435                    abnormal_return=stock_buyhold-market_buyhold;
436                output;
437            end;
438            format stock_date_start stock_date_end yymmdd10.;
439            keep offer_id n_return_months n_stock n_market miss_stock miss_market
440                 stock_buyhold market_buyhold abnormal_return stock_date_start stock_date_end;
441        run;

