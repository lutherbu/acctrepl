209        /* Sales growth is a dollar change per share, not a percentage change.
210           Compustat can assign two DATADATEs to the same fiscal year/quarter when a
211           firm changes its year-end. Keep the t-4 fiscal-quarter candidate closest
212           to the same calendar date one year earlier; omit only unresolved ties. */
213        data work.qout_target;
214            set work.qout;
215            lag_target=intnx('year',datadate,-1,'same');
216            format lag_target date9.;
217        run;

