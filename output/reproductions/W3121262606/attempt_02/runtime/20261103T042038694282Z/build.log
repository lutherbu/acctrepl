75             end;
76             else if fyearq=prev_fyear and fqtr=prev_fqtr+1
77                  and not missing(curcdq) and curcdq=prev_curcd then do;
78                 if nmiss(oancfy, prev_oancfy)=0 then cfo_q=oancfy-prev_oancfy;
79                 if nmiss(capxy, prev_capxy)=0 then capex_q=capxy-prev_capxy;
80             end;
