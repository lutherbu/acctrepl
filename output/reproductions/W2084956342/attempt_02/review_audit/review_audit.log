58         data work.check;
59             set work.inputs;
60             miss9_p=missing(dltt_p); miss9_t=missing(dltt_t);
61             miss32_p=missing(ivao_p); miss32_t=missing(ivao_t);
62             miss34_p=missing(dlc_p); miss34_t=missing(dlc_t);
63             miss130_p=missing(pstk_p); miss130_t=missing(pstk_t);
64             miss193_p=missing(ivst_p); miss193_t=missing(ivst_t);
65             dltt_p0=coalesce(dltt_p,0); dltt_t0=coalesce(dltt_t,0);
66             ivao_p0=coalesce(ivao_p,0); ivao_t0=coalesce(ivao_t,0);
67             dlc_p0=coalesce(dlc_p,0); dlc_t0=coalesce(dlc_t,0);
68             pstk_p0=coalesce(pstk_p,0); pstk_t0=coalesce(pstk_t,0);
69             ivst_p0=coalesce(ivst_p,0); ivst_t0=coalesce(ivst_t,0);
70         
71             required_missing=(nmiss(che_p,che_t,act_p,act_t,lct_p,lct_t,
72                                     at_p,at_t,lt_p,lt_t,sale_p,sale_t,oiadp_t,oiadp_n)>0);
73             date_order=(not missing(date_p) and not missing(date_t) and not missing(date_n)
74                         and date_p<date_t and date_t<date_n);
75             currency_ok=(not missing(curcd_p) and not missing(curcd_t) and not missing(curcd_n)
76                          and strip(curcd_p)=strip(curcd_t) and strip(curcd_t)=strip(curcd_n)
77                          and strip(curcd_t)=strip(hand_curcd));
78             avg_at_t=(at_p+at_t)/2;
79             avg_at_n=(at_t+at_n)/2;
80             denom_t_zero=(avg_at_t=0);
81             denom_n_zero=(avg_at_n=0);
82             denom_t_nonpositive=(avg_at_t<=0);
83             denom_n_nonpositive=(avg_at_n<=0);
84             if not missing(avg_at_t) and not missing(avg_at_n)
85                and avg_at_t ne 0 and avg_at_n ne 0 then do;
86                 coa_p=act_p-che_p; coa_t=act_t-che_t;
87                 col_p=lct_p-dlc_p0; col_t=lct_t-dlc_t0;
88                 ncoa_p=at_p-act_p-ivao_p0; ncoa_t=at_t-act_t-ivao_t0;
89                 ncol_p=lt_p-lct_p-dltt_p0; ncol_t=lt_t-lct_t-dltt_t0;
90                 finl_p=dltt_p0+dlc_p0+pstk_p0; finl_t=dltt_t0+dlc_t0+pstk_t0;
91                 roa_t_raw=oiadp_t/avg_at_t;
92                 roa_tp1_raw=oiadp_n/avg_at_n;
93                 dcoa_raw=(coa_t-coa_p)/avg_at_t;
94                 ndcol_raw=-(col_t-col_p)/avg_at_t;
95                 dncoa_raw=(ncoa_t-ncoa_p)/avg_at_t;
96                 ndncol_raw=-(ncol_t-ncol_p)/avg_at_t;
97                 dsti_raw=(ivst_t0-ivst_p0)/avg_at_t;
98                 dlti_raw=(ivao_t0-ivao_p0)/avg_at_t;
99                 ndfinl_raw=-(finl_t-finl_p)/avg_at_t;
100            end;
101        
102            mismatch_roa_tp1=(not missing(roa_tp1_raw) and
103                              abs(hand_roa_tp1-max(-1,min(1,roa_tp1_raw)))>1e-12);
104            mismatch_roa_t=(not missing(roa_t_raw) and
105                            abs(hand_roa_t-max(-1,min(1,roa_t_raw)))>1e-12);
106            mismatch_dcoa=(not missing(dcoa_raw) and abs(hand_dcoa-max(-1,min(1,dcoa_raw)))>1e-12);
107            mismatch_ndcol=(not missing(ndcol_raw) and abs(hand_ndcol-max(-1,min(1,ndcol_raw)))>1e-12);
108            mismatch_dncoa=(not missing(dncoa_raw) and abs(hand_dncoa-max(-1,min(1,dncoa_raw)))>1e-12);
109            mismatch_ndncol=(not missing(ndncol_raw) and abs(hand_ndncol-max(-1,min(1,ndncol_raw)))>1e-12);
110            mismatch_dsti=(not missing(dsti_raw) and abs(hand_dsti-max(-1,min(1,dsti_raw)))>1e-12);
111            mismatch_dlti=(not missing(dlti_raw) and abs(hand_dlti-max(-1,min(1,dlti_raw)))>1e-12);
112            mismatch_ndfinl=(not missing(ndfinl_raw) and abs(hand_ndfinl-max(-1,min(1,ndfinl_raw)))>1e-12);
113        run;

