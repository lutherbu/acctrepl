51               on s.gvkey=p.gvkey and p.fyear=s.year-1 and p.datadate=s.date_p
52             left join work.annual as t
53               on s.gvkey=t.gvkey and t.fyear=s.year and t.datadate=s.date_t
54             left join work.annual as n
55               on s.gvkey=n.gvkey and n.fyear=s.year+1 and n.datadate=s.date_n;
