240            funda_valid=(funda_sic>=100 and funda_sic<=9999);
241            crsp_valid=(crsp_sic>=100 and crsp_sic<=9999);
242            both_valid=(funda_valid and crsp_valid);
243            exact_disagree=(both_valid and funda_sic ne crsp_sic);
244            same_2digit=(both_valid and floor(funda_sic/100)=floor(crsp_sic/100));
245            diff_4_same_2=(exact_disagree and same_2digit);
246            diff_2=(exact_disagree and not same_2digit);
247            funda_fin=(funda_valid and funda_sic>=6000 and funda_sic<=6999);
248            crsp_fin=(crsp_valid and crsp_sic>=6000 and crsp_sic<=6999);
