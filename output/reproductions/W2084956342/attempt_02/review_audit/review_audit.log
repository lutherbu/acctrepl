36                    s.dcoa as hand_dcoa,s.ndcol as hand_ndcol,s.dncoa as hand_dncoa,
37                    s.ndncol as hand_ndncol,s.dsti as hand_dsti,s.dlti as hand_dlti,
38                    s.ndfinl as hand_ndfinl,
39                    p.curcd as curcd_p,t.curcd as curcd_t,n.curcd as curcd_n,
40                    p.che as che_p,t.che as che_t,p.act as act_p,t.act as act_t,
41                    p.lct as lct_p,t.lct as lct_t,p.at as at_p,t.at as at_t,n.at as at_n,
42                    p.lt as lt_p,t.lt as lt_t,p.sale as sale_p,t.sale as sale_t,
43                    t.oiadp as oiadp_t,n.oiadp as oiadp_n,
44                    p.dltt as dltt_p,t.dltt as dltt_t,
45                    p.ivao as ivao_p,t.ivao as ivao_t,
46                    p.dlc as dlc_p,t.dlc as dlc_t,
47                    p.pstk as pstk_p,t.pstk as pstk_t,
48                    p.ivst as ivst_p,t.ivst as ivst_t
49             from work.sample as s
