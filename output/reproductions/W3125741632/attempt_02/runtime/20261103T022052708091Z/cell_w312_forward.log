. encode gvkey, gen(firm_id)

. xtset firm_id fyear

Panel variable: firm_id (unbalanced)
 Time variable: fyear, 1972 to 1999, but with gaps
         Delta: 1 unit

. label variable mtbrank "MTB quintile rank (1–5)"

. est clear

. forvalues i=1/3 {
  2.     local y : word `i' of $forward_y
  3.     local d : word `i' of $forward_d
  4.     local r : word `i' of $forward_r
  5.     capture drop dr ret mdr mr rdr mrdr
  6.     generate double dr = `d'
  7.     generate double ret = `r'
  8.     generate double mdr = mtbrank*dr
  9.     generate double mr = mtbrank*ret
 10.     generate double rdr = ret*dr
 11.     generate double mrdr = mtbrank*ret*dr
 12.     label variable dr "Negative-return indicator"
 13.     label variable mdr "MTB rank × DR"
 14.     label variable ret "Buy-and-hold return"
 15.     label variable mr "MTB rank × return"
 16.     label variable rdr "Return × DR"
 17.     label variable mrdr "MTB rank × return × DR"
 18.     local fullrank = 0
 19.     forvalues yr=1972/1999 {
 20.         regress `y' mtbrank dr mdr ret mr rdr mrdr if fyear==`yr'
 21.         display as text "ANNUAL_RANK forward_k`i' year=`yr' " as result "N
> =" %8.0f e(N) " rank=" %2.0f e(rank) " residual_df=" %8.0f e(df_r)
 22.         if e(rank)==8 local ++fullrank
 23.     }
 24.     display as text "FULL_RANK_YEARS forward_k`i'=" as result %2.0f `fullr
> ank'
 25.     xtfmb `y' mtbrank dr mdr ret mr rdr mrdr
 26.     display as text "FMB forward_k`i' total_N=" as result %9.0f e(N) " yea
> rs=" %2.0f e(N_g) " average_annual_R2_decimal=" %7.4f e(r2)
 27.     lincom mrdr
 28.     lincom mr + mrdr
 29.     est store f`i'
 30. }

