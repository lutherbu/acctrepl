. global backward_y "y_b0 y_b1 y_b2 y_b3 y_b4"

. global backward_d "d_b0 d_b1 d_b2 d_b3 d_b4"

. global backward_r "r_b0 r_b1 r_b2 r_b3 r_b4"

. use "data/basu_mtb/reg.dta", clear

. encode gvkey, gen(firm_id)

. xtset firm_id fyear

Panel variable: firm_id (unbalanced)
 Time variable: fyear, 1972 to 1999, but with gaps
         Delta: 1 unit

. label variable mtbrank "MTB quintile rank (1–5)"

. est clear

. forvalues i=0/4 {
  2.     local p = `i'+1
  3.     local y : word `p' of $backward_y
  4.     local d : word `p' of $backward_d
  5.     local r : word `p' of $backward_r
  6.     capture drop dr ret mdr mr rdr mrdr
  7.     generate double dr = `d'
  8.     generate double ret = `r'
  9.     generate double mdr = mtbrank*dr
 10.     generate double mr = mtbrank*ret
 11.     generate double rdr = ret*dr
 12.     generate double mrdr = mtbrank*ret*dr
 13.     label variable dr "Negative-return indicator"
 14.     label variable mdr "MTB rank × DR"
 15.     label variable ret "Buy-and-hold return"
 16.     label variable mr "MTB rank × return"
 17.     label variable rdr "Return × DR"
 18.     label variable mrdr "MTB rank × return × DR"
 19.     local fullrank = 0
 20.     forvalues yr=1972/1999 {
 21.         regress `y' mtbrank dr mdr ret mr rdr mrdr if fyear==`yr'
 22.         display as text "ANNUAL_RANK historical_j`i' year=`yr' " as result
>  "N=" %8.0f e(N) " rank=" %2.0f e(rank) " residual_df=" %8.0f e(df_r)
 23.         if e(rank)==8 local ++fullrank
 24.     }
 25.     display as text "FULL_RANK_YEARS historical_j`i'=" as result %2.0f `fu
> llrank'
 26.     xtfmb `y' mtbrank dr mdr ret mr rdr mrdr
 27.     display as text "FMB historical_j`i' total_N=" as result %9.0f e(N) " 
> years=" %2.0f e(N_g) " average_annual_R2_decimal=" %7.4f e(r2)
 28.     lincom mrdr
 29.     lincom mr + mrdr
 30.     est store b`i'
 31. }

