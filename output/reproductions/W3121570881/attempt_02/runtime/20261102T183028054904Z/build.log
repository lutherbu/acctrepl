186        /* Supporting modified Jones/Kothari fits: annual 3-SD winsorization, then
187           separate no-intercept cross-sections by historical two-digit SIC and year. */
188        data work.fit_raw;
189          set work.hist;
190          if fyear < 1988 or fyear > 2000 then delete;
191          if missing(at_l1_usd) or at_l1_usd <= 0 then delete;
192          if nmiss(ib_usd,cfo_usd,sale_usd,sale_l1_usd,ppe_usd)=0 then do;
193            tacc=(ib_usd-cfo_usd)/at_l1_usd;
194            inv_at=1/at_l1_usd;
195            dsale=(sale_usd-sale_l1_usd)/at_l1_usd;
196            ppe=ppe_usd/at_l1_usd;
197            roa=ib_usd/at_l1_usd;
8                                                          The SAS System                     Tuesday, November  3, 2026 02:30:00 AM

198          end;
199          else delete;
200        run;

