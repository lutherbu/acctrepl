452        data work.ret_year;
453          set work.ret_long;
454          by gvkey fyear;
455          retain gross nret nmiss nobs firstdate lastdate;
456          if first.fyear then do;
457            gross=1; nret=0; nmiss=0; nobs=0; firstdate=.; lastdate=.;
458          end;
459          nobs+1;
460          if nobs=1 then firstdate=date;
461          lastdate=date;
462          if missing(retx) then nmiss+1;
463          else do; gross=gross*(1+retx); nret+1; end;
464          if last.fyear then do;
465            if nret>0 and nmiss=0 then ret_year=gross-1;
466            else ret_year=.;
467            output;
468          end;
469          keep gvkey fyear ret_year nret nmiss nobs firstdate lastdate;
470        run;

