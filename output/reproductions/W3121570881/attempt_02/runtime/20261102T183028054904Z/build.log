100          create table work.funda_rate as
101          select a.*,
102                 case
103                   when upcase(strip(a.curcd))='USD' then 1
104                   when upcase(strip(a.curcd))='GBP' then u.rate_usd
105                   when not missing(c.rate) and c.rate>0 and not missing(u.rate_usd) and u.rate_usd>0
106                     then u.rate_usd/c.rate
107                   else . end as fx_flow,
108                 case
109                   when upcase(strip(a.curcd))='USD' then 1
110                   when upcase(strip(a.curcd))='GBP' then v.rate_usd
111                   when not missing(d.rate) and d.rate>0 and not missing(v.rate_usd) and v.rate_usd>0
112                     then v.rate_usd/d.rate
113                   else . end as fx_bs
114          from work.funda_raw as a
115          left join work.fx_mth_u as c
116            on a.datadate=c.datadate and upcase(strip(a.curcd))=c.tocurm
117          left join work.fx_mth_usd as u
118            on a.datadate=u.datadate
119          left join work.fx_dly_u as d
120            on a.datadate=d.datadate and upcase(strip(a.curcd))=d.tocurd
121          left join work.fx_dly_usd as v
122            on a.datadate=v.datadate;
