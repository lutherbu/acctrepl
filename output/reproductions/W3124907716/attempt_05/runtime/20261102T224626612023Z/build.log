86         proc sql;
87           create table work.price_month0 as
88           select a.gvkey, a.iid as header_iid length=3, a.hiid, a.datadate,
89                  a.fyear, a.pyear, a.pmon, a.prcc_f, a.price_tol, a.curcd,
90                  count(p.datadate) as mth_rows,
91                  count(distinct p.datadate) as mth_dates,
92                  count(distinct p.curcdm) as mth_ccy_n,
93                  min(upcase(strip(p.curcdm))) as mth_cur length=3,
94                  min(p.datadate) as mth_date format=date9.,
95                  min(case when not missing(p.datadate) and not missing(p.prccm)
96                                and not missing(a.prcc_f)
97                           then abs(p.prccm-a.prcc_f) else . end) as mth_gap
98           from work.price_key as a
99           left join work.sec_mthprice as p
100            on not missing(a.hiid) and a.gvkey=p.gvkey and a.hiid=p.iid
101           and a.pyear=year(p.datadate) and a.pmon=month(p.datadate)
102           and p.datadate<=a.datadate
103          group by a.gvkey, a.iid, a.hiid, a.datadate, a.fyear, a.pyear, a.pmon,
104                   a.prcc_f, a.price_tol, a.curcd;
NOTE: Table WORK.PRICE_MONTH0 created, with 53605 rows and 16 columns.

105          create table work.price_month_marker as
106          select a.*,coalesce(m.marker_rows,0) as marker_rows,
107                 coalesce(m.marker_code_n,0) as marker_code_n,m.marker_code
108          from work.price_month0 as a
109          left join
110            (select gvkey,iid,datadate,count(*) as marker_rows,
111                    count(distinct primiss) as marker_code_n,
112                    min(primiss) as marker_code length=3
113             from work.sec_marker group by gvkey,iid,datadate) as m
114            on a.gvkey=m.gvkey and a.hiid=m.iid and a.mth_date=m.datadate;
