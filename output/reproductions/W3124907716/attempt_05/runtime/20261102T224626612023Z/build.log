54         
55         /* PRCC_F is a historical primary-issue price. FUNDA.HIID is the historical
56            primary issue identifier; FUNDA.IID is only the current header identifier.
57            A same-month HIID monthly quote with matching PRCC_F and known currency is
58            corroborated by a dated P marker when present. Missing markers are not
59            treated as contradictions. Unresolved routes may use a same-HIID daily
60            quote only on the annual date or across a documented market closure of at
61            most seven calendar days, with a matching PRCCD and unique known currency. */
62         data work.price_key;
63           set work.compbase(keep=gvkey iid hiid datadate fyear prcc_f curcd);
64           where fyear between 1993 and 1999;
65           pyear=year(datadate);
66           pmon=month(datadate);
67           if not missing(prcc_f) then price_tol=max(1e-8,abs(prcc_f)*1e-6);
68         run;

