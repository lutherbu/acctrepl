13         /* Current-vintage annual Compustat input. The fiscal-year envelope retains
14            t-2 and t+1 history for the assigned forward-looking model. */
15         proc sql;
16           create table work.comp_src as
17           select gvkey, iid, hiid, datadate, fyear, fic, curcd, sich, indfmt, consol, popsrc, datafmt,
18                  at, sale, ppegt, oancf, xidoc, txdi, ibc, ni, recch, prcc_f, csho
19           from comp.funda
20           where fyear between 1992 and 2001
21             and fic = 'USA'
22             and indfmt = 'INDL'
23             and consol = 'C'
24             and popsrc = 'D'
25             and datafmt = 'STD'
26             and not missing(sich)
27             and not (sich between 4900 and 4999)
28             and not (sich between 6000 and 6099)
29             and sich not in (6726, 6792, 6795, 6798, 6799)
30           order by gvkey, fyear, datadate;
