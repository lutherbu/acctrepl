492          at_l1_cur=.; sale_l1_cur=.; ni_l1_cur=.;
493          cfo_l1_cur=.; at_l2_cur=.; sale_f1_cur=.;
494          prcc_f_l1_cur=.; mve_l1=.;
495          if not missing(curcd) and not missing(curcd_l1) then do;
496            if curcd=curcd_l1 then do;
497              at_l1_cur=at_l1; sale_l1_cur=sale_l1; ni_l1_cur=ni_l1;
498              cfo_l1_cur=oancf_l1-xidoc_l1;
499            end;
500            else do;
501              if not missing(fx_dly_l1) then at_l1_cur=at_l1*fx_dly_l1;
502              if not missing(fx_mth_l1) then do;
22                                                         The SAS System                     Tuesday, November  3, 2026 06:46:00 AM

503                sale_l1_cur=sale_l1*fx_mth_l1;
504                ni_l1_cur=ni_l1*fx_mth_l1;
505                cfo_l1_cur=(oancf_l1-xidoc_l1)*fx_mth_l1;
506              end;
507            end;
508          end;
509          if not missing(curcd_l1) and not missing(curcd_l2) then do;
510            if curcd_l1=curcd_l2 then at_l2_cur=at_l2;
511            else if not missing(fx_dly_l2) then at_l2_cur=at_l2*fx_dly_l2;
512          end;
513          if not missing(curcd) and not missing(curcd_f1) then do;
514            if curcd=curcd_f1 then sale_f1_cur=sale_f1;
515            else if not missing(fx_mth_f1) then sale_f1_cur=sale_f1*fx_mth_f1;
516          end;
517          if not missing(curcd) and not missing(price_cur_l1) and price_cur_ok=1 then do;
518            if curcd=price_cur_l1 then prcc_f_l1_cur=prcc_f_l1;
519            else if not missing(fx_dly_px) then prcc_f_l1_cur=prcc_f_l1*fx_dly_px;
520          end;
521          if not missing(prcc_f_l1_cur) then mve_l1=csho_l1*prcc_f_l1_cur;
522          if at_l1_cur > 0 then do;
523            dte = txdi / at_l1_cur;
524            tacc = (ibc - (oancf - xidoc)) / at_l1_cur;
525            cfo = (oancf - xidoc) / at_l1_cur;
526            dcfo = ((oancf - xidoc) - cfo_l1_cur) / at_l1_cur;
527            dsales = (sale - sale_l1_cur) / at_l1_cur;
528            ppe = ppegt / at_l1_cur;
529            /* RECCH is cash-flow-signed: reverse its decrease/(increase) sign. */
530            delta_ar = -recch / at_l1_cur;
531          end;
532          if at_l2_cur > 0 and nmiss(ibc_l1, oancf_l1, xidoc_l1) = 0 then
533            lag_tacc = (ibc_l1 - (oancf_l1 - xidoc_l1)) / at_l2_cur;
534          if sale > 0 and not missing(sale_f1_cur) then
535            grsales = (sale_f1_cur-sale) / sale;
536          /* A25 is CSHO and A199 PRCC_F; align the security-price currency with
537             current NI using the matched provider price date before forming market value. */
538          if mve_l1 > 0 and not missing(ni) then scaled_level = ni / mve_l1;
539          if mve_l1 > 0 and not missing(ni) and not missing(ni_l1_cur) then
540            scaled_change = (ni-ni_l1_cur) / mve_l1;
