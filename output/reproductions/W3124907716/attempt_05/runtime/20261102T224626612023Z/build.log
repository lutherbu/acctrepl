192        proc sql;
193          create table work.daily_date as
194          select a.gvkey,a.header_iid,a.hiid,a.datadate,a.fyear,a.pyear,a.pmon,
195                 a.prcc_f,a.price_tol,max(b.datadate) as daily_date format=date9.
196          from work.price_unres as a
197          left join work.sec_prc as b
198            on a.gvkey=b.gvkey and a.hiid=b.iid and b.datadate<=a.datadate
199          group by a.gvkey,a.header_iid,a.hiid,a.datadate,a.fyear,a.pyear,a.pmon,
200                   a.prcc_f,a.price_tol;
NOTE: Table WORK.DAILY_DATE created, with 6968 rows and 10 columns.

201          create table work.daily_quote as
202          select a.*,count(b.datadate) as daily_rows,
203                 count(distinct b.curcdd) as daily_ccy_n,
204                 min(b.curcdd) as daily_cur length=3,
205                 min(case when not missing(b.datadate) and not missing(b.prccd)
206                               and not missing(a.prcc_f)
207                          then abs(b.prccd-a.prcc_f) else . end) as daily_gap,
208                 a.datadate-a.daily_date as daily_age,
209                 coalesce(mm.month_marker_rows,0) as month_marker_rows,
210                 coalesce(mm.month_marker_code_n,0) as month_marker_code_n,
211                 mm.month_marker_code
212          from work.daily_date as a
213          left join work.sec_prc as b
214            on a.gvkey=b.gvkey and a.hiid=b.iid and a.daily_date=b.datadate
215          left join
216            (select gvkey,iid,marker_year,marker_month,
217                    count(*) as month_marker_rows,
218                    count(distinct primiss) as month_marker_code_n,
219                    min(primiss) as month_marker_code length=3
220             from work.sec_month_marker
221             group by gvkey,iid,marker_year,marker_month) as mm
222            on a.gvkey=mm.gvkey and a.hiid=mm.iid
223           and a.pyear=mm.marker_year and a.pmon=mm.marker_month
224          group by a.gvkey,a.header_iid,a.hiid,a.datadate,a.fyear,a.pyear,a.pmon,
225                   a.prcc_f,a.price_tol,a.daily_date,
226                   mm.month_marker_rows,mm.month_marker_code_n,mm.month_marker_code;
NOTE: Table WORK.DAILY_QUOTE created, with 6968 rows and 18 columns.

227          create table work.daily_calendar as
228          select a.*,count(b.date) as market_days_gap
229          from work.daily_quote as a
230          left join work.market_days as b
231            on b.date>a.daily_date and b.date<=a.datadate
232          group by a.gvkey,a.header_iid,a.hiid,a.datadate,a.fyear,a.pyear,a.pmon,
233                   a.prcc_f,a.price_tol,a.daily_date,a.daily_rows,a.daily_ccy_n,
234                   a.daily_cur,a.daily_gap,a.daily_age,a.month_marker_rows,
235                   a.month_marker_code_n,a.month_marker_code;
