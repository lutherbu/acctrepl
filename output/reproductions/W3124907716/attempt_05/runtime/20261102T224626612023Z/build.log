NOTE: Table WORK.DAILY_CHECKED created, with 6968 rows and 20 columns.

247          create table work.price_final as
248          select a.*,
249                 coalesce(d.daily_rows,0) as daily_rows,
250                 coalesce(d.daily_ccy_n,0) as daily_ccy_n,
251                 d.daily_cur,d.daily_date,d.daily_age,d.daily_gap,d.market_days_gap,
252                 coalesce(d.month_marker_rows,0) as daily_month_marker_rows,
253                 coalesce(d.month_marker_code_n,0) as daily_month_marker_code_n,
254                 d.month_marker_code as daily_month_marker_code,
255                 coalesce(d.daily_price_ok,0) as daily_price_ok,
256                 case when a.month_price_ok=1 then a.mth_cur
257                      when d.daily_price_ok=1 then d.daily_cur else '' end
258                      as price_cur_final length=3,
259                 case when a.month_price_ok=1 then a.mth_date
260                      when d.daily_price_ok=1 then d.daily_date else . end
261                      as price_date format=date9.,
262                 case when a.month_price_ok=1 or d.daily_price_ok=1 then 1 else 0 end
263                      as price_cur_verified,
264                 case when a.month_price_ok=1 then 'HIID_MONTH'
265                      when d.daily_price_ok=1 and d.daily_age=0 then 'HIID_D0'
266                      when d.daily_price_ok=1 then 'HIID_CLOSURE'
267                      else '' end as price_cur_src length=12,
268                 case when missing(a.hiid) then 'NO_HIID'
269                      when a.month_price_ok=1 then 'HIID_MONTH'
270                      when a.month_marker_conflict=1 then 'MONTH_MARKER_CONFLICT'
271                      when a.mth_rows>0 and a.mth_ccy_n>1 then 'MONTH_AMBIG_CCY'
272                      when a.mth_rows>1 then 'MONTH_AMBIG_ROWS'
273                      when a.mth_rows=1 and missing(a.mth_gap) then 'MONTH_PRICE_MISSING'
274                      when a.mth_rows=1 and not missing(a.mth_gap)
275                           and not missing(a.price_tol) and a.mth_gap>a.price_tol then 'MONTH_PRICE_DIFF'
276                      when d.daily_price_ok=1 and d.daily_age=0 then 'HIID_DAILY_EXACT'
277                      when d.daily_price_ok=1 then 'HIID_DAILY_CLOSURE'
278                      when d.daily_rows=1 and d.daily_ccy_n=1 and not missing(d.daily_gap)
279                           and not missing(a.price_tol) and d.daily_gap>a.price_tol then 'DAILY_PRICE_DIFF'
280                      when d.daily_rows=1 and d.daily_ccy_n=1 and not missing(d.daily_gap)
281                           and not missing(a.price_tol) and d.daily_gap<=a.price_tol
282                           and not missing(d.daily_age) and d.daily_age>7 then 'DAILY_STALE'
283                      when d.month_marker_rows>1 or d.month_marker_code_n>1
284                           or (d.month_marker_code_n=1 and d.month_marker_code ne 'P')
285                           then 'DAILY_MARKER_CONFLICT'
286                      when d.daily_rows=1 and d.daily_ccy_n=1 and not missing(d.daily_age)
287                           and d.daily_age between 1 and 7 and d.market_days_gap>0 then 'DAILY_MARKET_GAP'
288                      when d.daily_rows>1 or d.daily_ccy_n>1 then 'DAILY_AMBIGUOUS'
289                      else 'UNSUPPORTED' end as price_status length=24,
290                 case when a.month_price_ok=1 then 'MONTHLY'
291                      when d.daily_price_ok=1 and d.daily_age=0 then 'DAILY_EXACT'
292                      when d.daily_price_ok=1 then 'DAILY_CLOSURE'
293                      when d.daily_rows=1 and d.daily_ccy_n=1 and not missing(d.daily_gap)
294                           and not missing(a.price_tol) and d.daily_gap<=a.price_tol
17                                                         The SAS System                     Tuesday, November  3, 2026 06:46:00 AM

295                           and not missing(d.daily_age) and d.daily_age>7 then 'DAILY_STALE'
296                      else 'UNRESOLVED' end as price_status_group length=16
297          from work.price_month as a
298          left join work.daily_checked as d
299            on a.gvkey=d.gvkey and a.header_iid=d.header_iid
300           and a.hiid=d.hiid and a.datadate=d.datadate;
