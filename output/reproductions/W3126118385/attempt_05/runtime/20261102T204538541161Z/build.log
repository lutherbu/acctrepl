1174       
1175       /* Rank within fiscal year. Ties are split deterministically by GVKEY so the
1176          requested terciles/quintiles are as even as possible; the paper does not
1177          specify a tie-breaking rule. */
1178       %macro group_score(input=, value=, out=, score=, groups=, descending=0);
1179           data _rank_input;
1180               set &input;
1181               if not missing(&value);
1182           run;
1183           proc sql;
1184               create table _rank_counts as
1185               select fyear, count(*) as _n_rank
1186               from _rank_input
1187               group by fyear;
1188           quit;
1189           proc sort data=_rank_input;
1190               %if &descending=1 %then %do;
1191                   by fyear descending &value gvkey;
1192               %end;
1193               %else %do;
1194                   by fyear &value gvkey;
1195               %end;
1196           run;
1197           proc sort data=_rank_counts; by fyear; run;
1198           data &out;
1199               merge _rank_input(in=_in_rank) _rank_counts;
1200               by fyear;
1201               if _in_rank;
1202               if first.fyear then _seq=0;
1203               _seq+1;
1204               &score=floor((_seq-1)*&groups/_n_rank);
1205               keep gvkey fyear datadate &score;
1206           run;
