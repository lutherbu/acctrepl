850        proc sql;
851            create table market_value_currency_audit as
852            select curcd_up, fic, count(*) as n_firm_years,
853                   sum(not missing(mve_usd) and not missing(mve_compustat_usd)) as n_both,
854                   mean(compustat_crsp_mve_ratio) as mean_compustat_crsp_ratio,
855                   sum(missing(mve_usd)) as n_crsp_mve_missing,
856                   sum(n_crsp_common_classes>1) as n_multi_class,
857                   sum(n_crsp_other_gvkey_classes>0) as n_conflicting_gvkey_firm_years,
858                   sum(n_crsp_multi_gvkey_classes>0) as n_multi_gvkey_class_firm_years,
859                   sum(n_crsp_other_gvkey_mappings) as n_other_gvkey_mappings,
860                   sum(n_crsp_jn_classes>0) as n_jn_class_firm_years,
861                   sum(n_crsp_same_gvkey_jn_classes>0) as n_same_gvkey_jn_firm_years,
862                   sum(n_crsp_other_gvkey_jn_classes>0) as n_other_gvkey_jn_firm_years,
863                   sum(n_crsp_ls_classes>0) as n_ls_class_firm_years,
864                   sum(n_crsp_other_gvkey_ls_classes>0) as n_other_gvkey_ls_firm_years,
865                   sum(n_crsp_unlinked_classes) as n_unlinked_classes,
866                   sum(n_crsp_unpriced_classes>0) as n_unpriced_class_sets,
867                   sum(not missing(market_date) and market_date<datadate) as n_prior_month_end,
868                   max(datadate-market_date) as max_market_date_age_days,
869                   sum(mve_usd>=1) as n_crsp_mve_ge_1m,
870                   sum(mve_compustat_usd>=1) as n_compustat_mve_ge_1m
871            from annual_market
872            where fyear between 1984 and 2006
873            group by curcd_up, fic;
