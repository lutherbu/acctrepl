906        data annual_metrics;
907            set ratios0;
908            if fyear>=1988 and fyear<=1992 then mtr=0.36;
909            else if fyear>=1993 and fyear<=2006 then mtr=0.37;
910            else mtr=.;
911        
912            if n(noa_usd,noa_l1_usd)=2 then avg_noa_usd=(noa_usd+noa_l1_usd)/2;
913            else avg_noa_usd=.;
914            if n(noa_strict_usd,noa_strict_l1_usd)=2
915               then avg_noa_strict_usd=(noa_strict_usd+noa_strict_l1_usd)/2;
916            else avg_noa_strict_usd=.;
917        
918            /* Preserve the original strict intermediates, including missing values
919               caused by DVP/MSA, while building reduced OI directly from the
920               uncancelled Appendix A inputs.  Missing fields are never zero-filled. */
921            if n(ni_usd,dvp_usd,msa_usd,msa_l1_usd,recta_usd,recta_l1_usd)=6 then
922                cni_usd=ni_usd-dvp_usd+(msa_usd-msa_l1_usd)+(recta_usd-recta_l1_usd);
923            else cni_usd=.;
924            if n(xint_usd,dvp_usd,idit_usd,msa_l1_usd,msa_usd)=5 and not missing(mtr)
925               then nfe_usd=xint_usd*(1-mtr)+dvp_usd-idit_usd*(1-mtr)+msa_l1_usd-msa_usd;
926            else nfe_usd=.;
927            if n(cni_usd,nfe_usd)=2 then oi_strict_usd=cni_usd+nfe_usd;
928            else oi_strict_usd=.;
929            if n(ni_usd,xint_usd,idit_usd,recta_usd,recta_l1_usd,mtr)=6
930               then oi_usd=ni_usd+(xint_usd-idit_usd)*(1-mtr)+recta_usd-recta_l1_usd;
931            else oi_usd=.;
932        
933            if not missing(oi_usd) and not missing(avg_noa_usd) and avg_noa_usd ne 0
934               then rnoa=oi_usd/avg_noa_usd;
935            else rnoa=.;
936            if not missing(sale_usd) and not missing(avg_noa_usd) and avg_noa_usd ne 0
937               then ato=sale_usd/avg_noa_usd;
938            else ato=.;
939            if not missing(oi_usd) and not missing(sale_usd) and sale_usd ne 0
940               then pm=oi_usd/sale_usd;
941            else pm=.;
942            if not missing(noa_usd) and not missing(noa_l1_usd) and noa_l1_usd ne 0
943               then grnoa=noa_usd/noa_l1_usd-1;
944            else grnoa=.;
