665            /* The paper defines firm age by the first CRSP appearance. When a firm
666               has more than one valid PERMNO during the study period, use its earliest
667               observed date across all of its selected, date-valid PERMNOs. */
668            create table gvkey_first as
669            select l.gvkey, min(p.first_crsp_date) as first_crsp_date format=yymmdd10.
670            from (select distinct gvkey, permno from link_best) as l
671            inner join permno_first as p
672              on l.permno=p.permno
673            group by l.gvkey;
