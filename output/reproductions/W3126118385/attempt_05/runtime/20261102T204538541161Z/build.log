253        data annual_fx;
254            set annual_fx;
255            length fx_daily_match_status $8;
256            if curcd_up='USD' then do;
257                fx_bs_usd=1;
258                fx_flow_usd=1;
259                fx_daily_match_status='USD';
260            end;
261            else do;
262                if not missing(gbp_to_reported_daily) and gbp_to_reported_daily>0
263                   and not missing(gbp_to_usd_daily) and gbp_to_usd_daily>0
264                   and not missing(fx_daily_date) and fx_daily_date=fx_usd_daily_date
265                   and fx_daily_date<=datadate and datadate-fx_daily_date<=7 then do;
266                    fx_bs_usd=gbp_to_usd_daily/gbp_to_reported_daily;
267                    if fx_daily_date=datadate then fx_daily_match_status='EXACT';
268                    else fx_daily_match_status='FALLBACK';
269                end;
270                else do;
271                    fx_bs_usd=.;
272                    fx_daily_match_status='MISSING';
273                end;
274                if not missing(gbp_to_reported_12m) and gbp_to_reported_12m>0
The SAS System

275                   and not missing(gbp_to_usd_12m) and gbp_to_usd_12m>0
276                    then fx_flow_usd=gbp_to_usd_12m/gbp_to_reported_12m;
277                else fx_flow_usd=.;
278            end;
279            if curcd_up ne 'USD' and not missing(currtr) and currtr>0
280               and not missing(fx_bs_usd) and fx_bs_usd>0 then do;
281                currtr_direct_ratio=currtr/fx_bs_usd;
282                currtr_reciprocal_product=currtr*fx_bs_usd;
283                if abs(log(currtr_direct_ratio))<=0.01 then currtr_matches_direct=1;
284                else currtr_matches_direct=0;
285                if abs(log(currtr_reciprocal_product))<=0.01 then currtr_matches_reciprocal=1;
286                else currtr_matches_reciprocal=0;
287            end;
288            label fx_bs_usd="USD per reported-currency unit, daily point-in-time rate"
289                  fx_flow_usd="USD per reported-currency unit, trailing 12-month average rate"
290                  currtr_direct_ratio="CURRTR divided by provider USD/reporting cross-rate"
291                  currtr_reciprocal_product="CURRTR times provider USD/reporting cross-rate"
292                  fx_daily_match_status="Same-date daily-pair status relative to fiscal date";
