92         /* Compustat's Xpressfeed currency procedure quotes daily and monthly
93            exchanges from GBP to each target currency. A reported-currency amount in
94            USD is amount * (GBP->USD rate / GBP->reported-currency rate). The provider
95            specifies daily rates for balance-sheet and price data, and EXRAT12M for
96            income-statement and cash-flow data. Daily cross-rate legs must use a
97            coherent shared quote date no later than the actual fiscal date. Each leg's
98            EXRATTPD and date are retained as provenance; type differences do not imply
99            different currency units. CURRTR is kept for a direction/coverage audit. */
100        data fx_daily_source_all;
101            set fxsrc.g_exrt_dly(keep=datadate exratd exrattpd fromcurd tocurd
102                where=(upcase(fromcurd)='GBP'
103                       and datadate>='01JAN1980'd
104                       and datadate<=&fx_source_end));
105            currency=upcase(strip(tocurd));
106            if not missing(currency);
107            format datadate yymmdd10.;
108            label currency="Target currency"
109                  exratd="GBP-to-target daily exchange rate"
110                  exrattpd="Provider daily exchange-rate type";
111        run;

