843            else compustat_crsp_mve_ratio=.;
844            label mve_crsp_usd="All CRSP PERMCO common classes, USD millions, including link conflicts"
845                  mve_compustat_usd="Compustat fiscal price times shares converted using annual fundamentals CURCD"
846                  mve_usd="Conflict-free CRSP PERMCO equity market value used for size screen and CAPX ratio"
847                  compustat_crsp_mve_ratio="Compustat market equity divided by CRSP PERMCO market equity";
848        run;

