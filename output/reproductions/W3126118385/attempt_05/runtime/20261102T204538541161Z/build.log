728            /* Audit each common PERMNO under the selected PERMCO on the market date.
729               Include active used primary and secondary mappings; CCM documents that
730               an LS security can share a PERMCO with securities mapped to other
731               GVKEYs. Do not silently blend those cases into a company MVE. */
732            create table annual_mve_class_status as
733            select a.gvkey, a.fyear, a.datadate, a.permco, d.market_date,
734                   s.permno as class_permno, s.prc, s.shrout,
735                   max(case when not missing(b.gvkey) and b.gvkey=a.gvkey then 1 else 0 end)
736                       as has_same_gvkey_link,
737                   max(case when not missing(b.gvkey) and b.gvkey ne a.gvkey then 1 else 0 end)
738                       as has_other_gvkey_link,
739                   max(case when not missing(b.gvkey) and b.linkprim in ('J','N') then 1 else 0 end)
740                       as has_jn_link,
741                   max(case when not missing(b.gvkey) and b.gvkey=a.gvkey
742                                 and b.linkprim in ('J','N') then 1 else 0 end)
743                       as has_same_gvkey_jn_link,
744                   max(case when not missing(b.gvkey) and b.gvkey ne a.gvkey
745                                 and b.linkprim in ('J','N') then 1 else 0 end)
746                       as has_other_gvkey_jn_link,
747                   max(case when not missing(b.gvkey) and b.linktype='LS' then 1 else 0 end)
748                       as has_ls_link,
749                   max(case when not missing(b.gvkey) and b.gvkey ne a.gvkey
750                                 and b.linktype='LS' then 1 else 0 end)
751                       as has_other_gvkey_ls_link,
752                   max(case when not missing(b.gvkey) then 1 else 0 end) as has_used_link,
753                   count(distinct case when not missing(b.gvkey) and b.gvkey ne a.gvkey
754                                       then b.gvkey else '' end) as n_other_gvkeys
755            from annual_permco as a
756            left join annual_market_date as d
757              on a.gvkey=d.gvkey and a.fyear=d.fyear and a.datadate=d.datadate
758             and a.permno=d.permno and a.permco=d.permco
759            inner join crsp_common_monthly0 as s
760              on a.permco=s.permco and d.market_date=s.date
761            left join ccm.ccmxpf_linktable as b
762              on s.permno=b.lpermno and s.permco=b.lpermco
763             and b.linkdt<=d.market_date
764             and (missing(b.linkenddt) or d.market_date<=b.linkenddt)
765             and b.usedflag=1
