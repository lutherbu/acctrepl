655            /* First CRSP monthly record for each selected PERMNO. This is the paper's
656               stated CRSP first-appearance age proxy; no later date fills a gap. */
657            create table permno_first as
658            select s.permno, min(s.date) as first_crsp_date format=yymmdd10.
659            from crsp.msf as s
660            inner join permno_pool as p
661              on s.permno=p.permno
662            where s.date<='31DEC2006'd
663            group by s.permno;
NOTE: Table WORK.PERMNO_FIRST created, with 17255 rows and 2 columns.

