987        /* Algebraic checks use ordinary construct aggregates.  The strict versions
988           above require every original Appendix A intermediate input; the reduced
989           versions require exactly the uncancelled inputs.  Any complete-case
990           mismatch stops the build. */
991        proc sql;
992            create table algebraic_construct_audit as
993            select sum(not missing(noa_strict_usd) and not missing(noa_usd)) as n_noa_complete,
994                   sum(not missing(noa_strict_usd) and not missing(noa_usd)
The SAS System

995                       and abs(noa_strict_usd-noa_usd)>1e-8) as n_noa_different,
996                   max(abs(noa_strict_usd-noa_usd)) as max_noa_absolute_difference,
997                   sum(missing(noa_strict_usd) and not missing(noa_usd)) as n_noa_recovered,
998                   sum(fyear between 1989 and 2005 and missing(noa_strict_usd)
999                       and not missing(noa_usd)) as n_noa_recovered_1989_2005,
1000                  sum(not missing(oi_strict_usd) and not missing(oi_usd)) as n_oi_complete,
1001                  sum(not missing(oi_strict_usd) and not missing(oi_usd)
1002                      and abs(oi_strict_usd-oi_usd)>1e-8) as n_oi_different,
1003                  max(abs(oi_strict_usd-oi_usd)) as max_oi_absolute_difference,
1004                  sum(missing(oi_strict_usd) and not missing(oi_usd)) as n_oi_recovered,
1005                  sum(fyear between 1989 and 2005 and missing(oi_strict_usd)
1006                      and not missing(oi_usd)) as n_oi_recovered_1989_2005
1007           from annual_metrics;
