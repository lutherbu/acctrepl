4          title "Bounded role-completeness audit for duplicate GVKEY/FYEAR records";
5          proc sql;
NOTE: PROC SQL set option NOEXEC and will continue to check the syntax of statements.
6            create table work.dup_roles as
7            select f.fyear, f.datadate format=date9., upcase(strip(f.curcd)) as curcd length=3,
8                   (not missing(f.gdwl)) as has_gdwl,
9                   (not missing(f.gdwlip)) as has_gdwlip,
10                  (not missing(f.spi)) as has_spi,
11                  (not missing(f.at)) as has_at,
12                  (not missing(f.oiadp)) as has_oiadp,
13                  (not missing(f.ceq)) as has_ceq,
14                  (not missing(f.prcc_f)) as has_prccf,
15                  (not missing(f.csho)) as has_csho
16           from fund.funda as f
17           where f.gvkey="066552"
18             and f.fyear between 2008 and 2011
19             and f.indfmt="INDL" and f.datafmt="STD"
20             and f.consol="C" and f.popsrc="D"
10                                                         The SAS System                     Tuesday, November  3, 2026 03:57:00 PM

21           order by f.fyear, f.datadate;
NOTE: Statement not executed due to NOEXEC option.
22         
23           select fyear, datadate, curcd, has_gdwl, has_gdwlip, has_spi,
24                  has_at, has_oiadp, has_ceq, has_prccf, has_csho
25           from work.dup_roles
26           order by fyear, datadate;
