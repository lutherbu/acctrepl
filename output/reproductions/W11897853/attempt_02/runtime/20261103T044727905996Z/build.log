256                        else price_route='HIID_NO_MARKER';
257                    end;
258                    else price_route='HIID_PRICE_MISMATCH';
259                end;
260                else price_route='HIID_NO_DATED_QUOTE';
261            end;
262            else if p_count=1 then do;
263                if strip(upcase(p_primiss))='P' and p_quote_cur ne '' and
