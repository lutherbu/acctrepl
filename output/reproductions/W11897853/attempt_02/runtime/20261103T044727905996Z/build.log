208        /* Match each annual price to its full historic issue at the exact fiscal
209           date. A unique dated primary issue is a fallback only when HIID is absent. */
210        proc sql;
211            create table work.price_evidence as
212            select a.gvkey, a.fyear, a.datadate, a.iid as header_iid,
213                   a.hiid, a.prcc_f,
214                   h.primiss as hiid_primiss,
215                   h.curcdm as hiid_quote_cur,
216                   h.prccm as hiid_quote_px,
217                   c.p_count, c.p_iid,
218                   p.primiss as p_primiss,
219                   p.curcdm as p_quote_cur,
220                   p.prccm as p_quote_px
221            from work.core_unique as a
222            left join work.sec_issue_price as h
223              on not missing(a.hiid) and a.gvkey=h.gvkey and a.datadate=h.datadate and
224                 strip(a.hiid)=strip(h.iid)
225            left join work.sec_primary_count as c
226              on a.gvkey=c.gvkey and a.datadate=c.datadate
227            left join work.sec_issue_price as p
228              on c.p_count=1 and a.gvkey=p.gvkey and a.datadate=p.datadate and
229                 c.p_iid=p.iid
230            where a.fyear between &first_fy and &last_fy;
