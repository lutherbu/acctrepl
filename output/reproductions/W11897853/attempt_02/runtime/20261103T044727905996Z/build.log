234            set work.price_evidence;
235            length quote_cur $4 price_route $32 price_issue $21
236                   hiid_marker $2;
237            quote_cur=''; price_route='NO_SUPPORTED_ROUTE'; price_issue='';
238            quote_px=.; price_abs_diff=.; hiid_marker=strip(upcase(hiid_primiss));
239            annual_price_ok=0; hiid_p_count=.;
240            if not missing(p_count) then hiid_p_count=p_count;
241        
242            /* SEC_MTHPRC stores four decimals. Do not test both AJEX directions. */
243            if not missing(hiid) then do;
244                if hiid_marker='J' or (hiid_marker ne '' and hiid_marker ne 'P') then
245                    price_route='HIID_EXPLICIT_NONP';
246                else if not missing(hiid_quote_px) and hiid_quote_px>0 and
247                        hiid_quote_cur ne '' then do;
248                    price_abs_diff=abs(prcc_f-hiid_quote_px);
249                    if not missing(prcc_f) and prcc_f>0 and
250                       price_abs_diff <= 0.00005 then do;
251                        quote_cur=hiid_quote_cur;
