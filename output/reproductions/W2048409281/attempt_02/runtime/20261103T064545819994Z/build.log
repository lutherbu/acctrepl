295        title "Construct lagged assets and forward earnings without future-year classification screens";
296        proc sql;
297          create table out.model_rows as
298          select c.gvkey, c.fyear, c.datadate,
299                 c.fic, c.curcd, c.sich, c.sic_used, c.sic_source,
300                 c.sic_disagree, c.n_valid_siccd, c.n_linked_permnos,
301                 c.country_ok, c.exchange_ok, c.industry_ok,
302                 c.dvc, c.ib, c.xint, c.idit,
303                 c.flow_to_usd, c.stock_to_usd, c.earn_usd,
304                 p.datadate as lag_datadate,
305                 p.at_usd as assets_lag_usd,
306                 h1.datadate as lead1_datadate,
307                 h1.earn_usd as earnings_h1_usd,
308                 h2.datadate as lead2_datadate,
309                 h2.earn_usd as earnings_h2_usd
310          from out.current_info as c
311          left join out.lag_asset_support as p
312            on c.gvkey=p.gvkey and p.fyear=c.fyear-1
313           and p.datadate<c.datadate
314          left join out.annual_unique as h1
315            on c.gvkey=h1.gvkey and h1.fyear=c.fyear+1
316           and h1.datadate>c.datadate
317          left join out.annual_unique as h2
                                                           The SAS System

318            on c.gvkey=h2.gvkey and h2.fyear=c.fyear+2
319           and h2.datadate>c.datadate
320          order by c.gvkey, c.fyear, c.datadate;
