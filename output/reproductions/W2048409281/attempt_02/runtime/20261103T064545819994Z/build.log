322        data out.main;
323          set out.model_rows;
324          if dvc>0 then dp=1;
325          else if dvc=0 then dp=0;
326          else dp=.;
327          current_ok=(country_ok=1 and exchange_ok=1 and industry_ok=1
328                      and not missing(dp) and not missing(earn_usd));
329          rate_ok=(current_ok=1 and not missing(assets_lag_usd)
330                   and assets_lag_usd>0);
331          if rate_ok then e_rate=max(-1,min(1,earn_usd/assets_lag_usd));
332          else e_rate=.;
333          use_h1=(rate_ok=1 and not missing(earnings_h1_usd));
334          use_h2=(rate_ok=1 and not missing(earnings_h2_usd));
335          if use_h1 then y_h1=max(-1,min(1,earnings_h1_usd/assets_lag_usd));
336          else y_h1=.;
337          if use_h2 then y_h2=max(-1,min(1,earnings_h2_usd/assets_lag_usd));
338          else y_h2=.;
