71           create table out.annual_rates as
72           select a.*,
73                  case
74                    when upcase(a.curcd)='USD' then 1
75                    when fm.exrat12m>0 and fu.exrat12m>0
76                      then fu.exrat12m/fm.exrat12m
77                    else .
78                  end as flow_to_usd,
79                  case
80                    when upcase(a.curcd)='USD' then 1
81                    when ds.exratd>0 and du.exratd>0
82                      then du.exratd/ds.exratd
83                    else .
84                  end as stock_to_usd,
85                  (a.ib+0.6*a.xint-0.6*a.idit) *
86                    (case
87                       when upcase(a.curcd)='USD' then 1
88                       when fm.exrat12m>0 and fu.exrat12m>0
89                         then fu.exrat12m/fm.exrat12m
90                       else .
91                     end) as earn_usd,
92                  a.at *
93                    (case
94                       when upcase(a.curcd)='USD' then 1
95                       when ds.exratd>0 and du.exratd>0
96                         then du.exratd/ds.exratd
97                       else .
98                     end) as at_usd
