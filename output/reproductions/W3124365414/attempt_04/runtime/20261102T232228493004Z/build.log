325        data work.price_routes;
326            set work.price_evidence;
327            length price_curcd old_price_curcd p_iid $4 price_source old_price_source $1
328                   price_route $12 price_issue $21 price_selected_marker $2;
329            price_quote_gap=.;
330            price_date=.;
331            price_abs_diff=.;
332            format price_date yymmdd10.;
333            price_market_sessions_gap=.;
334            price_dated_p_count=p_count;
335            hiid_month_ok=0; hiid_day_ok=0; p_month_ok=0; p_day_ok=0;
336            if not missing(prcc_f) and not missing(hiid_prccm) then
337                hiid_month_ok=(datadate=monthdate and abs(prcc_f-hiid_prccm) <= 0.00005);
338            if not missing(prcc_f) and not missing(hiid_prccd) then
339                hiid_day_ok=(abs(prcc_f-hiid_prccd) <= 0.000000005 and
340                             (hiid_quote_gap=0 or
341                              (hiid_quote_gap>=1 and hiid_quote_gap<=3 and
342                               hiid_market_sessions_gap=0)));
343            if not missing(prcc_f) and not missing(p_prccm) then
344                p_month_ok=(datadate=monthdate and abs(prcc_f-p_prccm) <= 0.00005);
345            if not missing(prcc_f) and not missing(p_prccd) then
346                p_day_ok=(abs(prcc_f-p_prccd) <= 0.000000005 and
347                          (p_quote_gap=0 or
348                           (p_quote_gap>=1 and p_quote_gap<=3 and
349                            p_market_sessions_gap=0)));
350            price_currency_conflict=0;
351            if datadate=monthdate and not missing(hiid_curcdm) and not missing(hiid_curcdd) and
352               hiid_curcdm ne hiid_curcdd then price_currency_conflict=1;
353            if datadate=monthdate and not missing(p_curcdm) and not missing(p_curcdd) and
354               p_curcdm ne p_curcdd then price_currency_conflict=1;
355            marker_conflict=0;
356            if not missing(hiid) then do;
357                if hiid_primiss='J' or (not missing(hiid_primiss) and hiid_primiss ne 'P') then marker_conflict=1;
358            end;
359            else if p_count > 1 then marker_conflict=1;
360            route_conflict=(marker_conflict or price_currency_conflict);
361        
362            /* Reproduce A3's header-IID currency route solely for impact comparison. */
363            if old_day_quote_gap=0 and not missing(old_day_curcd) then do;
364                old_price_curcd=old_day_curcd;
365                old_price_source='D';
366            end;
367            else if not missing(old_month_curcd) then do;
368                old_price_curcd=old_month_curcd;
369                old_price_source='M';
370            end;
371        
372            if route_conflict=0 and not missing(hiid) then do;
373                if hiid_primiss='P' then do;
374                    if hiid_month_ok and not missing(hiid_curcdm) then do;
375                        price_curcd=hiid_curcdm; price_source='M'; price_route='HIID_P_M'; price_issue=hiid;
376                        price_date=datadate;
                                                           The SAS System

377                        price_abs_diff=abs(prcc_f-hiid_prccm);
378                    end;
379                    else if hiid_day_ok and not missing(hiid_curcdd) then do;
380                        price_curcd=hiid_curcdd; price_source='D'; price_route='HIID_P_D';
381                        price_issue=hiid; price_quote_gap=hiid_quote_gap;
382                        price_market_sessions_gap=hiid_market_sessions_gap;
383                        price_date=hiid_quote_date;
384                        price_abs_diff=abs(prcc_f-hiid_prccd);
385                    end;
386                end;
387                else if missing(hiid_primiss) then do;
388                    if hiid_month_ok and not missing(hiid_curcdm) then do;
389                        price_curcd=hiid_curcdm; price_source='M'; price_route='HIID_N_M'; price_issue=hiid;
390                        price_date=datadate;
391                        price_abs_diff=abs(prcc_f-hiid_prccm);
392                    end;
393                    else if hiid_day_ok and not missing(hiid_curcdd) then do;
394                        price_curcd=hiid_curcdd; price_source='D'; price_route='HIID_N_D';
395                        price_issue=hiid; price_quote_gap=hiid_quote_gap;
396                        price_market_sessions_gap=hiid_market_sessions_gap;
397                        price_date=hiid_quote_date;
398                        price_abs_diff=abs(prcc_f-hiid_prccd);
399                    end;
400                end;
401            end;
402            else if route_conflict=0 and missing(hiid) and p_count=1 then do;
403                if p_month_ok and not missing(p_curcdm) then do;
404                    price_curcd=p_curcdm; price_source='M'; price_route='DATEDP_M'; price_issue=p_iid;
405                    price_date=datadate;
406                    price_abs_diff=abs(prcc_f-p_prccm);
407                end;
408                else if p_day_ok and not missing(p_curcdd) then do;
409                    price_curcd=p_curcdd; price_source='D'; price_route='DATEDP_D';
410                    price_issue=p_iid; price_quote_gap=p_quote_gap;
411                    price_market_sessions_gap=p_market_sessions_gap;
412                    price_date=p_quote_date;
413                    price_abs_diff=abs(prcc_f-p_prccd);
414                end;
415            end;
416            if substr(price_route,1,6)='DATEDP' then price_selected_marker='P';
417            else price_selected_marker=hiid_primiss;
