911            if not missing(pred_disexp) then ab_disexp=disexp_at-pred_disexp;
912            if not missing(pred_prod) then ab_prod=prod_at-pred_prod;
913            if missing(ab_cfo) or missing(ab_disexp) or missing(ab_prod) then delete;
914            if at_lag1_usd > 0 then accruals_at=accruals_usd/at_lag1_usd;
