588        /* Convert amount inputs to USD at their own source rows. The provider formula
589           is (reported amount / GBP-to-reported rate) * GBP-to-USD rate. Ratios can be
590           computed natively where exact source currencies cancel. */
591        data work.constructed;
592            set work.panel;
593            length analysis_period excluded_sic appx_complete 8;
594            if missing(sich) then sic2=.;
595            else sic2=floor(sich/100);
596            analysis_period=(1987 <= fyear and fyear <= 2001);
                                                           The SAS System

597            excluded_sic=(not missing(sich) and
598                          ((4400 <= sich and sich <= 5000) or
599                           (6000 <= sich and sich <= 6500)));
600        
601            if curcd='USD' then do; flowfac_t=1; bsfac_t=1; end;
602            if curcd_lag1='USD' then do; flowfac_lag1=1; bsfac_lag1=1; end;
603            if curcd_lag2='USD' then flowfac_lag2=1;
604            if price_curcd='USD' then pricefac_t=1;
605            if price_curcd_lag1='USD' then pricefac_lag1=1;
606        
607            if not missing(at) and not missing(bsfac_t) then at_usd=at*bsfac_t;
608            if not missing(at_lag1) and not missing(bsfac_lag1) then at_lag1_usd=at_lag1*bsfac_lag1;
609            if not missing(ib) and not missing(flowfac_t) then ib_usd=ib*flowfac_t;
