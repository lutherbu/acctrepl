293                   hm.primiss as hiid_primiss,
294                   hp.prccm as hiid_prccm,hp.curcdm as hiid_curcdm,
295                   hd.prccd as hiid_prccd,hd.curcdd as hiid_curcdd,
296                   hd.quote_date as hiid_quote_date,hd.quote_gap as hiid_quote_gap,
297                   hd.market_sessions_gap as hiid_market_sessions_gap,
298                   ps.p_count,pu.p_iid,pp.prccm as p_prccm,pp.curcdm as p_curcdm,
