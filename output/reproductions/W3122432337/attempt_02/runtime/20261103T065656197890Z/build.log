148        
149        /* Select each price role at its own target month. A unique contemporaneous P wins.
150           With an absent marker only, continuity is accepted if the same issue is P in both
151           immediately adjacent months. Quarter HIID is audit evidence only, never a role-date key. */
152        %macro build_price_role(role=,offset=,out=);
153          proc sql;
154            create table work.&role._cand as
155            select q.gvkey, q.datadate, q.hiid, intnx('month',q.datadate,&offset,'end') as target_month,
156              p.iid, p.quote_date, p.curcdm, p.prccm, p.marker,
7                                                          The SAS System                     Tuesday, November  3, 2026 02:56:00 PM

157              case when p.iid ne '' and prev.iid ne '' and next.iid ne '' then 1 else 0 end as continuity_support
158            from work.q_unique as q left join work.sec_price as p
159              on q.gvkey=p.gvkey and intnx('month',q.datadate,&offset,'end')=p.monthkey
160            left join work.primary_marker as prev
161              on p.gvkey=prev.gvkey and p.iid=prev.iid
162              and prev.monthkey=intnx('month',p.monthkey,-1,'end')
163            left join work.primary_marker as next
164              on p.gvkey=next.gvkey and p.iid=next.iid
165              and next.monthkey=intnx('month',p.monthkey,1,'end');
166            create table work.&role._count as
167            select gvkey, datadate, sum(marker='P') as n_primary,
168              sum(missing(strip(marker)) and continuity_support=1) as n_supported_blank,
169              count(iid) as n_quoted_issues
170            from work.&role._cand group by gvkey, datadate;
171            create table work.&role._eligible as
172            select c.* from work.&role._cand as c inner join work.&role._count as n
173              on c.gvkey=n.gvkey and c.datadate=n.datadate
174            where (n.n_primary=1 and c.marker='P')
175               or (n.n_primary=0 and n.n_supported_blank=1 and missing(strip(c.marker))
176                    and c.continuity_support=1);
177            create table work.&role._selected as
178            select c.*, n.n_primary, n.n_supported_blank, n.n_quoted_issues,
179              case when c.marker='P' then 'DATE_P' else 'ADJACENT_P_CONTINUITY' end as price_route length=28,
180              (not missing(c.hiid) and c.iid ne c.hiid) as differs_from_quarter_hiid
181            from work.&role._eligible as c inner join work.&role._count as n
182              on c.gvkey=n.gvkey and c.datadate=n.datadate;
183            create table work.&role._unique as
184            select gvkey, datadate, count(*) as n_selected from work.&role._selected
185              group by gvkey, datadate;
186            create table work.&role as
187            select a.gvkey, a.datadate, a.iid as &role._iid, a.quote_date as &role._date,
188              a.curcdm as &role._currency, a.prccm as &role._price,
189              a.price_route as &role._route, a.differs_from_quarter_hiid as &role._hiid_diff,
190              a.n_primary as &role._n_primary, a.n_quoted_issues as &role._n_issues
191            from work.&role._selected as a inner join work.&role._unique as b
192              on a.gvkey=b.gvkey and a.datadate=b.datadate
193            where b.n_selected=1;
194            select count(*) as &role._selected_rows,
195              sum(&role._hiid_diff=1) as &role._hiid_diff_count
196              from work.&role;
197          quit;
198        %mend;
199        %build_price_role(role=price3,offset=3,out=work.price3);
