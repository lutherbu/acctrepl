124        data comp_fx;
125          set comp_fx;
126          if upcase(curcd)='USD' then do;
127            flow_fx=1;
128            stock_fx=1;
129          end;
130          else if upcase(curcd)='GBP' then do;
131            if rate_flow_usd > 0 then flow_fx=rate_flow_usd;
132            else flow_fx=.;
133            if rate_stock_usd > 0 then stock_fx=rate_stock_usd;
134            else stock_fx=.;
135          end;
136          else do;
137            if rate_flow_cur > 0 and rate_flow_usd > 0 then
138              flow_fx=rate_flow_usd/rate_flow_cur;
139            else flow_fx=.;
140            if rate_stock_cur > 0 and rate_stock_usd > 0 then
141              stock_fx=rate_stock_usd/rate_stock_cur;
142            else stock_fx=.;
143          end;
144          array stock[9] act lct che dlc rect ppegt at dltt lt;
145          array stockusd[9] act_usd lct_usd che_usd dlc_usd rect_usd
                                                           The SAS System

146                            ppegt_usd at_usd dltt_usd lt_usd;
147          array flow[3] ib dp sale;
148          array flowusd[3] ib_usd dp_usd sale_usd;
149          do j=1 to dim(stock);
150            if not missing(stock[j]) and not missing(stock_fx) then
151              stockusd[j]=stock[j]*stock_fx;
152            else stockusd[j]=.;
153          end;
154          do j=1 to dim(flow);
155            if not missing(flow[j]) and not missing(flow_fx) then
156              flowusd[j]=flow[j]*flow_fx;
157            else flowusd[j]=.;
158          end;
159          drop j;
