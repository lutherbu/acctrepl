286        /* Eq. (1a) support population, with CFO at t-1/t/t+1 scaled by the
287           same average assets for t, as in the displayed equation. */
288        proc sql;
289          create table dd_fit0 as
290          select a.gvkey, a.fyear, a.ffi49, a.tca_scaled, a.invasset,
291                 b.cfo/a.avgasset as cfom1,
292                 a.cfo/a.avgasset as cfo0,
293                 c.cfo/a.avgasset as cfop1,
294                 a.drev_scaled as drev, a.ppe_scaled as ppe
295          from comp_core as a
296          inner join comp_core as b
297            on a.gvkey=b.gvkey and b.fyear=a.fyear-1
298          inner join comp_core as c
299            on a.gvkey=c.gvkey and c.fyear=a.fyear+1
300          where 1957 <= a.fyear <= 2001 and not missing(a.ffi49)
301            and a.avgasset ne 0
302            and nmiss(a.tca_scaled,a.invasset,a.avgasset,b.cfo,c.cfo,
303                      a.cfo,a.drev_scaled,a.ppe_scaled)=0;
