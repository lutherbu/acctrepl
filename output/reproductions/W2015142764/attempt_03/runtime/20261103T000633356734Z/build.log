886        /* Compose the current firm-year variables and their required lags/leads. */
887        proc sql;
888          create table model_raw as
889          select a.gvkey, a.fyear, a.datadate,
890                 v.var_ffadj, v.nmonths, d.dd_value, q.abacc2,
891                 fr.frev2a, fr.nanal, inst.inst,
892                 r.ret as ret_now, r0.ret as ret_lag,
893                 c1.cfo_scaled as cfo_lag,
894                 c2.cfo_scaled as cfo_lead,
895                 vc.vcfo as vcfo_lag,
896                 c1.at_usd as at_lag, c1.lt_usd as lt_lag,
897                 m1.mve as mve_lag, c1.lev as lev_lag,
898                 c1.fyear as source_lag_year,
899                 case when m1.mve > 0 then log(m1.mve) else . end as size_lag,
900                 case when not missing(c1.at_usd) and c1.at_usd ne 0
901                           and not missing(c1.lt_usd) and not missing(m1.mve)
902                      then (c1.at_usd-c1.lt_usd)/m1.mve else . end as bm_lag
903          from comp_core as a
