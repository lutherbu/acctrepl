230        data comp_core0;
231          set comp_pair;
232          if nmiss(act_usd,act_usd_lag,lct_usd,lct_usd_lag,che_usd,che_usd_lag,
233                    dlc_usd,dlc_usd_lag)=0 then
234            tca=(act_usd-act_usd_lag)-(lct_usd-lct_usd_lag)
235                -(che_usd-che_usd_lag)+(dlc_usd-dlc_usd_lag);
236          else tca=.;
237          if nmiss(at_usd,at_usd_lag)=0 then avgasset=(at_usd+at_usd_lag)/2;
238          else avgasset=.;
239          if nmiss(ib_usd,tca,dp_usd)=0 then cfo=ib_usd-tca+dp_usd;
240          else cfo=.;
241          if nmiss(tca,dp_usd)=0 then ta=tca-dp_usd;
242          else ta=.;
243          if nmiss(sale_usd,sale_usd_lag)=0 then drev=sale_usd-sale_usd_lag;
244          else drev=.;
245          if nmiss(rect_usd,rect_usd_lag)=0 then dar=rect_usd-rect_usd_lag;
246          else dar=.;
247          if avgasset ne 0 and not missing(avgasset) then do;
248            tca_scaled=tca/avgasset;
249            ta_scaled=ta/avgasset;
250            invasset=1/avgasset;
251            cfo_scaled=cfo/avgasset;
252            if at_usd ne 0 and not missing(at_usd) then cfo_at=cfo/at_usd;
253            else cfo_at=.;
254            drev_scaled=drev/avgasset;
255            dar_scaled=dar/avgasset;
256            ppe_scaled=ppegt_usd/avgasset;
257            roa=ib_usd/avgasset;
258          end;
259          else call missing(tca_scaled,ta_scaled,invasset,cfo_scaled,cfo_at,
260                            drev_scaled,dar_scaled,ppe_scaled,roa);
261          if at_usd ne 0 and not missing(at_usd) then lev=(dltt_usd+dlc_usd)/at_usd;
262          else lev=.;
