485        /* Effective-dated Compustat/CRSP links. Prefer primary LC links, then
486           deterministic PERMNO order where the source does not report a tie-break. */
487        proc sql;
488          create table link_candidates as
489          select a.*, b.lpermno as permno, b.linkprim, b.linktype,
490                 (b.linkprim='P') as prim_rank,
