635        data ret_annual;
636          set ret_daily;
637          by gvkey fyear;
638          retain retprod nret;
639          if first.fyear then do; retprod=1; nret=0; end;
640          retprod=retprod*(1+ret);
641          nret+1;
642          if last.fyear then do;
643            ret=retprod-1;
644            output;
645          end;
646          keep gvkey fyear ret nret;
647          label ret="Annual buy-and-hold return";
648        run;

