976        data model_winsor;
977          if _n_=1 then set main_cuts;
978          set model_base;
979          array x[8] dd_lag abacc2_lag cfo_tp1 cfo_tm1 vcfo_lag bm size lev;
980          array lo[8] DD_LO AB_LO CFO1_LO CFO0_LO VCFO_LO BM_LO SIZE_LO LEV_LO;
981          array hi[8] DD_HI AB_HI CFO1_HI CFO0_HI VCFO_HI BM_HI SIZE_HI LEV_HI;
982          do j=1 to dim(x);
983            if not missing(x[j]) then do;
984              if x[j] < lo[j] then x[j]=lo[j];
985              if x[j] > hi[j] then x[j]=hi[j];
986            end;
987          end;
988          t_dd=time*dd_lag;
989          t_abacc2=time*abacc2_lag;
990          t_cfo_tp1=time*cfo_tp1;
991          t_cfo_tm1=time*cfo_tm1;
992          t_vcfo=time*vcfo_lag;
993          drop j DD_LO DD_HI AB_LO AB_HI CFO1_LO CFO1_HI CFO0_LO CFO0_HI
994                 VCFO_LO VCFO_HI BM_LO BM_HI SIZE_LO SIZE_HI LEV_LO LEV_HI;
995        run;

