{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standardized commercial databases",
  "description": "Edit enum to change the allowed database list. Optional x-aliases support matching names in paper text; they do not add allowed output values.",
  "type": "string",
  "enum": [
    "Audit Analytics",
    "BoardEx",
    "Compustat",
    "Execucomp",
    "CRSP",
    "IBES",
    "KLD",
    "SDC Platinum",
    "Worldscope",
    "Datastream"
  ],
  "x-aliases": {
    "Audit Analytics": ["AuditAnalytics", "AA Audit Analytics"],
    "BoardEx": ["Boardex", "BoardEx Europe", "BoardEx North America"],
    "Compustat": [
      "COMPUSTAT", "Compustat North America", "Compustat Global",
      "Compustat Industrial", "Compustat Bank", "Compustat Segment",
      "Compustat Research Insight"
    ],
    "Execucomp": ["ExecuComp", "S&P ExecuComp", "Compustat Executive Compensation"],
    "CRSP": ["Center for Research in Security Prices", "CRSP/Compustat Merged"],
    "IBES": ["I/B/E/S", "I.B.E.S.", "I/B/E/S International", "Institutional Brokers Estimate System", "I/BIE/S", "IIBIEIS"],
    "KLD": ["MSCI KLD", "KLD Research & Analytics", "KLD STATS", "MSCI ESG STATS"],
    "SDC Platinum": [
      "SDC", "Securities Data Company", "Securities Data Corporation",
      "SDC New Issues", "SDC Mergers and Acquisitions"
    ],
    "Worldscope": ["WorldScope", "Thomson Reuters Worldscope", "Refinitiv Worldscope"],
    "Datastream": ["DataStream", "Thomson Datastream", "Thomson Reuters Datastream", "Refinitiv Datastream"]
  }
}
