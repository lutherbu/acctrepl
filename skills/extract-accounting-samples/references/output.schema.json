{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accounting paper sample extraction",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "paper_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "doi": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "status": {
      "enum": [
        "complete",
        "needs_review",
        "no_empirical_sample",
        "text_unavailable"
      ]
    },
    "paper_text_file": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "primary_sample_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sample_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "sample_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "sample_role": {
            "enum": [
              "main",
              "additional",
              "validation",
              "experiment",
              "survey",
              "field-study"
            ]
          },
          "sample_size": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "sample_unit": {
            "enum": [
              "firm-year",
              "firm-quarter",
              "firm-month",
              "firm-day",
              "firm",
              "firm-country-year",
              "firm-product-year",
              "firm-event",
              "firm-pair-year",
              "bank-year",
              "bank-quarter",
              "bank",
              "country-year",
              "country",
              "industry-year",
              "executive-year",
              "executive",
              "director-year",
              "auditor-office-year",
              "audit-partner-year",
              "audit-engagement",
              "analyst-firm-year",
              "analyst-firm-quarter",
              "analyst-forecast",
              "analyst-recommendation",
              "analyst",
              "fund-month",
              "fund-quarter",
              "fund-year",
              "fund",
              "loan-facility",
              "loan-package",
              "loan",
              "bond-issue",
              "bond-year",
              "bond-day",
              "ipo",
              "seo",
              "merger-deal",
              "transaction",
              "restatement",
              "filing",
              "disclosure-event",
              "conference-call",
              "lawsuit",
              "patent",
              "contract",
              "news-article",
              "document",
              "participant",
              "participant-decision",
              "team",
              "interview",
              "survey-respondent",
              "study",
              "study-analysis",
              "effect-size",
              "other",
              null
            ]
          },
          "sample_unit_detail": {
            "type": "string",
            "maxLength": 500
          },
          "sample_period": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "begin": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1500,
                "maximum": 2100
              },
              "end": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1500,
                "maximum": 2100
              },
              "years": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1500,
                  "maximum": 2100
                },
                "maxItems": 601,
                "uniqueItems": true
              }
            },
            "required": [
              "begin",
              "end",
              "years"
            ]
          },
          "period_detail": {
            "type": "string",
            "maxLength": 600
          },
          "analysis_sizes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "sample_size": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "label",
                "sample_size"
              ]
            },
            "maxItems": 50
          },
          "data_sources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "commercial_standardized": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "databases.json"
                }
              },
              "commercial_nonstandardized": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "maxItems": 25,
                "uniqueItems": true
              },
              "public": {
                "type": "object",
                "maxProperties": 40,
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000,
                      "pattern": "^(?:https?|ftp)://\\S+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "proprietary": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "maxItems": 20
              },
              "primary_collection": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                "maxItems": 20
              },
              "unresolved": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "maxItems": 20
              }
            },
            "required": [
              "commercial_standardized",
              "commercial_nonstandardized",
              "public",
              "proprietary",
              "primary_collection",
              "unresolved"
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sample_size": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1200
                    }
                  },
                  "required": [
                    "page",
                    "quote"
                  ]
                },
                "maxItems": 20
              },
              "sample_unit": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1200
                    }
                  },
                  "required": [
                    "page",
                    "quote"
                  ]
                },
                "maxItems": 20
              },
              "sample_period": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1200
                    }
                  },
                  "required": [
                    "page",
                    "quote"
                  ]
                },
                "maxItems": 20
              },
              "data_sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1200
                    }
                  },
                  "required": [
                    "page",
                    "quote"
                  ]
                },
                "maxItems": 20
              }
            },
            "required": [
              "sample_size",
              "sample_unit",
              "sample_period",
              "data_sources"
            ]
          },
          "missing_fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "propertyNames": {
              "enum": [
                "sample_size",
                "sample_unit",
                "sample_period",
                "data_sources"
              ]
            }
          },
          "review_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "maxItems": 30
          }
        },
        "required": [
          "sample_id",
          "sample_label",
          "sample_role",
          "sample_size",
          "sample_unit",
          "sample_unit_detail",
          "sample_period",
          "period_detail",
          "analysis_sizes",
          "data_sources",
          "evidence",
          "missing_fields",
          "review_notes"
        ]
      },
      "maxItems": 50
    },
    "data_section_full_text": {
      "type": "string"
    },
    "data_section_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "page_begin": {
            "type": "integer",
            "minimum": 1
          },
          "page_end": {
            "type": "integer",
            "minimum": 1
          },
          "start_anchor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "end_anchor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "heading",
          "page_begin",
          "page_end",
          "start_anchor",
          "end_anchor"
        ]
      },
      "maxItems": 50
    },
    "data_section_status": {
      "enum": [
        "complete",
        "partial",
        "not_separately_headed",
        "not_found",
        "text_unavailable"
      ]
    },
    "review_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 50
    }
  },
  "required": [
    "schema_version",
    "paper_id",
    "doi",
    "status",
    "paper_text_file",
    "primary_sample_id",
    "samples",
    "data_section_full_text",
    "data_section_spans",
    "data_section_status",
    "review_notes"
  ]
}
