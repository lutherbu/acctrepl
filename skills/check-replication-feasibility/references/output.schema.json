{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/accounting/feasibility-1.2.schema.json",
  "title": "Independent reconstruction feasibility assessment",
  "description": "Data access status is separate from specification/construction issues; input extractions remain unchanged.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "paper_id": {
      "type": "string",
      "maxLength": 100
    },
    "doi": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "eligibility": {
      "enum": [
        "eligible",
        "no_baseline"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 6
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      },
      "minItems": 0
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assessment"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0
    },
    "author_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "description",
          "url",
          "evidence_ids"
        ]
      },
      "minItems": 0
    },
    "review_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000
      },
      "minItems": 0
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "all_local_ready",
            "public_acquisition_required",
            "partially_feasible",
            "access_blocked",
            "undetermined",
            "not_applicable",
            "no_observed_data_required"
          ]
        },
        "assessment_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "local_ready": {
              "type": "integer",
              "minimum": 0
            },
            "public_acquisition_required": {
              "type": "integer",
              "minimum": 0
            },
            "access_blocked": {
              "type": "integer",
              "minimum": 0
            },
            "undetermined": {
              "type": "integer",
              "minimum": 0
            },
            "no_observed_data_required": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "local_ready",
            "public_acquisition_required",
            "access_blocked",
            "undetermined",
            "no_observed_data_required"
          ]
        },
        "baseline_models": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_fits": {
          "type": "integer",
          "minimum": 0
        },
        "any_data_feasible": {
          "type": "boolean"
        },
        "all_data_feasible": {
          "type": "boolean"
        },
        "partially_data_feasible": {
          "type": "boolean"
        },
        "attempt_ready_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "outcome",
        "assessment_counts",
        "baseline_models",
        "baseline_fits",
        "any_data_feasible",
        "all_data_feasible",
        "partially_data_feasible",
        "attempt_ready_count"
      ]
    }
  },
  "required": [
    "schema_version",
    "paper_id",
    "doi",
    "eligibility",
    "provenance",
    "requirements",
    "assessments",
    "evidence",
    "author_alternatives",
    "review_notes",
    "summary"
  ],
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "type": "string",
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "raw_measure",
            "sampling",
            "identifier_link",
            "design",
            "benchmark",
            "supporting_input"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 8000
        },
        "required_coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "begin": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "years": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 0
            },
            "frequency": {
              "type": "string",
              "maxLength": 100
            },
            "population": {
              "type": "string",
              "maxLength": 4000
            },
            "detail": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "begin",
            "end",
            "years",
            "frequency",
            "population",
            "detail"
          ]
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "route_id": {
                "type": "string",
                "maxLength": 200
              },
              "route_type": {
                "enum": [
                  "local_sas",
                  "local_postgres",
                  "local_files",
                  "public_raw"
                ]
              },
              "source_name": {
                "type": "string",
                "maxLength": 300
              },
              "dataset": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "location": {
                "type": "string",
                "maxLength": 2000
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 200
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "mapping_notes": {
                "type": "string",
                "maxLength": 8000
              },
              "verification": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "access": {
                    "enum": [
                      "verified",
                      "unverified",
                      "unavailable"
                    ]
                  },
                  "fields": {
                    "enum": [
                      "verified",
                      "unverified",
                      "not_applicable"
                    ]
                  },
                  "coverage": {
                    "enum": [
                      "verified",
                      "partial",
                      "unverified",
                      "unavailable"
                    ]
                  },
                  "identifiers": {
                    "enum": [
                      "verified",
                      "unverified",
                      "not_applicable"
                    ]
                  },
                  "mapping": {
                    "enum": [
                      "verified",
                      "unverified"
                    ]
                  }
                },
                "required": [
                  "access",
                  "fields",
                  "coverage",
                  "identifiers",
                  "mapping"
                ]
              },
              "coverage_notes": {
                "type": "string",
                "maxLength": 4000
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 200
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "route_id",
              "route_type",
              "source_name",
              "dataset",
              "location",
              "fields",
              "mapping_notes",
              "verification",
              "coverage_notes",
              "evidence_ids"
            ]
          },
          "minItems": 0
        },
        "blocked_reason": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "blocked_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "unresolved_reason": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "data_status": {
          "enum": [
            "local_ready",
            "public_acquisition_required",
            "access_blocked",
            "undetermined"
          ]
        }
      },
      "required": [
        "requirement_id",
        "kind",
        "description",
        "required_coverage",
        "routes",
        "blocked_reason",
        "blocked_evidence_ids",
        "unresolved_reason",
        "evidence_ids",
        "data_status"
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "type": "string",
          "maxLength": 200
        },
        "result_set_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "required_model_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "variable_coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model_id": {
                "type": "string",
                "maxLength": 200
              },
              "variable_id": {
                "type": "string",
                "maxLength": 200
              },
              "requirement_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 200
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "construction": {
                "type": "string",
                "maxLength": 8000
              },
              "non_data_reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 4000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "model_id",
              "variable_id",
              "requirement_ids",
              "construction",
              "non_data_reason"
            ]
          },
          "minItems": 0
        },
        "design_coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "aspect": {
                "enum": [
                  "sampling",
                  "identifiers",
                  "fixed_effects",
                  "clusters",
                  "weights",
                  "estimation",
                  "preprocessing"
                ]
              },
              "requirement_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 200
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 4000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 200
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "aspect",
              "requirement_ids",
              "reason",
              "evidence_ids"
            ]
          },
          "minItems": 0
        },
        "implementation_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "specification",
                  "construction",
                  "manual_coding",
                  "linkage",
                  "vintage"
                ]
              },
              "description": {
                "type": "string",
                "maxLength": 4000
              },
              "blocking": {
                "type": "boolean"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 200
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "kind",
              "description",
              "blocking",
              "evidence_ids"
            ]
          },
          "minItems": 0
        },
        "data_status": {
          "enum": [
            "local_ready",
            "public_acquisition_required",
            "access_blocked",
            "undetermined",
            "no_observed_data_required"
          ]
        },
        "attempt_ready": {
          "type": "boolean"
        },
        "review_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4000
          },
          "minItems": 0
        },
        "data_mode": {
          "enum": [
            "observed",
            "synthetic_only"
          ]
        },
        "data_mode_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "data_mode_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "uniqueItems": true
        }
      },
      "required": [
        "model_id",
        "result_set_id",
        "required_model_ids",
        "requirement_ids",
        "variable_coverage",
        "design_coverage",
        "implementation_issues",
        "data_status",
        "attempt_ready",
        "review_notes",
        "data_mode",
        "data_mode_reason",
        "data_mode_evidence_ids"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "type": "string",
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "paper",
            "catalog",
            "probe",
            "public",
            "coverage_confirmation",
            "access_confirmation"
          ]
        },
        "locator": {
          "type": "string",
          "maxLength": 2000
        },
        "page": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "quote": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 3000
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "locator",
        "page",
        "quote",
        "description",
        "sha256",
        "verified_at"
      ]
    }
  }
}
